     3  /// ADR 0012 section 4, MOB-EXT-01 (spike): with `-AhoiWebExtensionSpike`
     4  /// the bundled MV3 test extension (`Sources/AhoiMobileCore/
     5  /// WebExtensionSpike`) injects its content script into a normal page and
     6  /// its `declarativeNetRequest` rule blocks a matching script request.
     7  ///
     8  /// On pages whose query contains `ahoi-spike-check` the content script
     9  /// probes two scripts on the page's own origin that differ only in the
    10  /// blocked path, and writes a visible report into the page. Without the
    11  /// launch argument the runtime is off and no report appears.
    12  final class MobileWebExtensionSpikeUITests: MobileBrowserUITestCase {
    13      private let spikeArgument = "-AhoiWebExtensionSpike"
    14
    15      @MainActor
    16      func testBundledExtensionInjectsContentScriptAndBlocksByRule() throws {
    17          let token = UUID().uuidString.lowercased().prefix(8)
    18          ensureVoiceOverOff()
    19          let app = launchExactCandidate(arguments: [
    20              "-AhoiUITestFixture", spikeArgument,
    21          ])
    22          defer { app.terminate() }
    23
    24          let first = try checkURL("\(token)-1")
    25          openExamplePage(first, in: app)
    26          let report = spikeReport(in: app)
    27          XCTAssertTrue(
    28              report.waitForExistence(timeout: Self.adr0012NetworkTimeout),
    29              "The extension's content script must write its report."
    30          )
    31          if !report.exists { attachTree(app, "spike-report-missing") }
    32          let label = report.label
    33          XCTAssertTrue(label.contains("content-script=ran"), label)
    34          XCTAssertTrue(
    35              label.contains("control=loaded"),
    36              "The unblocked control script must load: \(label)"
    37          )
    38          XCTAssertTrue(
    39              label.contains("rule=blocked"),
    40              "The declarativeNetRequest rule must block its script: \(label)"
    41          )
    42          attachEvidence(app, "spike-01-content-script-and-rule")
    43
    44          // Extension storage keeps its count within the session.
    45          let second = try checkURL("\(token)-2")
    46          openExamplePage(second, in: app)
    47          let again = spikeReport(in: app, containing: "visits=")
    48          XCTAssertTrue(again.waitForExistence(
    49              timeout: Self.adr0012NetworkTimeout
    50          ))
    51          let visits = visitCount(in: again.label)
    52          XCTAssertNotNil(visits, again.label)
    53          XCTAssertGreaterThanOrEqual(
    54              visits ?? 0, 2,
    55              "storage.local must count across page loads: \(again.label)"
    56          )
    57          attachEvidence(app, "spike-01-storage-second-visit")
    58      }
    59
