document.documentElement.dataset.ahoiSpike = "1";
const visitsStored = browser.storage.local.get("visits").then((stored) => {
  const visits = (stored.visits || 0) + 1;
  document.documentElement.dataset.ahoiSpikeVisits = String(visits);
