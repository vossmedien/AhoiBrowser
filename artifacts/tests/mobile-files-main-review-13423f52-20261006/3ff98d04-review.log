   180      @MainActor
   181      private func openSpikeSettings(in app: XCUIApplication) {
   182          app.buttons["browser.more"].tap()
   183          XCTAssertTrue(app.buttons["browser.actions.done"].waitForExistence(timeout: 4))
   184          let settings = app.buttons["browser.actions.settings"]
   185          reveal(settings, in: app)
   186          settings.tap()
   187          XCTAssertTrue(app.buttons["settings.done"].waitForExistence(timeout: 5))
   188          let load = app.buttons["settings.extensions.spike.import-folder"]
   189          reveal(load, in: app)
   190      }
   191
   192      @MainActor
   193      private func reveal(_ element: XCUIElement, in app: XCUIApplication) {
   194          // Finite settings list, matching the existing native settings journeys.
   195          for _ in 0..<10 {
   196              if element.exists && element.isHittable { break }
   197              app.swipeUp()
   198          }
   199          XCTAssertTrue(waitForHittable(element, timeout: 3))
   200      }
   201
   202      private func requireFilesJourneyOptIn() throws {
   203          guard ProcessInfo.processInfo.environment["AHOI_MOBILE_REAL_E2E"] == "1" else {
   204              throw XCTSkip("Files journeys need the exact-candidate E2E binding and owned device.")
   205          }
   206      }
   207
   208      private func checkURL(_ value: String) throws -> URL {
   209          try XCTUnwrap(URL(
   210              string: "https://example.com/?ahoi-spike-check=\(value)"
   211          ))
   212      }
   213
   214      @MainActor
   215      private func spikeReport(
   216          in app: XCUIApplication,
   217          containing text: String = "Ahoi Spike report"
   218      ) -> XCUIElement {
   219          app.webViews.descendants(matching: .any).matching(NSPredicate(
   220              format: "label CONTAINS %@ AND label CONTAINS %@",
   221              "Ahoi Spike report", text
   222          )).firstMatch
   223      }
   224
   225      private func visitCount(in label: String) -> Int? {
   226          guard let range = label.range(of: "visits=") else { return nil }
   227          return Int(label[range.upperBound...].prefix { $0.isNumber })
   228      }
   229  }

