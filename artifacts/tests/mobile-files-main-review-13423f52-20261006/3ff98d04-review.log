     1  import XCTest
     2
     3  /// Shared steps for the ADR 0012 journeys (recent-tab flick, Workspace
     4  /// merge, Web Extension spike). They run against the DEBUG candidate with
     5  /// the deterministic `-AhoiUITestFixture` population and public
     6  /// `https://example.com/?…` pages, not the local HTTPS fixture server.
     7  extension MobileBrowserUITestCase {
     8      static let adr0012StateTimeout: TimeInterval = 10
     9      static let adr0012NetworkTimeout: TimeInterval = 20
    10
    11      /// A VoiceOver journey that failed half-way must not leave VoiceOver
    12      /// on: every tap would then only move its cursor.
    13      @MainActor
    14      func ensureVoiceOverOff() {
    15          guard #available(iOS 27.0, *) else { return }
    16          let voiceOver = XCUIDevice.shared.voiceOverService
    17          for _ in 0..<3 where voiceOver.isEnabled {
    18              try? voiceOver.disable()
    19              RunLoop.current.run(until: Date().addingTimeInterval(1))
    20          }
    21          XCTAssertFalse(voiceOver.isEnabled, "VoiceOver must be off.")
    22      }
    23
    24      @MainActor
    25      func addressControl(in app: XCUIApplication) -> XCUIElement {
    26          app.buttons["browser.address"]
    27      }
    28
    29      /// The address control's value is the selected tab's full URL.
    30      @MainActor
    31      func waitForAddressValue(
    32          containing text: String,
    33          in app: XCUIApplication,
    34          timeout: TimeInterval = adr0012StateTimeout
    35      ) -> Bool {
    36          let expectation = XCTNSPredicateExpectation(
    37              predicate: NSPredicate(format: "value CONTAINS %@", text),
    38              object: addressControl(in: app)
    39          )
    40          return XCTWaiter.wait(for: [expectation], timeout: timeout)
    41              == .completed
    42      }
    43
    44      @MainActor
    45      func currentAddress(in app: XCUIApplication) -> String {
    46          addressControl(in: app).value as? String ?? ""
    47      }
    48
    49      @MainActor
    50      func visibleTabCount(in app: XCUIApplication) -> Int? {
    51          let tabs = app.buttons["browser.tabs"]
    52          if let value = tabs.value as? String,
    53             let count = Int(value.trimmingCharacters(in: .whitespaces)) {
    54              return count
    55          }
    56          return Int(tabs.label.prefix { $0.isNumber })
    57      }
    58
    59      /// One-finger horizontal drag across the Harbor Deck's address
    60      /// control. XCUI calls the control unhittable (the web view's frame
    61      /// reaches under the deck), so the drag uses its visible frame.
    62      @MainActor
    63      func flickAddress(
    64          _ direction: Int,
    65          in app: XCUIApplication,
    66          distance: CGFloat = 170,
    67          hold: TimeInterval = 0
    68      ) {
    69          let address = addressControl(in: app)
    70          XCTAssertTrue(address.waitForExistence(timeout: 5))
    71          let frame = address.frame
    72          let origin = app.coordinate(
    73              withNormalizedOffset: CGVector(dx: 0, dy: 0)
    74          )
    75          let startX = direction > 0
    76              ? frame.minX + 24
    77              : frame.maxX - 24
    78          let endX = direction > 0
    79              ? min(frame.maxX, startX + distance)
    80              : max(frame.minX, startX - distance)
    81          let start = origin.withOffset(CGVector(dx: startX, dy: frame.midY))
    82          let end = origin.withOffset(CGVector(dx: endX, dy: frame.midY))
    83          start.press(
    84              forDuration: 0.05,
    85              thenDragTo: end,
    86              withVelocity: .default,
    87              thenHoldForDuration: hold
    88          )
    89      }
    90
    91      /// Opens `url` through the address editor and waits for the public
    92      /// example.com page. `isHittable` is a false signal for the address
    93      /// over a loaded page (79828c0); the editor field proves the tap.
    94      @MainActor
    95      func openExamplePage(_ url: URL, in app: XCUIApplication) {
    96          let address = addressControl(in: app)
    97          XCTAssertTrue(
    98              address.waitForExistence(timeout: Self.adr0012StateTimeout)
    99          )
   100          address.tap()
   101          let field = app.textFields["browser.address.field"]
   102          XCTAssertTrue(waitForHittable(field, timeout: Self.adr0012StateTimeout))
   103          clearAddressEditor(field, in: app)
   104          enterExactAddress(url.absoluteString, into: field, in: app)
   105          let go = app.buttons["browser.search.navigate"]
   106          XCTAssertTrue(waitForHittable(go, timeout: Self.adr0012StateTimeout))
   107          go.tap()
   108          XCTAssertTrue(
   109              field.waitForNonExistence(timeout: Self.adr0012StateTimeout)
   110          )
   111          assertAddress(url, containsOrigin: "example.com", in: app)
   112          XCTAssertTrue(
   113              exampleDomainPage(in: app).waitForExistence(
   114                  timeout: Self.adr0012NetworkTimeout
   115              ),
   116              "The public example.com page must load."
   117          )
   118      }
   119
   120      @MainActor
   121      func showTabSwitcher(_ app: XCUIApplication) {
   122          let tabs = app.buttons["browser.tabs"]
   123          XCTAssertTrue(waitForHittable(tabs, timeout: 5))
   124          tabs.tap()
   125          XCTAssertTrue(
   126              app.descendants(matching: .any)["browser.tabs.list"]
   127                  .waitForExistence(timeout: Self.adr0012StateTimeout)
   128          )
   129      }
   130
   131      @MainActor
   132      func switcherRow(
   133          containing text: String,
   134          in app: XCUIApplication
   135      ) -> XCUIElement {
   136          app.buttons.matching(NSPredicate(
   137              format: "identifier BEGINSWITH %@ AND label CONTAINS[c] %@",
   138              "browser.tab-row.",
   139              text
   140          )).firstMatch
   141      }
   142
   143      /// Selects a tab through the switcher, which refreshes its
   144      /// most-recent-use time exactly like a person picking it.
   145      @MainActor
   146      func selectTabInSwitcher(
   147          rowContaining text: String,
   148          expectAddress address: String,
   149          in app: XCUIApplication
   150      ) {
   151          showTabSwitcher(app)
   152          let row = switcherRow(containing: text, in: app)
   153          XCTAssertTrue(
   154              waitForHittable(row, timeout: Self.adr0012StateTimeout),
   155              "The switcher must list a tab containing '\(text)'."
   156          )
   157          row.tap()
   158          XCTAssertTrue(
   159              app.descendants(matching: .any)["browser.tabs.list"]
   160                  .waitForNonExistence(timeout: Self.adr0012StateTimeout)
   161          )
   162          XCTAssertTrue(
   163              waitForAddressValue(containing: address, in: app),
   164              "Selecting '\(text)' must show \(address); "
   165                  + "got \(currentAddress(in: app))."
   166          )
   167      }
   168
   169      @MainActor
   170      func attachEvidence(_ app: XCUIApplication, _ name: String) {
   171          let attachment = XCTAttachment(screenshot: app.screenshot())
   172          attachment.name = name
   173          attachment.lifetime = .keepAlways
   174          add(attachment)
   175      }
   176
   177      @MainActor
   178      func attachTree(_ app: XCUIApplication, _ name: String) {
   179          let attachment = XCTAttachment(string: app.debugDescription)
   180          attachment.name = name
   181          attachment.lifetime = .keepAlways
   182          add(attachment)
   183      }
   184  }
