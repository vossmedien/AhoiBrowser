   132                      format: "label IN %@", ["Browse", "Durchsuchen"]
   133                  )).firstMatch
   134                  XCTAssertTrue(waitForHittable(browse, timeout: 5))
   135                  browse.tap()
   136              }
   137              XCTAssertTrue(waitForHittable(local, timeout: 5))
