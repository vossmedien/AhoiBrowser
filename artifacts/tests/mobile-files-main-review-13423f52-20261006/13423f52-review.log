   181      @MainActor
   182      private func openSpikeSettings(in app: XCUIApplication) {
   183          app.buttons["browser.more"].tap()
   184          XCTAssertTrue(app.buttons["browser.actions.done"].waitForExistence(timeout: 4))
   185          let settings = app.buttons["browser.actions.settings"]
   186          reveal(settings, in: app)
   187          settings.tap()
   188          XCTAssertTrue(app.buttons["settings.done"].waitForExistence(timeout: 5))
   189          let load = app.buttons["settings.extensions.spike.import-folder"]
   190          reveal(load, in: app)
   191      }
   192
   193      @MainActor
   194      private func reveal(_ element: XCUIElement, in app: XCUIApplication) {
   195          // Finite settings list, matching the existing native settings journeys.
   196          for _ in 0..<10 {
   197              if element.exists && element.isHittable { break }
   198              app.swipeUp()
   199          }
   200          XCTAssertTrue(waitForHittable(element, timeout: 3))
   201      }
   202
   203      private func requireFilesJourneyOptIn() throws {
   204          guard ProcessInfo.processInfo.environment["AHOI_MOBILE_REAL_E2E"] == "1" else {
   205              throw XCTSkip("Files journeys need the exact-candidate E2E binding and owned device.")
   206          }
   207      }
   208
   209      private func checkURL(_ value: String) throws -> URL {
   210          try XCTUnwrap(URL(
   211              string: "https://example.com/?ahoi-spike-check=\(value)"
   212          ))
   213      }
   214
   215      @MainActor
   216      private func spikeReport(
   217          in app: XCUIApplication,
   218          containing text: String = "Ahoi Spike report"
   219      ) -> XCUIElement {
   220          app.webViews.descendants(matching: .any).matching(NSPredicate(
   221              format: "label CONTAINS %@ AND label CONTAINS %@",
   222              "Ahoi Spike report", text
   223          )).firstMatch
   224      }
   225
   226      private func visitCount(in label: String) -> Int? {
   227          guard let range = label.range(of: "visits=") else { return nil }
   228          return Int(label[range.upperBound...].prefix { $0.isNumber })
   229      }
   230  }

