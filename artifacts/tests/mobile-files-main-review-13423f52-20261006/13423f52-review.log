   153          let enteredFolder = folderRoot.waitForExistence(timeout: 5)
   154          attachTree(app, "spike-files-selected-folder-tree")
   155          XCTAssertTrue(enteredFolder, "Files must enter the reviewed fixture folder before Open.")
   156          let open = app.buttons["DOCPicker.actionButton"]
   157          XCTAssertTrue(waitForHittable(open, timeout: 5))
   158          attachEvidence(app, "spike-files-selected-folder")
   159          open.tap()
   160
   161          let loaded = app.staticTexts.matching(NSPredicate(
   162              format: "identifier == %@ AND label == %@",
   163              "settings.extensions.spike.files-status", "Unpacked test extension loaded"
   164          )).firstMatch
   165          XCTAssertTrue(loaded.waitForExistence(timeout: 8))
   166          XCTAssertFalse(load.isEnabled)
   167          let unload = app.buttons["settings.extensions.spike.unload-folder"]
   168          XCTAssertTrue(waitForHittable(unload, timeout: 5))
   169          attachEvidence(app, "spike-files-context-loaded")
   170          unload.tap()
   171          let unloaded = app.staticTexts.matching(NSPredicate(
   172              format: "identifier == %@ AND label == %@",
   173              "settings.extensions.spike.files-status", "Files test extension unloaded"
   174          )).firstMatch
   175          XCTAssertTrue(unloaded.waitForExistence(timeout: 5))
