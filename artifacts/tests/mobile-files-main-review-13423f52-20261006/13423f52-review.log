   123          attachTree(app, "spike-files-picker-before-selection-tree")
   124
   125          let chosenFolder = app.cells["\(folder), Folder"].firstMatch
   126          if !chosenFolder.waitForExistence(timeout: 3) {
   127              let local = app.descendants(matching: .any).matching(NSPredicate(
   128                  format: "label IN %@", ["On My iPhone", "Auf meinem iPhone"]
   129              )).firstMatch
   130              if !local.exists {
