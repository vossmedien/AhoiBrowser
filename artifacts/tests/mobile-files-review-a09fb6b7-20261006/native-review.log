            "-AhoiPerformanceWorkload",
            "-AhoiPerformanceEvidenceScenario",
            "-AhoiPerformanceEvidenceNonce",
            "-AhoiPerformanceEvidenceMarker",
            "-AhoiPerformanceReduceMotionOverride",
        ]
