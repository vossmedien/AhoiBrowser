<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Fill only after the Apple Team has assigned a non-production development
	     container. The repository intentionally carries no real entitlement. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>$(AHOI_CLOUDKIT_CONTAINER_ID)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Required only after the Apple Team provisions a shared synchronizable
	     Keychain group for the externally managed E2E sync key. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AHOI_SYNC_KEYCHAIN_ACCESS_GROUP)</string>
		<string>$(AHOI_COMMAND_KEYCHAIN_ACCESS_GROUP)</string>
	</array>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
