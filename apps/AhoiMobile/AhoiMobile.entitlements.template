<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Pre-grant CloudKit entitlement shared by CloudKitDevelopment and
	     TestFlightBootstrap. Both environments use the same dedicated Ahoi
	     container; the build mode selects Development or Production. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>$(AHOI_CLOUDKIT_CONTAINER_ID)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>$(AHOI_CLOUDKIT_CONTAINER_ENVIRONMENT)</string>
	<!-- The payload group is synchronizable; the command group stores a distinct
	     per-device, non-synchronizable signing key. Profiles must authorize both. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AHOI_SYNC_KEYCHAIN_ACCESS_GROUP)</string>
		<string>$(AHOI_COMMAND_KEYCHAIN_ACCESS_GROUP)</string>
	</array>
	<key>aps-environment</key>
	<string>$(AHOI_APS_ENVIRONMENT)</string>
</dict>
</plist>
