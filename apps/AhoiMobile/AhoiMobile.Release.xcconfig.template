// Materialize this candidate-only overlay outside version control and pass it
// with `xcodebuild -xcconfig`. Public Team/bundle/container values live in the
// tracked mode configurations; no key bytes, certificates or profiles belong here.

AHOI_SOURCE_COMMIT = __AHOI_SOURCE_COMMIT_UNRESOLVED__
AHOI_MOBILE_MARKETING_VERSION = __AHOI_MARKETING_VERSION_UNRESOLVED__
AHOI_MOBILE_BUILD_NUMBER = __AHOI_BUILD_NUMBER_UNRESOLVED__
// Legal/export-compliance must classify the exact candidate as YES or NO.
AHOI_APP_USES_NON_EXEMPT_ENCRYPTION = __AHOI_EXPORT_COMPLIANCE_UNRESOLVED__

// Automatic/Cloud-Managed Signing is the primary path. A reviewed manual
// fallback must set all three values together and is rejected otherwise.
CODE_SIGN_STYLE = Automatic
AHOI_MANUAL_SIGNING_FALLBACK = NO
AHOI_PROVISIONING_PROFILE_SPECIFIER =
