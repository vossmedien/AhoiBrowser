#include "AhoiMobile.Public.xcconfig"

// Optimized, development-signed diagnostics on a physical device. This mode
// deliberately carries no CloudKit, Push, shared-Keychain or default-browser
// capability and must be bound to the exact source candidate by the caller.
AHOI_BUILD_MODE = PerformanceDevelopment
AHOI_SOURCE_COMMIT = __AHOI_SOURCE_COMMIT_UNRESOLVED__
AHOI_MOBILE_MARKETING_VERSION = __AHOI_MARKETING_VERSION_UNRESOLVED__
AHOI_MOBILE_BUILD_NUMBER = __AHOI_BUILD_NUMBER_UNRESOLVED__
AHOI_APP_USES_NON_EXEMPT_ENCRYPTION = NO
AHOI_APS_ENVIRONMENT =
AHOI_CLOUDKIT_CONTAINER_ENVIRONMENT =
AHOI_CLOUDKIT_CONTAINER_ID =
AHOI_SYNC_KEYCHAIN_ACCESS_GROUP =
AHOI_SYNC_KEYCHAIN_SERVICE =
AHOI_SYNC_KEYCHAIN_ACCOUNT =
AHOI_SYNC_KEY_VERSION =
AHOI_COMMAND_KEYCHAIN_ACCESS_GROUP =
AHOI_COMMAND_KEYCHAIN_SERVICE =
AHOI_COMMAND_KEYCHAIN_ACCOUNT =
CODE_SIGN_STYLE = Automatic
