{
  "manifest_version": 3,
  "name": "Ahoi Spike",
  "version": "1.0",
  "description": "MOB-EXT-01 spike: one content script, one blocking rule, storage and a popup.",
  "permissions": ["declarativeNetRequestWithHostAccess", "storage", "nativeMessaging"],
  "optional_host_permissions": ["https://example.com/*"],
  "background": { "scripts": ["popup.js"], "persistent": false },
  "content_scripts": [
    {
      "matches": ["https://example.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "spike", "enabled": false, "path": "rules.json" }
    ]
  },
  "action": {
    "default_title": "Ahoi Spike",
    "default_popup": "popup.html"
  }
}
