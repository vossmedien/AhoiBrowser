+  // last root. The source is tombstoned. Undo moves everything back, removes
+  // the folder and revives the source. An empty source is tombstoned without
+  // an undo entry, like DeleteWorkspace. Live Chromium tabs, bindings and the
+  // structure state stay the caller's job.
+  [[nodiscard]] Result MergeWorkspace(const base::Uuid& source_workspace_id,
+                                      const base::Uuid& target_workspace_id,
