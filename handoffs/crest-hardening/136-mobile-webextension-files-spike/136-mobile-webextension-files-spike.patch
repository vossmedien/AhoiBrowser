diff --git a/apps/AhoiMobile/Tests/AhoiMobileCoreTests/MobileWebExtensionRuntimeTests.swift b/apps/AhoiMobile/Tests/AhoiMobileCoreTests/MobileWebExtensionRuntimeTests.swift
--- a/apps/AhoiMobile/Tests/AhoiMobileCoreTests/MobileWebExtensionRuntimeTests.swift
+++ b/apps/AhoiMobile/Tests/AhoiMobileCoreTests/MobileWebExtensionRuntimeTests.swift
@@ -44,4 +44,63 @@
         XCTAssertEqual(runtime.state, .loaded(displayName: "Ahoi Spike"))
