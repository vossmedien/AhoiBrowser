+  // True while a window of the Profile in `profile_dir` was presented over a
+  // hidden window in this run; closing it shows exactly that window again.
+  static bool HasPresentedWindowOf(const std::string& profile_dir) {
+    for (const std::unique_ptr<HandOverWatch>& watch : Watches()) {
+      if (watch->presented_ &&
+          DirName(watch->presented_->GetProfile()->GetPath()) == profile_dir) {
+        return true;
+      }
+    }
+    return false;
+  }
