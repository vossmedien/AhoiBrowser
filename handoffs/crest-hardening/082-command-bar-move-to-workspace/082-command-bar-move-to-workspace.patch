+  execution_delegate_->move_enabled = true;
+  CommandItem malformed = item;
+  malformed.stable_id = "move-to-workspace.not-a-uuid";
+  EXPECT_FALSE(adapter_->CanExecuteItem(malformed));
+  EXPECT_FALSE(
