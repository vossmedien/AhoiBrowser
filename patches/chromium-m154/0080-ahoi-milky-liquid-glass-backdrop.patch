+ahoi::appearance::NativeBackdropSpec
+BrowserNativeWidgetMac::ResolveAhoiBackdrop(SkColor surface_color) const {
+  // Workspace accents are owned by the Sidebar; the backdrop stays neutral
+  // until a window-level accent signal exists.
+  return ahoi::appearance::ResolveNativeBackdrop(
+      ahoi::appearance::SurfaceHost::kWindowBackdrop,
+      appearance_signals_->policy(),
+      ahoi::appearance::IsNativeMacGlassAvailable(), surface_color);
