+// Chromium's default for URLs that Ahoi's link routing accepted but could not
+// open in a Workspace.
+void OpenAhoiRoutingFallback(std::vector<GURL> urls) {
+  StartupTabs tabs;
+  for (const GURL& url : urls) {
+    tabs.emplace_back(url, /*is_untrusted_launch=*/false);
+  }
+  app_controller_mac::RunInLastProfileSafely(
+      base::BindOnce(&OpenStartupTabsInBrowserWithProfile, std::move(tabs)),
+      app_controller_mac::kShowProfilePickerOnFailure);
