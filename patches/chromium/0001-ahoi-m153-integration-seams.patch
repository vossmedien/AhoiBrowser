+std::vector<ahoi::split_drop::SplitDropPane> GetAhoiSplitDropPanes(
+    MultiContentsView* multi_contents_view) {
+  std::vector<ahoi::split_drop::SplitDropPane> panes;
+  if (!multi_contents_view) {
+    return panes;
+  }
+
+  const auto& containers = multi_contents_view->contents_container_views();
+  panes.reserve(containers.size());
+  for (size_t index = 0; index < containers.size(); ++index) {
+    ContentsContainerView* const container = containers[index];
+    if (!container || !container->GetVisible() || !container->contents_view() ||
+        !container->contents_view()->web_contents()) {
+      continue;
+    }
+    panes.push_back(
+        {.pane_index = index,
+         .bounds = container->bounds(),
+         .web_contents = container->contents_view()->web_contents()});
+  }
+  return panes;
+}
