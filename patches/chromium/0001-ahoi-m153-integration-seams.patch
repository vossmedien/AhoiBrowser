+void LoginHandler::SetCredentialSaveDecision(CredentialSaveDecision decision) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (WasAuthHandled()) {
+    return;
+  }
+  credential_save_decision_ = decision;
+  if (decision == CredentialSaveDecision::kNeverSaveForRealm &&
+      ahoi_credential_state_ && ahoi_credential_state_->service &&
+      ahoi_credential_state_->request_context !=
+          ahoi::HttpAuthRequestContext::kIncognito) {
+    ahoi_credential_state_->service->SetNeverSaveForRealm(
+        ahoi_credential_state_->protection_space, true,
+        ahoi_credential_state_->request_context);
+  }
+}
+
+void LoginHandler::DeleteSavedCredential(std::u16string_view username,
