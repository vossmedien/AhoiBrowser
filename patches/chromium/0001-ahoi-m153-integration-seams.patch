+         (ahoi_sidebar_visual_floating_ || ahoi_sidebar_edge_revealed_ ||
+          ahoi::sidebar::IsFloating(ahoi_sidebar_presentation_mode_));
+}
+
+bool VerticalTabStripRegionView::IsAhoiSidebarHidden() const {
+  return ahoi_sidebar_tree_view_ && !ahoi_sidebar_edge_revealed_ &&
+         !ahoi::sidebar::IsVisible(ahoi_sidebar_presentation_mode_);
+}
