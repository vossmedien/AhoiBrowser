+    // non-collapsing sidebar range. Preserve an already customized width and
+    // replace only Chromium's untouched default with Ahoi's visual default.
+    target_collapse_state_.collapsed = false;
+    if (target_collapse_state_.uncollapsed_width ==
+        tabs::kVerticalTabStripDefaultUncollapsedWidth) {
+      target_collapse_state_.uncollapsed_width =
+          ahoi::visual_style::kSidebarWidthDefault;
+    }
+    target_collapse_state_.uncollapsed_width =
+        std::clamp(target_collapse_state_.uncollapsed_width,
+                   ahoi::visual_style::kSidebarWidthMinimum,
+                   ahoi::visual_style::kSidebarWidthMaximum);
+    resize_area_width_ = ahoi::visual_style::kSidebarResizeAreaWidth;
+    resize_area_->SetVisible(true);
+    resize_area_->GetViewAccessibility().SetMinValueForRange(
+        ahoi::visual_style::kSidebarWidthMinimum);
+    resize_area_->GetViewAccessibility().SetMaxValueForRange(
+        ahoi::visual_style::kSidebarWidthMaximum);
+    resize_area_->GetViewAccessibility().SetValueForRange(
+        target_collapse_state_.uncollapsed_width);
+    ahoi_sidebar_default_focus_view_tracker_.SetView(
+        default_focus_view ? default_focus_view : view.get());
+    ahoi_sidebar_tree_view_ = AddChildView(std::move(view));
+    // The production host, not just tests, must own a transparent compositor
+    // layer. Rounded clipping is otherwise a no-op and independently
+    // composited scrolling/drag descendants can flash through card corners.
+    ahoi_sidebar_tree_view_->SetPaintToLayer();
+    ahoi_sidebar_tree_view_->layer()->SetFillsBoundsOpaquely(false);
+    ahoi_sidebar_tree_view_->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToMinimum,
+                                 views::MaximumFlexSizeRule::kUnbounded));
+    ahoi_sidebar_tree_view_->SetProperty(
+        views::kMarginsKey,
+        gfx::Insets::TLBR(
+            std::max(
+                toolbar_height_for_layout_,
+                GetLayoutConstant(
+                    LayoutConstant::kVerticalTabStripCollapsedVerticalPadding)),
+            0,
+            GetLayoutConstant(
+                LayoutConstant::kVerticalTabStripCollapsedVerticalPadding),
+            0));
+    const std::optional<size_t> separator_index =
+        GetIndexOf(top_button_separator_);
+    CHECK(separator_index.has_value());
+    ReorderChildView(ahoi_sidebar_tree_view_, *separator_index + 1);
+    // The Ahoi surface is added after Chromium's resize strip and otherwise
+    // wins hit testing over the overlapping right edge. Keep the invisible
+    // native drag handle topmost so both mouse and accessibility resizing
+    // reach ResizeArea rather than the sidebar content.
+    ReorderChildView(resize_area_, children().size() - 1);
+    SetAhoiSidebarPresentationMode(ahoi_sidebar_presentation_mode_);
