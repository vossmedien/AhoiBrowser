+IN_PROC_BROWSER_TEST_F(StartupBrowserCreatorTest,
+                       AhoiEmptyStartupCreatesTrueZeroTabWindow) {
+  base::test::ScopedCommandLine scoped_process_command_line;
+  AllowAhoiStartupInBrowserTest(&scoped_process_command_line);
+  Profile* profile = browser()->GetProfile();
+  const GURL suppressed_url(chrome::kChromeUIVersionURL);
+  ASSERT_NO_FATAL_FAILURE(SaveCurrentBrowserAsLastSession(suppressed_url));
+  ASSERT_TRUE(ahoi::session::SetStartupMode(
+      profile->GetPrefs(), ahoi::session::StartupMode::kEmpty));
+  DisableWhatsNewPage();
+
+  base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  StartupBrowserCreatorImpl creator(base::FilePath(), command_line,
+                                    chrome::startup::IsFirstRun::kNo);
+  ui_test_utils::BrowserCreatedObserver browser_created_observer;
+  creator.Launch(profile, chrome::startup::IsProcessStartup::kYes,
+                 /*restore_tabbed_browser=*/true);
+  BrowserWindowInterface* empty_browser = browser_created_observer.Wait();
+
+  ASSERT_TRUE(empty_browser);
+  EXPECT_EQ(0, empty_browser->tab_strip_model()->count());
+  EXPECT_EQ(nullptr, empty_browser->tab_strip_model()->GetActiveWebContents());
+  EXPECT_FALSE(profile->restored_last_session());
+
+  chrome::NewTab(empty_browser, NewTabTypes::kNewTabCommand);
+  EXPECT_EQ(1, empty_browser->tab_strip_model()->count());
+  EXPECT_NE(nullptr, empty_browser->tab_strip_model()->GetActiveWebContents());
+}
