+IN_PROC_BROWSER_TEST_P(AhoiEmptyStateSplitRehydrateBrowserTest,
+                       AhoiEmptyStateRehydratesEverySplitPane) {
+  BrowserView* browser_view = BrowserView::GetBrowserViewForBrowser(browser());
+  if (!browser_view->IsAhoiBrowserSurface()) {
+    GTEST_SKIP() << "The Ahoi native sidebar is not enabled in this test run";
+  }
+
+  host_resolver()->AddRule("*", "127.0.0.1");
+  ASSERT_TRUE(embedded_test_server()->Start());
+
+  TabStripModel* tab_strip_model = browser()->tab_strip_model();
+  const size_t pane_count = GetParam();
+  ASSERT_GE(pane_count, 2u);
+  ASSERT_LE(pane_count, split_tabs::SplitTabVisualData::kMaxPanes);
+  std::vector<GURL> pane_urls;
+  pane_urls.reserve(pane_count);
+  for (size_t pane = 0; pane < pane_count; ++pane) {
+    pane_urls.push_back(embedded_test_server()->GetURL(
+        base::StringPrintf("pane-%zu.test", pane), "/title1.html"));
+  }
+
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), pane_urls[0]));
+  std::vector<int> additional_tab_indices;
+  for (size_t pane = 1; pane < pane_count; ++pane) {
+    ASSERT_TRUE(AddTabAtIndex(static_cast<int>(pane), pane_urls[pane],
+                              ui::PAGE_TRANSITION_TYPED));
+    additional_tab_indices.push_back(static_cast<int>(pane));
+  }
+  tab_strip_model->ActivateTabAt(
+      0, TabStripUserGestureDetails(
+             TabStripUserGestureDetails::GestureType::kOther));
+
+  split_tabs::SplitTabVisualData visual_data(
+      split_tabs::SplitTabLayout::kSideBySide);
+  if (pane_count == 3u) {
+    visual_data = split_tabs::SplitTabVisualData::ForThreePane(
+        split_tabs::SplitTabLayout::kSideBySide);
+  } else if (pane_count == 4u) {
+    visual_data = split_tabs::SplitTabVisualData::ForFourPane(
+        split_tabs::SplitTabLayout::kSideBySide);
+  }
+  const split_tabs::SplitTabId split_id = tab_strip_model->AddToNewSplit(
+      std::move(additional_tab_indices), visual_data,
+      split_tabs::SplitTabCreatedSource::kToolbarButton);
+  ASSERT_TRUE(tab_strip_model->ContainsSplit(split_id));
+  const int active_pane = static_cast<int>(pane_count / 2u);
+  tab_strip_model->ActivateTabAt(
+      active_pane, TabStripUserGestureDetails(
+                       TabStripUserGestureDetails::GestureType::kOther));
+  RunScheduledLayouts();
+
+  split_tabs::SplitTabData* split_data =
+      tab_strip_model->GetSplitData(split_id);
+  ASSERT_TRUE(split_data);
+  std::vector<content::WebContents*> expected_contents;
+  for (tabs::TabInterface* tab : split_data->ListTabs()) {
+    expected_contents.push_back(tab->GetContents());
+  }
+  ASSERT_EQ(expected_contents.size(), pane_count);
+  for (size_t pane = 0; pane < pane_count; ++pane) {
+    EXPECT_EQ(pane_urls[pane], expected_contents[pane]->GetVisibleURL());
+  }
+
+  MultiContentsView* view = browser_view->multi_contents_view();
+  ASSERT_EQ(view->GetVisiblePaneCount(), pane_count);
+  ASSERT_EQ(view->GetActiveIndex(), active_pane);
+  for (size_t pane = 0; pane < pane_count; ++pane) {
+    MultiContentsViewMiniToolbar* toolbar =
+        view->mini_toolbar_for_testing(pane);
+    EXPECT_EQ(base::ASCIIToUTF16(pane_urls[pane].host()),
+              toolbar->domain_label_for_testing()->GetText());
+    EXPECT_EQ(base::UTF8ToUTF16(pane_urls[pane].spec()),
+              toolbar->GetTooltipText());
+    EXPECT_EQ(static_cast<int>(pane) == active_pane,
+              toolbar->active_indicator_for_testing()->GetVisible());
+  }
+
+  OmniboxView* omnibox =
+      BrowserWindow::FromBrowser(browser())->GetLocationBar()->GetOmniboxView();
+  ASSERT_TRUE(omnibox);
+  EXPECT_THAT(base::UTF16ToUTF8(omnibox->GetText()),
+              ::testing::HasSubstr(pane_urls[active_pane].host()));
+
+  browser_view->SetAhoiEmptyStateVisible(true);
+  EXPECT_TRUE(view->IsAhoiEmptyStateVisibleForTesting());
+  for (size_t pane = 0; pane < expected_contents.size(); ++pane) {
+    EXPECT_EQ(nullptr, view->contents_container_views()[pane]
+                           ->contents_view()
+                           ->web_contents());
+    MultiContentsViewMiniToolbar* toolbar =
+        view->mini_toolbar_for_testing(pane);
+    EXPECT_TRUE(toolbar->domain_label_for_testing()->GetText().empty());
+    EXPECT_TRUE(toolbar->GetTooltipText().empty());
+    EXPECT_TRUE(toolbar->favicon_for_testing()->GetImageModel().IsEmpty());
+    EXPECT_FALSE(toolbar->active_indicator_for_testing()->GetVisible());
+    EXPECT_TRUE(toolbar->active_indicator_for_testing()
+                    ->GetViewAccessibility()
+                    .GetCachedName()
+                    .empty());
+  }
+
+  browser_view->SetAhoiEmptyStateVisible(false);
+  EXPECT_FALSE(view->IsAhoiEmptyStateVisibleForTesting());
+  EXPECT_TRUE(view->IsInSplitView());
+  EXPECT_EQ(view->GetVisiblePaneCount(), pane_count);
+  EXPECT_EQ(view->GetActiveIndex(), active_pane);
+  for (size_t pane = 0; pane < expected_contents.size(); ++pane) {
+    EXPECT_EQ(expected_contents[pane], view->contents_container_views()[pane]
+                                           ->contents_view()
+                                           ->web_contents());
+    MultiContentsViewMiniToolbar* toolbar =
