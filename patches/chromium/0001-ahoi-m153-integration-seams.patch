+
+std::u16string LoginHandler::GetAuthSchemeForDisplay() const {
+  if (base::EqualsCaseInsensitiveASCII(auth_info_.scheme,
+                                       net::kBasicAuthScheme)) {
+    return u"Basic";
+  }
+  if (base::EqualsCaseInsensitiveASCII(auth_info_.scheme,
+                                       net::kDigestAuthScheme)) {
+    return u"Digest";
+  }
+  return base::UTF8ToUTF16(auth_info_.scheme);
