+    session_helper.SaveNow();
+    session_service->MoveCurrentSessionToLastSession();
+    session_keep_alive_ = std::make_unique<ScopedKeepAlive>(
+        KeepAliveOrigin::SESSION_RESTORE, KeepAliveRestartOption::DISABLED);
