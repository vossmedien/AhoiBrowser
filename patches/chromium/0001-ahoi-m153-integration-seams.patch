+  tabs::TabInterface* const closed_pane = panes.front();
+  tabs::TabInterface* const expected_active = panes[1];
+  tabstrip()->ActivateTabAt(tabstrip()->GetIndexOfTab(closed_pane));
+  tabstrip()->CloseWebContentsAt(tabstrip()->GetIndexOfTab(closed_pane),
+                                 TabCloseTypes::CLOSE_NONE);
+
+  ASSERT_TRUE(tabstrip()->ContainsSplit(split_id));
+  EXPECT_EQ(expected_active, tabstrip()->GetActiveTab());
+  panes = tabstrip()->GetSplitData(split_id)->ListTabs();
+  ASSERT_EQ(3u, panes.size());
+  EXPECT_TRUE(tabstrip()->ReorderTabInSplit(panes.back(), panes.front()));
+  const std::vector<tabs::TabInterface*> reordered =
+      tabstrip()->GetSplitData(split_id)->ListTabs();
+  EXPECT_EQ(panes.back(), reordered.front());
+
+  tabstrip()->RemoveSplit(split_id);
+  EXPECT_FALSE(tabstrip()->ContainsSplit(split_id));
+  for (tabs::TabInterface* pane : reordered) {
+    EXPECT_FALSE(pane->IsSplit());
