+bool ShowAhoiQuickWindow(Browser* source_browser) {
+  Profile* profile = source_browser ? source_browser->GetProfile() : nullptr;
+  if (!profile || !profile->IsRegularProfile() || profile->IsOffTheRecord()) {
+    ProfileManager* profile_manager = g_browser_process->profile_manager();
+    if (profile_manager) {
+      for (Profile* candidate : profile_manager->GetLoadedProfiles()) {
+        if (candidate && candidate->IsRegularProfile() &&
+            !candidate->IsOffTheRecord()) {
+          profile = candidate;
+          break;
+        }
