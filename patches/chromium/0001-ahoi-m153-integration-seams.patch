+      ahoi_credential_state_->request_context ==
+          ahoi::HttpAuthRequestContext::kIncognito) {
+    std::move(done).Run();
+    return;
+  }
+  ahoi_credential_state_->service->DeleteCredential(
+      ahoi_credential_state_->protection_space, username,
+      ahoi_credential_state_->request_context, std::move(done));
+}
