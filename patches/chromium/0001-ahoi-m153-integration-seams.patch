+// A nested AppKit drag loop can paint before the next deferred Views layout.
+// Clip at the label boundary as a final invariant so stale glyphs can never
+// extend into a split divider or neighboring pane while geometry is changing.
+class DividerSafeLabel final : public views::Label {
+  METADATA_HEADER(DividerSafeLabel, views::Label)
+
+ public:
+  using views::Label::Label;
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    gfx::ScopedCanvas scoped_canvas(canvas);
+    // GetVisibleBounds() intersects the label with every current ancestor
+    // bound. Unlike GetLocalBounds(), it therefore remains divider-safe even
+    // during the frame where the pane has already shrunk but deferred flex
+    // layout has not yet updated this label's own stale width.
+    gfx::Rect clip_bounds = GetVisibleBounds();
+    clip_bounds.Inset(gfx::Insets::VH(0, 1));
+    canvas->ClipRect(clip_bounds);
+    views::Label::OnPaint(canvas);
+  }
+};
+
+BEGIN_METADATA(DividerSafeLabel)
+END_METADATA
