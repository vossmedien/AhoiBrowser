+bool BrowserView::HandleAhoiSplitAccelerator(
+    const ui::Accelerator& accelerator) {
+#if !BUILDFLAG(IS_MAC)
+  return false;
+#else
+  if (!accelerator.IsCmdDown() || !accelerator.IsCtrlDown() ||
+      accelerator.IsAltDown() || !browser_ || !multi_contents_view_) {
+    return false;
+  }
+
+  TabStripModel* const model = browser_->tab_strip_model();
+  tabs::TabInterface* const active_tab =
+      model ? model->GetActiveTab() : nullptr;
+  if (!active_tab || !active_tab->GetSplit().has_value()) {
+    return false;
+  }
+  const split_tabs::SplitTabId split_id = *active_tab->GetSplit();
+  split_tabs::SplitTabData* const split_data = model->GetSplitData(split_id);
+  if (!split_data || !split_data->visual_data()) {
+    return false;
+  }
+  const std::vector<tabs::TabInterface*> panes = split_data->ListTabs();
+  const auto active_it = std::ranges::find(panes, active_tab);
+  if (active_it == panes.end()) {
+    return false;
+  }
+  const size_t active_index =
+      static_cast<size_t>(std::distance(panes.begin(), active_it));
+
+  const auto focus_pane = [this, model, &panes](size_t pane_index) {
+    tabs::TabInterface* const pane = panes[pane_index];
+    const int tab_index = model->GetIndexOfTab(pane);
+    if (tab_index < 0) {
+      return false;
+    }
+    model->ActivateTabAt(tab_index);
+    if (ContentsContainerView* const container =
+            multi_contents_view_->GetContentsContainerViewFor(
+                pane->GetContents())) {
+      container->contents_view()->RequestFocus();
+    }
+    return true;
+  };
+
+  if (!accelerator.IsShiftDown() && accelerator.key_code() >= ui::VKEY_1 &&
+      accelerator.key_code() <= ui::VKEY_4) {
+    const auto pane_index = ahoi::split_drop::ResolveKeyboardPane(
+        static_cast<size_t>(accelerator.key_code() - ui::VKEY_0), panes.size());
+    return pane_index.has_value() && focus_pane(*pane_index);
+  }
+
+  if (accelerator.IsShiftDown() && (accelerator.key_code() == ui::VKEY_LEFT ||
+                                    accelerator.key_code() == ui::VKEY_RIGHT)) {
+    const int direction = accelerator.key_code() == ui::VKEY_RIGHT ? 1 : -1;
+    const auto target_index = ahoi::split_drop::ResolveReorderTarget(
+        active_index, panes.size(), direction);
+    if (!target_index.has_value()) {
+      return true;
+    }
+    return model->ReorderTabInSplit(active_tab, panes[*target_index]);
+  }
+
+  if (!accelerator.IsShiftDown() && accelerator.key_code() == ui::VKEY_L) {
+    const split_tabs::SplitTabVisualData next =
+        ahoi::split_drop::NextKeyboardLayout(*split_data->visual_data(),
+                                             panes.size());
+    model->UpdateSplitLayout(split_id, next.split_layout());
+    model->UpdateSplitArrangement(split_id, next.arrangement());
+    return true;
+  }
+
+  if (!accelerator.IsShiftDown() &&
+      (accelerator.key_code() == ui::VKEY_LEFT ||
+       accelerator.key_code() == ui::VKEY_RIGHT)) {
+    const int direction = accelerator.key_code() == ui::VKEY_RIGHT ? 1 : -1;
+    const double ratio = ahoi::split_drop::AdjustKeyboardSplitRatio(
+        split_data->visual_data()->split_ratio(), direction);
+    model->UpdateSplitRatio(split_id, ratio);
+    return true;
+  }
+
+  if (!accelerator.IsShiftDown() && accelerator.key_code() == ui::VKEY_0) {
+    model->RemoveSplit(split_id);
+    return true;
+  }
+  if (!accelerator.IsShiftDown() && accelerator.key_code() == ui::VKEY_W) {
+    active_tab->Close();
+    return true;
+  }
+  return false;
+#endif
+}
