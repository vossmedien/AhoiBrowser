+
+  bool HandleAccessibleAction(const ui::AXActionData& action_data) override {
+    int resize_amount = 0;
+    if (action_data.action == ax::mojom::Action::kIncrement) {
+      resize_amount = kKeyboardResizeWidth;
+    } else if (action_data.action == ax::mojom::Action::kDecrement) {
+      resize_amount = -kKeyboardResizeWidth;
+    }
+    if (resize_amount == 0) {
+      return views::ResizeArea::HandleAccessibleAction(action_data);
+    }
+    delegate_->OnResize(resize_amount, /*done_resizing=*/true);
+    return true;
+  }
+
+ private:
+  const raw_ptr<views::ResizeAreaDelegate> delegate_;
+};
