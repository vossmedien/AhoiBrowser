+bool HasExplicitAhoiStartupIntent(
+    const base::CommandLine& command_line,
+    bool has_command_line_tabs,
+    chrome::startup::IsProcessStartup process_startup) {
+  if (process_startup == chrome::startup::IsProcessStartup::kNo ||
+      has_command_line_tabs || !command_line.GetArgs().empty() ||
+      headless::IsHeadlessMode()) {
+    return true;
+  }
+
+  // Do not treat infrastructure switches such as --user-data-dir,
+  // --enable-features or logging flags as a navigation request. These switches
+  // directly select a startup journey and must remain authoritative.
+  constexpr const char* kIntentSwitches[] = {
+      switches::kApp,
+      switches::kAppId,
+      switches::kEnableAutomation,
+      switches::kGuest,
+      switches::kIncognito,
+      switches::kKioskMode,
+      switches::kNoStartupWindow,
+      switches::kOpenInNewWindow,
+      switches::kProfileDirectory,
+      switches::kRemoteDebuggingPipe,
+      switches::kRemoteDebuggingPort,
+      switches::kRestoreLastSession,
+      switches::kSameTab,
+      switches::kSilentLaunch,
+      switches::kStartFullscreen,
+      switches::kTestType,
+  };
+  const base::CommandLine* process_command_line =
+      base::CommandLine::ForCurrentProcess();
+  return std::ranges::any_of(kIntentSwitches, [&](const char* name) {
+    return command_line.HasSwitch(name) ||
+           (process_command_line && process_command_line != &command_line &&
+            process_command_line->HasSwitch(name));
+  });
+}
+
+#if BUILDFLAG(IS_LINUX)
+std::string GetLinuxStartupId(const base::CommandLine& command_line) {
+  std::string startup_id =
+      command_line.GetSwitchValueASCII(base::nix::kXdgActivationTokenSwitch);
+  if (startup_id.empty()) {
+    startup_id = command_line.GetSwitchValueASCII("desktop-startup-id");
+  }
+  if (startup_id.empty()) {
+    if (auto token = base::nix::TakeXdgActivationToken()) {
+      startup_id = *token;
+    }
+  }
+  return startup_id;
+}
+#endif  // BUILDFLAG(IS_LINUX)
+
+#if defined(TOOLKIT_VIEWS)
+void OnAhoiStartupChoice(base::WeakPtr<BrowserWindowInterface> browser,
+                         SessionRestore::BehaviorBitmask restore_options,
+                         ahoi::startup::StartupChoiceResult result) {
+  if (!browser) {
+    return;
+  }
+
+  Profile* profile = browser->GetProfile();
+  if (result.remember) {
+    const ahoi::session::StartupMode mode =
+        result.choice == ahoi::startup::StartupChoice::kContinue
+            ? ahoi::session::StartupMode::kContinue
+            : ahoi::session::StartupMode::kEmpty;
+    ahoi::session::SetStartupMode(profile->GetPrefs(), mode);
+  }
+
+  if (result.choice == ahoi::startup::StartupChoice::kContinue) {
+    // The choice is delivered after the modal widget has begun closing, so a
+    // synchronous restore is neither necessary nor safe. Passing the existing
+    // zero-tab browser lets Chromium populate it without clobbering a fake NTP.
+    restore_options &= ~static_cast<SessionRestore::BehaviorBitmask>(
+        SessionRestore::SYNCHRONOUS);
+    SessionRestore::RestoreSession(profile, browser.get(), restore_options,
+                                   StartupTabs());
+    return;
+  }
+
+  // This mirrors Chromium's normal non-crash clean-start cleanup without
+  // deleting the session history itself. A future explicit continue remains
+  // possible until the session service rotates it normally.
+  profile->GetDefaultStoragePartition()->DeleteStaleSessionData();
+}
+#endif  // defined(TOOLKIT_VIEWS)
+
+void OnGotAhoiStartupSession(
+    base::WeakPtr<BrowserWindowInterface> browser,
+    ahoi::session::StartupPolicyContext context,
+    SessionRestore::BehaviorBitmask restore_options,
+    std::vector<std::unique_ptr<sessions::SessionWindow>> windows,
+    SessionID /*active_window_id*/,
+    bool read_error) {
+  if (!browser) {
+    return;
+  }
+
+  context.has_restorable_session =
+      !read_error &&
+      std::ranges::any_of(
+          windows, [](const std::unique_ptr<sessions::SessionWindow>& window) {
+            return window && !window->tabs.empty();
+          });
+
+  Profile* profile = browser->GetProfile();
+  switch (ahoi::session::ResolveStartupDisposition(context)) {
+    case ahoi::session::StartupDisposition::kStartEmpty:
+      profile->GetDefaultStoragePartition()->DeleteStaleSessionData();
+      break;
+    case ahoi::session::StartupDisposition::kRestoreLastSession:
+      // SessionService completed the probe asynchronously. Keep the existing
+      // zero-tab browser alive and let the normal restore pipeline populate it.
+      restore_options &= ~static_cast<SessionRestore::BehaviorBitmask>(
+          SessionRestore::SYNCHRONOUS);
+      SessionRestore::RestoreSession(profile, browser.get(), restore_options,
+                                     StartupTabs());
+      break;
+    case ahoi::session::StartupDisposition::kShowChoice:
+#if defined(TOOLKIT_VIEWS)
+      if (!ahoi::startup::ShowStartupChoiceDialog(
+              browser.get(),
+              base::BindOnce(&OnAhoiStartupChoice, browser, restore_options))) {
+        profile->GetDefaultStoragePartition()->DeleteStaleSessionData();
+      }
+#else
+      profile->GetDefaultStoragePartition()->DeleteStaleSessionData();
+#endif  // defined(TOOLKIT_VIEWS)
+      break;
+    case ahoi::session::StartupDisposition::kDeferToChromium:
+      // High-priority Chromium startup cases do not schedule this probe.
+      NOTREACHED();
+  }
+}
