+  if (!profile || !profile->IsRegularProfile() || profile->IsOffTheRecord()) {
+    return false;
+  }
+
+  const gfx::Rect anchor_bounds =
+      source_browser && source_browser->GetWindow()
+          ? source_browser->GetWindow()->GetBounds()
+          : display::Screen::Get()->GetPrimaryDisplay().work_area();
+  return ahoi::quick_window::CreateAndShowQuickWindow(profile, anchor_bounds);
