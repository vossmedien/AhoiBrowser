+
+GURL LoginHandler::GetCredentialOriginUrl() const {
+  if (ahoi_credential_state_) {
+    return ahoi_credential_state_->protection_space.OriginUrl();
+  }
+  return auth_info_.challenger.GetURL();
+}
+
+bool LoginHandler::IsCredentialTransportSecure() const {
+  return GetCredentialOriginUrl().SchemeIs(url::kHttpsScheme);
+}
