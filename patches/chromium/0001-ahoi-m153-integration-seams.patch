+  // The Ahoi tree is the single flexible middle surface. Keeping Chromium's
+  // stock bottom container flexible as well makes the New Tab button float in
+  // the middle of the sidebar and leaves the page with the wrong content
+  // geometry.
+  bottom_button_container_->SetProperty(
+      views::kFlexBehaviorKey,
+      views::FlexSpecification(views::MinimumFlexSizeRule::kPreferred,
+                               ahoi_sidebar_tree_view_
+                                   ? views::MaximumFlexSizeRule::kPreferred
+                                   : views::MaximumFlexSizeRule::kUnbounded));
+  bottom_button_container_->SetVisible(!ahoi_sidebar_tree_view_);
+  // Ahoi owns the complete sidebar chrome. Chromium's stock collapse,
+  // organization, new-tab and tab-search controls target the hidden stock
+  // TabStripView and become misleading (or inert) when left above the Ahoi
+  // tree. Keep only the native window controls outside this region and restore
