+void MultiContentsViewMiniToolbar::UpdateActiveIndicatorAccessibility() {
+  auto& accessibility = active_indicator_->GetViewAccessibility();
+  if (!is_active_ || !web_contents_) {
+    if (!accessibility.GetCachedName().empty()) {
+      accessibility.RemoveName();
+    }
+    return;
+  }
+
+  std::u16string pane_name(domain_label_->GetText());
+  if (pane_name.empty()) {
+    pane_name = web_contents_->GetTitle();
+  }
+  if (pane_name.empty()) {
+    pane_name = url::kAboutBlankURL16;
+  }
+  accessibility.SetName(l10n_util::GetStringFUTF16(
+      IDS_AHOI_SPLIT_PANE_ACTIVE_ACCESSIBLE_STATUS, pane_name));
+}
