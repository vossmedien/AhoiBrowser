+void SplitTabMenuModel::ApplyLayoutPreset(
+    split_tabs::SplitTabLayout layout,
+    split_tabs::SplitTabArrangement arrangement,
+    size_t pane_count) {
+  CHECK(pane_count == 3u || pane_count == 4u);
+  const split_tabs::SplitTabId split_id = GetSplitTabId();
+  const split_tabs::SplitTabVisualData preset =
+      pane_count == 3u
+          ? split_tabs::SplitTabVisualData::ForThreePane(layout, arrangement)
+          : split_tabs::SplitTabVisualData::ForFourPane(layout);
+
+  split_tabs::SplitTabOrientationChangeSource source =
+      split_tabs::SplitTabOrientationChangeSource::kToolbarButton;
+  if (menu_source_ == MenuSource::kTabContextMenu) {
+    source = split_tabs::SplitTabOrientationChangeSource::kTabContextMenu;
+  }
+  tab_strip_model_->UpdateSplitLayout(split_id, preset.split_layout(), source);
+  tab_strip_model_->UpdateSplitArrangement(split_id, preset.arrangement());
+  tab_strip_model_->UpdateSplitRatio(split_id, 0, preset.split_ratio());
+  tab_strip_model_->UpdateSplitRatio(split_id, 1,
+                                     preset.secondary_split_ratio());
+}
