+  host_resolver()->AddRule("*", "127.0.0.1");
+  ASSERT_TRUE(embedded_test_server()->Start());
+  chrome::NewSplitTab(browser(), split_tabs::SplitTabLayout::kSideBySide,
+                      split_tabs::SplitTabCreatedSource::kToolbarButton);
+  RunScheduledLayouts();
+
+  content::WebContents* active_contents =
+      browser()->tab_strip_model()->GetActiveWebContents();
+  ASSERT_TRUE(active_contents);
+  ContentsContainerView* active_container =
+      multi_contents_view()->GetContentsContainerViewFor(active_contents);
+  ASSERT_TRUE(active_container);
+  MultiContentsViewMiniToolbar* toolbar = active_container->mini_toolbar();
+
+  const GURL committed_url =
+      embedded_test_server()->GetURL("committed.test", "/title1.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), committed_url));
+  EXPECT_EQ(base::ASCIIToUTF16(committed_url.host()),
+            toolbar->domain_label_for_testing()->GetText());
+  EXPECT_EQ(base::UTF8ToUTF16(committed_url.spec()), toolbar->GetTooltipText());
+
+  const GURL pending_url =
+      embedded_test_server()->GetURL("pending.test", "/hung");
+  content::TestNavigationManager pending_navigation(active_contents,
+                                                    pending_url);
+  active_contents->GetController().LoadURL(pending_url, content::Referrer(),
+                                           ui::PAGE_TRANSITION_TYPED,
+                                           std::string());
+  ASSERT_TRUE(pending_navigation.WaitForRequestStart());
+  ASSERT_EQ(pending_url, active_contents->GetVisibleURL());
+  EXPECT_EQ(base::ASCIIToUTF16(pending_url.host()),
+            toolbar->domain_label_for_testing()->GetText());
+  EXPECT_EQ(base::UTF8ToUTF16(pending_url.spec()), toolbar->GetTooltipText());
+
+  active_contents->Stop();
+  ASSERT_TRUE(pending_navigation.WaitForNavigationFinished());
+  EXPECT_EQ(base::ASCIIToUTF16(committed_url.host()),
+            toolbar->domain_label_for_testing()->GetText());
+  EXPECT_EQ(base::UTF8ToUTF16(committed_url.spec()), toolbar->GetTooltipText());
+
+  const GURL final_url =
+      embedded_test_server()->GetURL("final.test", "/title2.html");
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), final_url));
+  EXPECT_EQ(base::ASCIIToUTF16(final_url.host()),
+            toolbar->domain_label_for_testing()->GetText());
+  EXPECT_EQ(base::UTF8ToUTF16(final_url.spec()), toolbar->GetTooltipText());
+}
