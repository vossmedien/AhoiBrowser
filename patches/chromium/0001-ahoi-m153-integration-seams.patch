+
+void VerticalTabStripRegionView::ApplyAhoiSidebarPresentation() {
+  if (!ahoi_sidebar_tree_view_) {
+    return;
+  }
+
+  const bool target_visible = !IsAhoiSidebarHidden();
+  if (target_visible) {
+    ahoi_sidebar_visual_floating_ =
+        ahoi_sidebar_edge_revealed_ ||
+        ahoi::sidebar::IsFloating(ahoi_sidebar_presentation_mode_);
+  }
+  ahoi_sidebar_tree_view_->SetProperty(
+      views::kMarginsKey, GetAhoiSidebarMargins(ahoi_sidebar_visual_floating_,
+                                                toolbar_height_for_layout_));
+
+  if (!ahoi_sidebar_presentation_initialized_) {
+    ahoi_sidebar_presentation_initialized_ = true;
+    ahoi_sidebar_presentation_animator_.Reset(target_visible);
+  } else {
+    ahoi_sidebar_presentation_animator_.SetVisible(target_visible);
+  }
+  ApplyAhoiSidebarAnimationState();
+  PreferredSizeChanged();
+  InvalidateLayout();
+}
+
+void VerticalTabStripRegionView::ApplyAhoiSidebarAnimationState() {
+  if (!ahoi_sidebar_tree_view_) {
+    return;
+  }
+
+  const auto visual_state = ahoi_sidebar_presentation_animator_.visual_state();
+  const bool keep_mounted =
+      ahoi_sidebar_presentation_animator_.ShouldKeepSurfaceMounted();
+  ahoi_sidebar_tree_view_->SetVisible(keep_mounted);
+  resize_area_->SetVisible(keep_mounted);
+  // An outgoing surface stays paintable until its fade completes, but it must
+  // stop intercepting page input immediately. This also keeps a second rapid
+  // toggle from dispatching through a button that is being hidden.
+  SetCanProcessEventsWithinSubtree(
+      ahoi_sidebar_presentation_animator_.target_visible());
+
+  layer()->SetOpacity(visual_state.opacity);
+  gfx::Transform transform;
+  transform.Translate(-visual_state.horizontal_offset, 0);
+  layer()->SetTransform(transform);
+
+  if (auto* background = this->background()->AsA<CustomCornersBackground>()) {
+    // In floating mode the Ahoi host paints the only sidebar surface. Hiding
+    // the stock region background exposes the page around the inset card and
+    // avoids a full-height opaque strip behind it.
+    background->SetVisible(!ahoi_sidebar_visual_floating_ && keep_mounted);
+  }
+  SetAhoiSidebarRoundedClip(ahoi_sidebar_visual_floating_ && keep_mounted);
+  SchedulePaint();
+}
+
+void VerticalTabStripRegionView::SetAhoiSidebarRoundedClip(bool enabled) {
+  if (!ahoi_sidebar_tree_view_ || !ahoi_sidebar_tree_view_->layer()) {
+    return;
+  }
+  ui::Layer* const sidebar_layer = ahoi_sidebar_tree_view_->layer();
+  const gfx::RoundedCornersF radii(
+      enabled ? ahoi::visual_style::kFloatingSidebarCornerRadius : 0.0f);
+  sidebar_layer->SetRoundedCornerRadius(radii);
+  sidebar_layer->SetIsFastRoundedCorner(enabled);
+  // Rounded corner radii define the shape while masks-to-bounds guarantees
+  // that independently composited descendants cannot flash through its lower
+  // corners during scroll, drag and presentation animations.
+  sidebar_layer->SetMasksToBounds(enabled);
+}
+
+void VerticalTabStripRegionView::ResetAhoiSidebarAnimationForStockChrome() {
+  SetAhoiSidebarRoundedClip(false);
+  ahoi_sidebar_presentation_animator_.Reset(true);
+  ahoi_sidebar_presentation_initialized_ = false;
+  ahoi_sidebar_visual_floating_ = false;
+  resize_area_->SetVisible(!state_controller_->IsCollapsed() ||
+                           !state_controller_->IsExpandOnHoverEnabled() ||
+                           resize_area_->is_resizing());
+  SetCanProcessEventsWithinSubtree(true);
+  layer()->SetOpacity(1.0f);
+  layer()->SetTransform(gfx::Transform());
+  if (auto* background = this->background()->AsA<CustomCornersBackground>()) {
+    background->SetVisible(true);
+  }
+}
+
+void VerticalTabStripRegionView::OnSidebarPresentationAnimationUpdated() {
+  ApplyAhoiSidebarAnimationState();
+  if (!ahoi_sidebar_presentation_animator_.is_animating()) {
+    PreferredSizeChanged();
+    InvalidateLayout();
+  }
+}
