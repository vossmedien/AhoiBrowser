+
+BrowserWindowInterface* FindLastRegularAhoiBrowser() {
+  BrowserWindowInterface* source_browser = nullptr;
+  GlobalBrowserCollection::GetInstance()->ForEach(
+      [&source_browser](BrowserWindowInterface* browser) {
+        if (!browser || !browser->GetProfile() ||
+            !browser->GetProfile()->IsRegularProfile() ||
+            browser->GetProfile()->IsOffTheRecord()) {
+          return true;
+        }
+        source_browser = browser;
+        return false;
+      },
+      BrowserCollection::Order::kActivation);
+  return source_browser;
+}
+
+class AhoiQuickWindowGlobalShortcut
+    : public ui::GlobalAcceleratorListener::Observer {
+ public:
+  static AhoiQuickWindowGlobalShortcut* GetInstance() {
+    static base::NoDestructor<AhoiQuickWindowGlobalShortcut> instance;
+    return instance.get();
+  }
+
+  AhoiQuickWindowGlobalShortcut(const AhoiQuickWindowGlobalShortcut&) = delete;
+  AhoiQuickWindowGlobalShortcut& operator=(
+      const AhoiQuickWindowGlobalShortcut&) = delete;
+
+  void EnsureRegistered() {
+    if (registration_attempted_) {
+      return;
+    }
+    registration_attempted_ = true;
+    auto* listener = ui::GlobalAcceleratorListener::GetInstance();
+    if (!listener) {
+      return;
+    }
+    registered_ = listener->RegisterAccelerator(
+        ui::Accelerator(ui::VKEY_SPACE, ui::EF_ALT_DOWN), this);
+  }
+
+  bool registered() const { return registered_; }
+
+  bool Activate() {
+    const base::TimeTicks now = base::TimeTicks::Now();
+    if (!ahoi::quick_window::ShouldActivateQuickWindow(last_activation_, now)) {
+      return true;
+    }
+    last_activation_ = now;
+    return ShowAhoiQuickWindow(FindLastRegularAhoiBrowser());
+  }
+
+  // ui::GlobalAcceleratorListener::Observer:
+  void OnKeyPressed(const ui::Accelerator& accelerator) override {
+    if (!ahoi::quick_window::IsQuickWindowAccelerator(accelerator)) {
+      return;
+    }
+
+    Activate();
+  }
+
+  void ExecuteCommand(const std::string& accelerator_group_id,
+                      const std::string& command_id) override {}
+
+ private:
+  friend class base::NoDestructor<AhoiQuickWindowGlobalShortcut>;
+
+  AhoiQuickWindowGlobalShortcut() = default;
+  ~AhoiQuickWindowGlobalShortcut() override = default;
+
+  bool registration_attempted_ = false;
+  bool registered_ = false;
+  base::TimeTicks last_activation_;
+};
