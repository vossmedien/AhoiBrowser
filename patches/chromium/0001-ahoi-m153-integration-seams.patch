+      tab_strip_model_->GetSplitData(GetSplitTabId())->visual_data();
+  const split_tabs::SplitTabLayout layout = visual_data->split_layout();
+  const split_tabs::SplitTabArrangement arrangement =
+      visual_data->arrangement();
+
+  switch (id) {
+    case CommandId::kThreeColumns:
+      return layout == split_tabs::SplitTabLayout::kSideBySide &&
+             arrangement == split_tabs::SplitTabArrangement::kLinear;
+    case CommandId::kThreeRows:
+      return layout == split_tabs::SplitTabLayout::kStacked &&
+             arrangement == split_tabs::SplitTabArrangement::kLinear;
+    case CommandId::kThreeMainLeft:
+      return layout == split_tabs::SplitTabLayout::kSideBySide &&
+             arrangement == split_tabs::SplitTabArrangement::kMainStart;
+    case CommandId::kThreeMainRight:
+      return layout == split_tabs::SplitTabLayout::kSideBySide &&
+             arrangement == split_tabs::SplitTabArrangement::kMainEnd;
+    case CommandId::kThreeMainTop:
+      return layout == split_tabs::SplitTabLayout::kStacked &&
+             arrangement == split_tabs::SplitTabArrangement::kMainStart;
+    case CommandId::kThreeMainBottom:
+      return layout == split_tabs::SplitTabLayout::kStacked &&
+             arrangement == split_tabs::SplitTabArrangement::kMainEnd;
+    case CommandId::kFourGridColumnsFirst:
+      return layout == split_tabs::SplitTabLayout::kSideBySide;
+    case CommandId::kFourGridRowsFirst:
+      return layout == split_tabs::SplitTabLayout::kStacked;
+    default:
+      return false;
+  }
+}
