+// Native drags run a nested AppKit event loop and can detach the overlay host
+// before a queued Magic Mouse callback arrives. Such a callback must stop the
+// tracking session without navigating the detached WebContents.
+TEST_F(MacHistorySwiperTest, MagicMouseDetachedOverlayStopsWithoutNavigation) {
+  HistorySwiperTestDelegate* delegate =
+      [[HistorySwiperTestDelegate alloc] init];
+  delegate.overlayHost = view_;
+  HistorySwiper* historySwiper =
+      [[HistorySwiper alloc] initWithDelegate:delegate];
+
+  __block NSUInteger subviewCountAtBegan = 0;
+  __block BOOL trackingStopped = NO;
+  id event = [OCMockObject mockForClass:[NSEvent class]];
+  [[[event stub] andDo:^(NSInvocation* invocation) {
+    __unsafe_unretained void (^handler)(CGFloat, NSEventPhase, BOOL, BOOL*) =
+        nil;
+    [invocation getArgument:&handler atIndex:5];
+    BOOL stop = NO;
+    handler(0, NSEventPhaseBegan, NO, &stop);
+    subviewCountAtBegan = view_.subviews.count;
+    [view_.subviews.firstObject removeFromSuperview];
+    handler(0.4, NSEventPhaseEnded, NO, &stop);
+    trackingStopped = stop;
+  }] trackSwipeEventWithOptions:NSEventSwipeTrackingLockDirection
+       dampenAmountThresholdMin:-1
+                            max:1
+                   usingHandler:[OCMArg any]];
+
+  [historySwiper initiateMagicMouseHistorySwipe:NO event:event];
+
+  EXPECT_EQ(1u, subviewCountAtBegan);
+  EXPECT_TRUE(trackingStopped);
+  EXPECT_EQ(0u, delegate.navigationCount);
+}
