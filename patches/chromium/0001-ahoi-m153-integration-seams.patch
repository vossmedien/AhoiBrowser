+void MultiContentsView::SetAhoiEmptyStateVisible(bool visible) {
+  if (!ahoi_empty_state_view_) {
+    return;
+  }
+
+  const bool visibility_changed =
+      ahoi_empty_state_view_->GetVisible() != visible;
+
+  if (visible && IsInSplitView()) {
+    // A zero-tab model cannot retain a meaningful split. Clearing the extra
+    // pane bindings here also makes the next Cmd+T start from a clean layout.
+    CloseSplitView();
+  }
+  if (visible) {
+    // The shared TabStripModel can still have an active tab from another Ahoi
+    // workspace. Do not leave that WebContents visible behind the empty
+    // surface; the next real activation will attach it again through the
+    // normal BrowserView observer path.
+    for (ContentsContainerView* container : contents_container_views_) {
+      container->contents_view()->SetWebContents(nullptr);
+    }
+  }
+  if (!visibility_changed) {
+    return;
+  }
+  ahoi_empty_state_view_->SetVisible(visible);
+  InvalidateLayout();
+}
+
+bool MultiContentsView::IsAhoiEmptyStateVisibleForTesting() const {
