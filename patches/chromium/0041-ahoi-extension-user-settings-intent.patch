+base::CallbackListSubscription ExtensionRegistrar::ObserveUserSettingsRequests(
+    UserSettingsRequestCallback callback) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  return user_settings_observers_->Add(std::move(callback));
+}
+
+bool ExtensionRegistrar::NotifyUserSettingsRequested(const Extension& extension,
+                                                     bool installed,
+                                                     bool enabled) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  const auto lifetime = weak_factory_.GetWeakPtr();
+  const auto observers = user_settings_observers_;
+  scoped_refptr<const Extension> retained = &extension;
+  observers->Notify(*retained, installed, enabled);
+  return !!lifetime;
+}
+
 void ExtensionRegistrar::AddDisableFlagExemptedExtension(
     const ExtensionId& extension_id) {
   disable_flag_exempted_extensions_.insert(extension_id);
