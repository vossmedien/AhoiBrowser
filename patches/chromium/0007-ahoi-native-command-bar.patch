         this);
   }
 
+#if BUILDFLAG(IS_MAC)
+  // Ahoi's command bar owns only the canonical unmodified Command shortcuts.
+  // Menu commands and every other accelerator continue through Chromium's
+  // existing BrowserCommandController path.
+  const bool is_ahoi_command_shortcut =
+      accelerator.IsCmdDown() && !accelerator.IsCtrlDown() &&
+      !accelerator.IsAltDown() && !accelerator.IsShiftDown() &&
+      ((command_id == IDC_FOCUS_LOCATION &&
+        accelerator.key_code() == ui::VKEY_L) ||
+       (command_id == IDC_NEW_TAB && accelerator.key_code() == ui::VKEY_T));
+  if (is_ahoi_command_shortcut && toolbar_) {
+    if (!ahoi_command_bar_controller_) {
+      ahoi_command_bar_controller_ =
+          std::make_unique<ahoi::CommandBarController>(browser_.get(),
+                                                       toolbar_);
+    }
+    const ahoi::CommandBarDisposition disposition =
+        command_id == IDC_FOCUS_LOCATION
+            ? ahoi::CommandBarDisposition::kCurrentTab
+            : ahoi::CommandBarDisposition::kNewForegroundTab;
+    if (ahoi_command_bar_controller_->Show(disposition)) {
+      return true;
+    }
+  }
+#endif
+
   return chrome::ExecuteCommand(browser_.get(), command_id,
                                 accelerator.time_stamp());
 }
