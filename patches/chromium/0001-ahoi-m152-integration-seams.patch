+
+void VerticalTabStripRegionView::SetAhoiSidebarEdgeRevealed(bool revealed) {
+  if (ahoi_sidebar_presentation_mode_ !=
+      ahoi::sidebar::SidebarPresentationMode::kHidden) {
+    revealed = false;
+  }
+  if (ahoi_sidebar_edge_revealed_ == revealed) {
+    if (revealed) {
+      ahoi_sidebar_edge_hide_timer_.Stop();
+    }
+    return;
+  }
+  ahoi_sidebar_edge_revealed_ = revealed;
+  ahoi_sidebar_edge_hide_timer_.Stop();
+  ApplyAhoiSidebarPresentation();
+}
+
+void VerticalTabStripRegionView::ApplyAhoiSidebarPresentation() {
+  if (!ahoi_sidebar_tree_view_) {
+    return;
+  }
+
+  const bool target_visible = !IsAhoiSidebarHidden();
+  if (target_visible) {
+    ahoi_sidebar_visual_floating_ =
+        ahoi_sidebar_edge_revealed_ ||
+        ahoi::sidebar::IsFloating(ahoi_sidebar_presentation_mode_);
+  }
+  ahoi_sidebar_tree_view_->SetProperty(
+      views::kMarginsKey, GetAhoiSidebarMargins(ahoi_sidebar_visual_floating_,
+                                                toolbar_height_for_layout_));
+
+  if (!ahoi_sidebar_presentation_initialized_) {
+    ahoi_sidebar_presentation_initialized_ = true;
+    ahoi_sidebar_presentation_animator_.Reset(target_visible);
+  } else {
+    ahoi_sidebar_presentation_animator_.SetVisible(target_visible);
+  }
+  ApplyAhoiSidebarAnimationState();
+  PreferredSizeChanged();
+  InvalidateLayout();
+}
+
+void VerticalTabStripRegionView::ApplyAhoiSidebarAnimationState() {
+  if (!ahoi_sidebar_tree_view_) {
+    return;
+  }
+
+  const auto visual_state = ahoi_sidebar_presentation_animator_.visual_state();
+  const bool keep_mounted =
+      ahoi_sidebar_presentation_animator_.ShouldKeepSurfaceMounted();
+  ahoi_sidebar_tree_view_->SetVisible(keep_mounted);
+  resize_area_->SetVisible(keep_mounted);
+  // An outgoing surface stays paintable until its fade completes, but it must
+  // stop intercepting page input immediately. This also keeps a second rapid
+  // toggle from dispatching through a button that is being hidden.
+  SetCanProcessEventsWithinSubtree(
+      ahoi_sidebar_presentation_animator_.target_visible());
+
+  layer()->SetOpacity(visual_state.opacity);
+  gfx::Transform transform;
+  transform.Translate(-visual_state.horizontal_offset, 0);
+  layer()->SetTransform(transform);
+
+  if (auto* background = this->background()->AsA<CustomCornersBackground>()) {
+    // In floating mode the Ahoi host paints the only sidebar surface. Hiding
