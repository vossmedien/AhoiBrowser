+void LocationBarView::CopyCurrentUrl(const ui::Event&) {
+  content::WebContents* contents = GetWebContents();
+  if (!contents) {
+    return;
+  }
+  GURL url = contents->GetVisibleURL();
+  if (!url.is_valid() || url.is_empty()) {
+    url = contents->GetLastCommittedURL();
+  }
+  if (!url.is_valid() || url.is_empty()) {
+    return;
+  }
+  {
+    ui::ScopedClipboardWriter writer(ui::ClipboardBuffer::kCopyPaste);
+    writer.WriteText(base::UTF8ToUTF16(url.spec()));
+  }
+  if (ToastController* const toast_controller =
+          ToastController::MaybeGetForWebContents(contents)) {
+    toast_controller->MaybeShowToast(ToastParams(ToastId::kLinkCopied));
+  }
+}
+
+void LocationBarView::ShowAhoiPrivacyMode(const ui::Event&) {
+  BrowserView* const browser_view =
+      browser_ ? BrowserView::GetBrowserViewForBrowser(browser_) : nullptr;
+  if (browser_view && ahoi_privacy_button_) {
+    browser_view->ShowAhoiPrivacyMode(ahoi_privacy_button_);
+  }
+}
+
+bool LocationBarView::IsAhoiPrivacyModeShowing() const {
+  BrowserView* const browser_view =
+      browser_ ? BrowserView::GetBrowserViewForBrowser(browser_) : nullptr;
+  return browser_view && browser_view->IsAhoiPrivacyModeShowing();
+}
+
+void LocationBarView::UpdateAhoiPrivacyButton() {
+  if (!ahoi_privacy_button_ || !profile_) {
+    return;
+  }
+  content::WebContents* const contents = GetWebContents();
+  const GURL url = contents ? contents->GetLastCommittedURL() : GURL();
+  const bool supported = url.is_valid() && url.SchemeIsHTTPOrHTTPS();
+  const bool compatible =
+      supported && ahoi::privacy::GetModeForUrl(*profile_->GetPrefs(), url,
+                                                profile_->IsOffTheRecord()) ==
+                       ahoi::privacy::PrivacyMode::kChromiumCompatible;
+  const ui::ColorId icon_color =
+      compatible ? ahoi::visual_style::kAccent : kColorOmniboxActionIcon;
+  ahoi_privacy_button_->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(vector_icons::kShieldIcon, icon_color,
+                                     18));
+  ahoi_privacy_button_->SetEnabled(supported);
+  const std::u16string tooltip = l10n_util::GetStringUTF16(
+      !supported ? IDS_AHOI_PRIVACY_UNSUPPORTED_SITE
+      : compatible ? IDS_AHOI_PRIVACY_BUTTON_COMPATIBLE_TOOLTIP
+                   : IDS_AHOI_PRIVACY_BUTTON_TOOLTIP);
+  ahoi_privacy_button_->SetTooltipText(tooltip);
+  ahoi_privacy_button_->SetAccessibleName(tooltip);
+}
+
+void LocationBarView::ShowAhoiSiteData(const ui::Event&) {
+  BrowserView* const browser_view =
+      browser_ ? BrowserView::GetBrowserViewForBrowser(browser_) : nullptr;
+  if (browser_view && ahoi_cookie_button_ &&
+      ahoi_cookie_button_->GetEnabled()) {
+    ahoi::DeveloperToolkitController::ConfigureToolbarAnchor(
+        ahoi_cookie_button_, ahoi::DeveloperToolbarSurface::kCookieManager);
+    browser_view->ShowAhoiDeveloperToolkit(ahoi_cookie_button_);
+  }
+}
+
+void LocationBarView::ClearAhoiSiteCache(const ui::Event&) {
+  BrowserView* const browser_view =
