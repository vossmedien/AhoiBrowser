+      (delta > 0) != base::i18n::IsRTL() ? u"→  " : u"←  ";
+  ahoi_tab_switch_preview_label_->SetText(base::StrCat({arrow, title}));
+  ahoi_tab_switch_preview_label_->SetAccessibleName(title);
