+void MultiContentsViewMiniToolbar::WriteDragDataForView(
+    views::View* sender,
+    const gfx::Point& press_pt,
+    ui::OSExchangeData* data) {
+  CHECK_EQ(sender, this);
+  tabs::TabInterface* const tab = GetTabInterface(web_contents_);
+  if (!tab || !data) {
+    return;
+  }
+  // Build the complete native drag contract before the later drag-lifecycle
+  // activation can synchronously re-enter BrowserView and replace this view.
+  // TabHandle and the value objects remain valid independently of this View.
+  const int runtime_tab_handle = tab->GetHandle().raw_value();
+  std::optional<base::Uuid> saved_node_id;
+  if (browser_view_ && browser_view_->browser()) {
+    if (ahoi::SessionBridge* const session_bridge =
+            ahoi::SessionBridgeFactory::GetForProfile(
+                browser_view_->browser()->GetProfile())) {
+      saved_node_id = session_bridge->FindTreeNodeIdForTab(tab);
+    }
+  }
+  std::u16string title = web_contents_->GetTitle();
+  if (title.empty()) {
+    title = domain_label_->GetText();
+  }
+  const ui::ColorProvider* const colors = GetColorProvider();
+  const ui::ImageModel& favicon_model = favicon_->GetImageModel();
+  gfx::ImageSkia favicon;
+  if (!favicon_model.IsEmpty() && (colors || favicon_model.IsImage())) {
+    favicon = favicon_model.Rasterize(colors);
+  }
+  const gfx::ImageSkia drag_image = ahoi::sidebar::CreateSidebarPreviewImage(
+      GetWidget(), colors, favicon, title, {});
+  if (drag_image.isNull() || drag_image.size().IsEmpty()) {
+    return;
+  }
+  data->provider().SetDragImage(
+      drag_image,
+      ahoi::sidebar::GetSidebarDragImageCursorOffset(drag_image, press_pt));
+  ahoi::sidebar::WriteOpenTabDragPayload(
+      data, saved_node_id, runtime_tab_handle, title);
+  // This is deliberately the final operation. Publishing the drag identity
+  // reveals only fixed-geometry targets, but it can still re-enter sidebar
+  // observers; the complete OSExchangeData contract must already be valid and
+  // no member of this mini toolbar may be read afterwards.
+  ahoi_drag_published_ = true;
+  browser_view_->BeginAhoiSidebarTabDrag(
+      {.saved_node_id = saved_node_id,
+       .runtime_tab_handle = saved_node_id.has_value()
+                                 ? std::nullopt
+                                 : std::make_optional(runtime_tab_handle)});
+}
