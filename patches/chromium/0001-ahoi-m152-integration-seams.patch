+// BrowserView deliberately paints Ahoi's floating navigation above the
+// floating sidebar. During a sidebar-owned native drag, however, a transparent
+// toolbar overlap must not become the deepest event target: DropHelper only
+// walks ancestors and would otherwise skip the sibling sidebar entirely.
+// Installing this targeter on TopContainer alone preserves the z-order of
+// find bars, modal scrims and every other BrowserView sibling.
+class AhoiSidebarDragViewTargeterDelegate : public OverlayViewTargeterDelegate {
+ public:
+  explicit AhoiSidebarDragViewTargeterDelegate(
+      VerticalTabStripRegionView* sidebar_region)
+      : sidebar_region_tracker_(sidebar_region) {}
+  AhoiSidebarDragViewTargeterDelegate(
+      const AhoiSidebarDragViewTargeterDelegate&) = delete;
+  AhoiSidebarDragViewTargeterDelegate& operator=(
+      const AhoiSidebarDragViewTargeterDelegate&) = delete;
+  ~AhoiSidebarDragViewTargeterDelegate() override = default;
+
+  bool DoesIntersectRect(const views::View* target,
+                         const gfx::Rect& rect) const override {
+    const auto* const sidebar_region =
+        static_cast<const VerticalTabStripRegionView*>(
+            sidebar_region_tracker_.view());
+    const views::View* const sidebar =
+        sidebar_region ? sidebar_region->ahoi_sidebar_tree_view() : nullptr;
+    if (!sidebar || !sidebar->GetVisible() ||
+        !sidebar_region->GetCanProcessEventsWithinSubtree() ||
+        !sidebar_region->IsAhoiSidebarFloating() ||
+        !ahoi::sidebar::IsAnyBrowserSidebarDragActive()) {
+      return OverlayViewTargeterDelegate::DoesIntersectRect(target, rect);
+    }
+
+    // TopContainer may be reparented into OverlayWidgetMac during immersive
+    // fullscreen. Screen-point conversion remains valid across Widget roots,
+    // whereas ConvertRectToTarget() requires a shared hierarchy root.
+    const gfx::Point screen_point =
+        views::View::ConvertPointToScreen(target, rect.CenterPoint());
+    const gfx::Point sidebar_point =
+        views::View::ConvertPointFromScreen(sidebar, screen_point);
+    if (sidebar->HitTestPoint(sidebar_point)) {
+      return false;
+    }
+    return OverlayViewTargeterDelegate::DoesIntersectRect(target, rect);
+  }
+
+ private:
+  views::ViewTracker sidebar_region_tracker_;
+};
