+  ahoi_credential_state_->service->GetCredentials(
+      ahoi_credential_state_->protection_space,
+      ahoi_credential_state_->request_path,
+      ahoi_credential_state_->request_context,
+      explicit_user_selection
+          ? ahoi::HttpAuthSelectionMode::kExplicitUserSelection
+          : ahoi::HttpAuthSelectionMode::kAutomatic,
+      base::BindOnce(
+          [](SavedCredentialsCallback callback,
+             std::vector<ahoi::HttpAuthCredential> credentials) {
+            std::vector<SavedCredential> result;
+            result.reserve(credentials.size());
+            for (auto& credential : credentials) {
+              result.push_back(
+                  {.username = std::move(credential.metadata.username),
+                   .password = std::move(credential.password),
+                   .preferred = credential.metadata.preferred,
+                   .last_successful = credential.metadata.last_successful});
+            }
+            std::move(callback).Run(std::move(result));
+          },
+          std::move(callback)));
