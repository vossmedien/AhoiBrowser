+
+void LocationBarView::UpdateAhoiDeveloperButtons() {
+  if (!ahoi_cookie_button_ || !ahoi_cache_button_ ||
+      !ahoi_developer_toolkit_button_ || !profile_) {
+    return;
+  }
+  Profile* const original_profile = profile_->GetOriginalProfile();
+  const auto visibility = ahoi::developer_toolkit_prefs::GetToolbarVisibility(
+      *original_profile->GetPrefs());
+  BrowserView* const browser_view =
+      browser_ ? BrowserView::GetBrowserViewForBrowser(browser_) : nullptr;
+  const bool site_actions_enabled =
+      browser_view && browser_view->CanExecuteAhoiDeveloperAction();
+  const bool toolkit_enabled = browser_view && GetWebContents();
+
+  ahoi_cookie_button_->SetVisible(visibility.cookie);
+  ahoi_cache_button_->SetVisible(visibility.cache);
+  ahoi_developer_toolkit_button_->SetVisible(visibility.toolkit);
+  ahoi_cookie_button_->SetEnabled(site_actions_enabled);
+  ahoi_cache_button_->SetEnabled(site_actions_enabled);
+  ahoi_developer_toolkit_button_->SetEnabled(toolkit_enabled);
+  if (!site_actions_enabled) {
+    const std::u16string unavailable =
+        l10n_util::GetStringUTF16(IDS_AHOI_DEVELOPER_UNSUPPORTED_PAGE);
+    ahoi_cookie_button_->SetTooltipText(unavailable);
+    ahoi_cookie_button_->SetAccessibleName(unavailable);
+    ahoi_cache_button_->SetTooltipText(unavailable);
+    ahoi_cache_button_->SetAccessibleName(unavailable);
+  } else {
+    const std::u16string cookie = l10n_util::GetStringUTF16(
+        IDS_AHOI_DEVELOPER_COOKIE_BUTTON_TOOLTIP);
+    const std::u16string cache = l10n_util::GetStringUTF16(
+        IDS_AHOI_DEVELOPER_CACHE_BUTTON_TOOLTIP);
+    ahoi_cookie_button_->SetTooltipText(cookie);
+    ahoi_cookie_button_->SetAccessibleName(cookie);
+    ahoi_cache_button_->SetTooltipText(cache);
+    ahoi_cache_button_->SetAccessibleName(cache);
+  }
+  InvalidateLayout();
+  SchedulePaint();
+}
