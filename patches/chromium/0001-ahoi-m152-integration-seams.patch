+void VerticalTabStripRegionView::SetAhoiSidebarPresentationMode(
+    ahoi::sidebar::SidebarPresentationMode mode) {
+  ahoi_sidebar_presentation_mode_ = mode;
+  ahoi_sidebar_edge_revealed_ = false;
+  ahoi_sidebar_edge_hide_timer_.Stop();
