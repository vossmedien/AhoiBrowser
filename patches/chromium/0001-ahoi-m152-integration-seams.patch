+bool LoginTabHelper::MaybeFinalizeAuthentication(
+    content::NavigationHandle* navigation_handle) {
+  if (!pending_auth_attempt_) {
+    return false;
+  }
+
+  const auto clear_pending = [&]() {
+    pending_credential_save_.reset();
+    pending_auth_attempt_.reset();
+  };
+  if (!navigation_handle->HasCommitted() ||
+      !navigation_handle->GetResponseHeaders()) {
+    clear_pending();
+    return false;
+  }
+
+  const int response_code =
+      navigation_handle->GetResponseHeaders()->response_code();
+  if (response_code == net::HttpStatusCode::HTTP_UNAUTHORIZED ||
+      response_code ==
+          net::HttpStatusCode::HTTP_PROXY_AUTHENTICATION_REQUIRED) {
+    // A failed retry must not delete, replace, or persist a saved account.
+    const std::optional<net::AuthChallengeInfo>& challenge =
+        navigation_handle->GetAuthChallengeInfo();
+    const bool same_protection_space =
+        challenge &&
+        challenge->challenger == pending_auth_attempt_->auth_info.challenger &&
+        challenge->is_proxy == pending_auth_attempt_->auth_info.is_proxy &&
+        challenge->realm == pending_auth_attempt_->auth_info.realm &&
+        base::EqualsCaseInsensitiveASCII(
+            challenge->scheme, pending_auth_attempt_->auth_info.scheme);
+    Profile* profile =
+        Profile::FromBrowserContext(web_contents()->GetBrowserContext());
+    ahoi::HttpAuthCredentialService* service =
+        ahoi::HttpAuthCredentialServiceFactory::GetForProfile(profile);
+    std::optional<ahoi::HttpAuthProtectionSpace> protection_space =
+        ahoi::HttpAuthProtectionSpace::FromChallenge(
+            pending_auth_attempt_->auth_info,
+            pending_auth_attempt_->request_url,
+            pending_auth_attempt_->network_anonymization_key);
+    if (service && profile && protection_space) {
+      service->RecordAuthenticationFailure(
+          *protection_space,
+          pending_auth_attempt_->request_url.PathForRequest(),
+          pending_auth_attempt_->username,
+          profile->IsOffTheRecord() ? ahoi::HttpAuthRequestContext::kIncognito
+                                    : ahoi::HttpAuthRequestContext::kRegular);
+    }
+    clear_pending();
+    return same_protection_space;
+  }
+  const bool same_origin =
+      url::Origin::Create(navigation_handle->GetURL()) ==
+      url::Origin::Create(pending_auth_attempt_->request_url);
+  const std::vector<GURL>& redirect_chain =
+      navigation_handle->GetRedirectChain();
+  const bool is_matching_auth_reload =
+      (!redirect_chain.empty() &&
+       redirect_chain.front() == pending_auth_attempt_->request_url) ||
+      navigation_handle->GetURL() == pending_auth_attempt_->request_url;
+  std::optional<ahoi::HttpAuthProtectionSpace> protection_space =
+      ahoi::HttpAuthProtectionSpace::FromChallenge(
+          pending_auth_attempt_->auth_info, pending_auth_attempt_->request_url,
+          pending_auth_attempt_->network_anonymization_key);
+  const bool same_server_path =
+      protection_space && protection_space->AllowsPath(
+                              navigation_handle->GetURL().PathForRequest());
+  if (response_code < 200 || response_code >= 400 || !same_origin ||
+      !is_matching_auth_reload ||
+      (!pending_auth_attempt_->auth_info.is_proxy && !same_server_path)) {
+    clear_pending();
+    return false;
+  }
+
+  Profile* profile =
+      Profile::FromBrowserContext(web_contents()->GetBrowserContext());
+  if (!profile) {
+    clear_pending();
+    return false;
+  }
+
+  if (protection_space) {
+    if (ahoi::HttpAuthSessionController* session =
+            ahoi::HttpAuthSessionController::GetOrCreate(web_contents())) {
+      session->RecordSuccessfulAuthentication(*protection_space);
+    }
+  }
+
+  if (!pending_credential_save_) {
+    clear_pending();
+    return false;
+  }
+  ahoi::HttpAuthCredentialService* service =
+      ahoi::HttpAuthCredentialServiceFactory::GetForProfile(profile);
+  if (!service) {
+    clear_pending();
+    return false;
+  }
+
+  protection_space = ahoi::HttpAuthProtectionSpace::FromChallenge(
+      pending_credential_save_->auth_info,
+      pending_credential_save_->request_url,
+      pending_credential_save_->network_anonymization_key);
+  if (!protection_space) {
+    clear_pending();
+    return false;
+  }
+
+  const ahoi::HttpAuthRequestContext request_context =
+      profile->IsOffTheRecord() ? ahoi::HttpAuthRequestContext::kIncognito
+                                : ahoi::HttpAuthRequestContext::kRegular;
+  net::AuthCredentials credentials(pending_credential_save_->username,
+                                   pending_credential_save_->password);
+  service->RecordSuccessfulAuthentication(
+      *protection_space, pending_credential_save_->request_url.PathForRequest(),
+      credentials, request_context,
+      pending_credential_save_->user_confirmed_insecure_http);
+  clear_pending();
+  return false;
+}
