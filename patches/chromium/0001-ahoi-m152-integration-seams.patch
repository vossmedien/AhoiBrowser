+bool BrowserView::HandleAhoiSplitAccelerator(
+    const ui::Accelerator& accelerator) {
+#if !BUILDFLAG(IS_MAC)
+  return false;
+#else
+  if (!accelerator.IsCmdDown() || !accelerator.IsCtrlDown() ||
+      accelerator.IsAltDown() || !browser_ || !multi_contents_view_) {
+    return false;
+  }
+
+  TabStripModel* const model = browser_->tab_strip_model();
+  tabs::TabInterface* const active_tab =
+      model ? model->GetActiveTab() : nullptr;
+  if (!active_tab || !active_tab->GetSplit().has_value()) {
+    return false;
+  }
+  const split_tabs::SplitTabId split_id = *active_tab->GetSplit();
+  split_tabs::SplitTabData* const split_data = model->GetSplitData(split_id);
+  if (!split_data || !split_data->visual_data()) {
+    return false;
+  }
+  const std::vector<tabs::TabInterface*> panes = split_data->ListTabs();
+  const auto active_it = std::ranges::find(panes, active_tab);
+  if (active_it == panes.end()) {
+    return false;
+  }
+  const size_t active_index =
+      static_cast<size_t>(std::distance(panes.begin(), active_it));
+
+  const auto focus_pane = [this, model, &panes](size_t pane_index) {
+    tabs::TabInterface* const pane = panes[pane_index];
+    const int tab_index = model->GetIndexOfTab(pane);
+    if (tab_index < 0) {
+      return false;
+    }
+    model->ActivateTabAt(tab_index);
+    if (ContentsContainerView* const container =
+            multi_contents_view_->GetContentsContainerViewFor(
+                pane->GetContents())) {
+      container->contents_view()->RequestFocus();
+    }
+    return true;
+  };
+
+  if (!accelerator.IsShiftDown() && accelerator.key_code() >= ui::VKEY_1 &&
+      accelerator.key_code() <= ui::VKEY_4) {
+    const auto pane_index = ahoi::split_drop::ResolveKeyboardPane(
+        static_cast<size_t>(accelerator.key_code() - ui::VKEY_0), panes.size());
+    return pane_index.has_value() && focus_pane(*pane_index);
+  }
+
+  if (accelerator.IsShiftDown() && (accelerator.key_code() == ui::VKEY_LEFT ||
+                                    accelerator.key_code() == ui::VKEY_RIGHT)) {
+    const int direction = accelerator.key_code() == ui::VKEY_RIGHT ? 1 : -1;
+    const auto target_index = ahoi::split_drop::ResolveReorderTarget(
+        active_index, panes.size(), direction);
+    if (!target_index.has_value()) {
+      return true;
+    }
+    return model->ReorderTabInSplit(active_tab, panes[*target_index]);
+  }
+
+  if (!accelerator.IsShiftDown() && accelerator.key_code() == ui::VKEY_L) {
+    const split_tabs::SplitTabVisualData next =
+        ahoi::split_drop::NextKeyboardLayout(*split_data->visual_data(),
+                                             panes.size());
+    model->UpdateSplitLayout(split_id, next.split_layout());
+    model->UpdateSplitArrangement(split_id, next.arrangement());
+    return true;
+  }
+
+  if (!accelerator.IsShiftDown() &&
+      (accelerator.key_code() == ui::VKEY_LEFT ||
+       accelerator.key_code() == ui::VKEY_RIGHT)) {
+    const int direction = accelerator.key_code() == ui::VKEY_RIGHT ? 1 : -1;
+    const double ratio = ahoi::split_drop::AdjustKeyboardSplitRatio(
+        split_data->visual_data()->split_ratio(), direction);
+    model->UpdateSplitRatio(split_id, ratio);
+    return true;
+  }
+
+  if (!accelerator.IsShiftDown() && accelerator.key_code() == ui::VKEY_0) {
+    model->RemoveSplit(split_id);
+    return true;
+  }
+  if (!accelerator.IsShiftDown() && accelerator.key_code() == ui::VKEY_W) {
+    active_tab->Close();
+    return true;
+  }
+  return false;
+#endif
+}
+
+bool BrowserView::ShowAhoiCommandBar(int command_id) {
+  if ((command_id != IDC_FOCUS_LOCATION && command_id != IDC_NEW_TAB) ||
+      !toolbar_ || !contents_container_) {
+    return false;
+  }
+  if (!ahoi_command_bar_controller_) {
+    ahoi_command_bar_controller_ = std::make_unique<ahoi::CommandBarController>(
+        browser_.get(), ahoi_modal_overlay_controller_.get(),
+        vertical_tab_strip_region_view_
+            ? vertical_tab_strip_region_view_->ahoi_sidebar_tree_view()
+            : nullptr);
+  }
+  const ahoi::CommandBarDisposition disposition =
+      command_id == IDC_FOCUS_LOCATION
+          ? ahoi::CommandBarDisposition::kCurrentTab
+          : ahoi::CommandBarDisposition::kNewForegroundTab;
+  return ahoi_command_bar_controller_->Show(disposition);
+}
+
+bool BrowserView::ShowAhoiDeveloperToolkit(views::View* anchor_view) {
+  if (!browser_ || !anchor_view || !toolbar_ || !contents_container_) {
+    return false;
+  }
+  if (!ahoi_developer_toolkit_controller_) {
+    ahoi_developer_toolkit_controller_ =
+        std::make_unique<ahoi::DeveloperToolkitController>(browser_.get());
+  }
+  const bool handled =
+      ahoi_developer_toolkit_controller_->Show(anchor_view);
+  if (handled && ahoi_privacy_mode_controller_) {
+    ahoi_privacy_mode_controller_->Close();
+  }
+  return handled;
+}
+
+bool BrowserView::IsAhoiDeveloperToolbarSurfaceShowing(
+    ahoi::DeveloperToolbarSurface surface) const {
+  return ahoi_developer_toolkit_controller_ &&
+         ahoi_developer_toolkit_controller_->IsSurfaceShowing(surface);
+}
+
+bool BrowserView::CanExecuteAhoiDeveloperAction() const {
+  if (!browser_) {
+    return false;
+  }
+  if (ahoi_developer_toolkit_controller_) {
+    return ahoi_developer_toolkit_controller_->CanExecute();
+  }
+  return ahoi::IsSupportedDeveloperTarget(
+      browser_->tab_strip_model()->GetActiveWebContents());
+}
+
+bool BrowserView::ExecuteAhoiDeveloperAction(ahoi::DeveloperAction action) {
+  if (!browser_) {
+    return false;
+  }
+  if (!ahoi_developer_toolkit_controller_) {
+    ahoi_developer_toolkit_controller_ =
+        std::make_unique<ahoi::DeveloperToolkitController>(browser_.get());
+  }
+  return ahoi_developer_toolkit_controller_->Execute(action).succeeded();
+}
+
+bool BrowserView::ShowAhoiPrivacyMode(views::View* anchor_view) {
+  if (!browser_ || !anchor_view || !toolbar_ || !contents_container_) {
+    return false;
+  }
+  if (!ahoi_privacy_mode_controller_) {
+    ahoi_privacy_mode_controller_ =
+        std::make_unique<ahoi::PrivacyModeController>(browser_.get());
+  }
+  const bool handled = ahoi_privacy_mode_controller_->Show(anchor_view);
+  if (handled && ahoi_developer_toolkit_controller_) {
+    ahoi_developer_toolkit_controller_->CloseAllSurfaces();
+  }
+  return handled;
+}
+
+bool BrowserView::IsAhoiPrivacyModeShowing() const {
+  return ahoi_privacy_mode_controller_ &&
+         ahoi_privacy_mode_controller_->IsShowing();
+}
+
+bool BrowserView::CanShowAhoiPrivacyMode() const {
+  if (!browser_) {
+    return false;
+  }
+  return ahoi_privacy_mode_controller_
+             ? ahoi_privacy_mode_controller_->CanShow()
+             : browser_->GetProfile() &&
+                   browser_->tab_strip_model()->GetActiveWebContents();
+}
+
+bool BrowserView::SaveCurrentTabToAhoiTree() {
+  if (!browser_ || !browser_->is_type_normal() || !browser_->GetProfile() ||
+      !browser_->GetProfile()->IsRegularProfile() ||
+      browser_->GetProfile()->IsOffTheRecord()) {
+    return false;
+  }
+  ahoi::SessionBridge* session_bridge =
+      ahoi::SessionBridgeFactory::GetForProfile(browser_->GetProfile());
+  tabs::TabInterface* active_tab = browser_->tab_strip_model()->GetActiveTab();
+  if (!session_bridge || !session_bridge->is_ready() || !active_tab) {
+    return false;
+  }
+  return session_bridge->SaveTabAtWorkspaceRoot(browser_.get(), active_tab)
+      .has_value();
+}
