+int RowY(size_t row_index) {
+  constexpr size_t kMaxRowIndex =
+      static_cast<size_t>(std::numeric_limits<int>::max()) /
+      SidebarTreeRowView::kRowHeight;
+  return base::saturated_cast<int>(std::min(row_index, kMaxRowIndex) *
+                                   SidebarTreeRowView::kRowHeight);
+}
