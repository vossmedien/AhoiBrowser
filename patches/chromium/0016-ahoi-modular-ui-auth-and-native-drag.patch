+TEST_F(SidebarTreeViewTest, TabOnTabDropUsesVisibleSplitTarget) {
+  tab_tree::Workspace workspace = MakeWorkspace();
+  ASSERT_EQ(tab_tree::TabTreeStore::Result::kOk,
