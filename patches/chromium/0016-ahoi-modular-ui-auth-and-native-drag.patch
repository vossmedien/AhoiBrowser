+void BrowserView::OnScrollEvent(ui::ScrollEvent* event) {
+#if BUILDFLAG(IS_MAC)
+  // Root pre-target delivery lets the gesture work over both native chrome and
+  // rendered page content. Target delivery is ignored to avoid accumulating a
+  // stream twice when BrowserView itself happens to be the event target.
+  if (event->phase() != ui::EP_PRETARGET || !vertical_tab_strip_region_view_ ||
+      !vertical_tab_strip_region_view_->ahoi_sidebar_tree_view()) {
+    return;
+  }
+
+  const ui::ScrollEventPhase direct_phase = event->scroll_event_phase();
+  const ui::EventMomentumPhase momentum_phase = event->momentum_phase();
+  if (direct_phase == ui::ScrollEventPhase::kNone &&
+      momentum_phase == ui::EventMomentumPhase::NONE) {
+    return;
+  }
+
+  if (direct_phase == ui::ScrollEventPhase::kBegan) {
+    ahoi_workspace_swipe_tracker_.OnGestureBegin();
+  }
+
+  ahoi::WorkspaceSwipeDecision decision = ahoi::WorkspaceSwipeDecision::kNone;
+  const bool is_momentum_update =
+      momentum_phase == ui::EventMomentumPhase::BEGAN ||
+      momentum_phase == ui::EventMomentumPhase::INERTIAL_UPDATE;
+  if (is_momentum_update) {
+    decision = ahoi_workspace_swipe_tracker_.OnMomentum();
+  } else if (direct_phase == ui::ScrollEventPhase::kBegan ||
+             direct_phase == ui::ScrollEventPhase::kUpdate ||
+             direct_phase == ui::ScrollEventPhase::kEnd) {
+    decision = ahoi_workspace_swipe_tracker_.OnGestureUpdate(
+        event->x_offset_ordinal(), event->y_offset_ordinal());
+  }
+
+  if (direct_phase == ui::ScrollEventPhase::kEnd) {
+    const ahoi::WorkspaceSwipeDecision end_decision =
+        ahoi_workspace_swipe_tracker_.OnGestureEnd();
+    if (decision == ahoi::WorkspaceSwipeDecision::kNone) {
+      decision = end_decision;
+    }
+  }
+  if (momentum_phase == ui::EventMomentumPhase::END ||
+      momentum_phase == ui::EventMomentumPhase::BLOCKED) {
+    const ahoi::WorkspaceSwipeDecision momentum_decision =
+        ahoi_workspace_swipe_tracker_.OnMomentum();
+    const ahoi::WorkspaceSwipeDecision end_decision =
+        ahoi_workspace_swipe_tracker_.OnGestureEnd();
+    if (decision == ahoi::WorkspaceSwipeDecision::kNone) {
+      decision = momentum_decision != ahoi::WorkspaceSwipeDecision::kNone
+                     ? momentum_decision
+                     : end_decision;
+    }
+  }
+
+  bool consume = decision == ahoi::WorkspaceSwipeDecision::kConsume;
+  if (decision == ahoi::WorkspaceSwipeDecision::kSwitchPrevious ||
+      decision == ahoi::WorkspaceSwipeDecision::kSwitchNext) {
+    const int delta =
+        decision == ahoi::WorkspaceSwipeDecision::kSwitchNext ? 1 : -1;
+    consume = ahoi::sidebar::ActivateRelativeBrowserWorkspace(
+        vertical_tab_strip_region_view_->ahoi_sidebar_tree_view(), delta);
+    if (!consume) {
+      ahoi_workspace_swipe_tracker_.OnGestureCancel();
+    }
+  }
+  if (consume) {
+    event->SetHandled();
+    event->StopPropagation();
+  }
+#endif
+}
