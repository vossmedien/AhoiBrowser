-          base::BindRepeating([](ActivateCallback callback, base::Uuid node_id,
-                                 const ui::Event&) { callback.Run(node_id); },
-                              activate_callback_, link.node_id),
-          link, relative_time));
-      if (++result_count == kMaxVisibleResults) {
-        break;
