-      return;
-    }
-    if (context_menu_scope_ == ContextMenuScope::kTree &&
-        context_node_id_.has_value() &&
-        command_id >= kMoveToFolderCommandBase) {
-      const size_t index =
-          static_cast<size_t>(command_id - kMoveToFolderCommandBase);
