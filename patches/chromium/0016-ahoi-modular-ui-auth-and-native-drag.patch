-    return Result::kOk;
-  }
-
-  const bool changes_workspace = node.workspace_id != workspace_id;
-  std::vector<TreeNode> affected_nodes;
-  if (changes_workspace) {
-    result = ReadSubtree(node_id, &affected_nodes);
