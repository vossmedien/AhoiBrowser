+bool BrowserSidebarHostView::ActivateRelativeWorkspace(int delta) {
+  return delta != 0 &&
+         session_bridge_
+             ->ActivateRelativeWorkspaceForWindow(
+                 browser_, delta, WorkspaceActivationSource::kKeyboard)
+             .has_value();
+}
