+TEST_F(SessionBridgeTest, DuplicatesWorkspaceTreeAndPlacesItAfterSource) {
+  ASSERT_EQ(workspace_service_->ordered_workspaces().size(), 1u);
+  const base::Uuid source_id =
+      workspace_service_->ordered_workspaces().front().id;
