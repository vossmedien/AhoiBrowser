+std::unique_ptr<views::View> VerticalTabStripRegionView::SetAhoiSidebarTreeView(
+    std::unique_ptr<views::View> view,
+    views::View* default_focus_view) {
+  CHECK(!default_focus_view || (view && view->Contains(default_focus_view)));
+  std::unique_ptr<views::View> previous;
+  if (ahoi_sidebar_tree_view_) {
+    ahoi_sidebar_default_focus_view_tracker_.SetView(nullptr);
+    previous =
+        RemoveChildViewT(std::exchange(ahoi_sidebar_tree_view_, nullptr));
+  }
+
+  if (view) {
+    ahoi_sidebar_default_focus_view_tracker_.SetView(
+        default_focus_view ? default_focus_view : view.get());
+    ahoi_sidebar_tree_view_ = AddChildView(std::move(view));
+    ahoi_sidebar_tree_view_->SetProperty(
+        views::kFlexBehaviorKey,
+        views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToMinimum,
+                                 views::MaximumFlexSizeRule::kUnbounded));
+    ahoi_sidebar_tree_view_->SetProperty(
+        views::kMarginsKey,
+        gfx::Insets::VH(
+            GetLayoutConstant(
+                LayoutConstant::kVerticalTabStripCollapsedVerticalPadding),
+            0));
+    const std::optional<size_t> separator_index =
+        GetIndexOf(top_button_separator_);
+    CHECK(separator_index.has_value());
+    ReorderChildView(ahoi_sidebar_tree_view_, *separator_index + 1);
+  }
+
+  if (tab_strip_view_) {
+    tab_strip_view_->SetVisible(!ahoi_sidebar_tree_view_);
+  }
+  GetViewAccessibility().SetRole(ahoi_sidebar_tree_view_
+                                     ? ax::mojom::Role::kGenericContainer
+                                     : ax::mojom::Role::kTabList);
+  InvalidateLayout();
+  return previous;
+}
