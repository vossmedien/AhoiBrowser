+  DropIndicator indicator = *drop_indicator_;
+  last_drop_probe_.reset();
+  SetDropIndicator(std::nullopt);
+  return base::BindOnce(&SidebarTreeView::PerformDrop,
+                        weak_ptr_factory_.GetWeakPtr(), std::move(indicator));
+}
