diff --git a/components/performance_manager/freezing/freezing_policy_unittest.cc b/components/performance_manager/freezing/freezing_policy_unittest.cc
index 2ce7d53fc1fc0ee37f03fe2efbef196b9810a256..fafa25aeb604ff04ecada781ab463c8d88a83ed0 100644
--- a/components/performance_manager/freezing/freezing_policy_unittest.cc
+++ b/components/performance_manager/freezing/freezing_policy_unittest.cc
@@ -1032,6 +1032,57 @@ TEST_F(FreezingPolicyTest, StartsUsingWebRTCWhenFrozen) {
   VerifyFreezerExpectations();
 }
 
+// Ahoi: a page showing a Picture-in-Picture window is not frozen.
+TEST_F(FreezingPolicyTest, FreezeVoteWhenPictureInPicture) {
+  page_node()->SetHasPictureInPicture(true);
+
+  // Don't expect freezing.
+  policy()->AddFreezeVote(page_node());
+  VerifyFreezerExpectations();
+  ExpectCannotFreezeReasons(page_node(), FreezingType::kVoting,
+                            ElementsAre(CannotFreezeReason::kPictureInPicture));
+
+  // Expect freezing after leaving Picture-in-Picture.
+  EXPECT_CALL(*freezer(), MaybeFreezePageNode(page_node()));
+  page_node()->SetHasPictureInPicture(false);
+  VerifyFreezerExpectations();
+}
+
+TEST_F(FreezingPolicyTest, EntersPictureInPictureWhenFrozen) {
+  EXPECT_CALL(*freezer(), MaybeFreezePageNode(page_node()));
+  policy()->AddFreezeVote(page_node());
+  VerifyFreezerExpectations();
+
+  EXPECT_CALL(*freezer(), UnfreezePageNode(page_node()));
+  page_node()->SetHasPictureInPicture(true);
+  VerifyFreezerExpectations();
+}
+
+// Ahoi: a page created while it already shows a Picture-in-Picture window
+// starts with the matching `CannotFreezeReason`.
+TEST_F(FreezingPolicyTest, InitiallyPictureInPicture) {
+  auto pip_page = CreateNode<PageNodeImpl>(
+      /*web_contents=*/nullptr,
+      /*browsing_context_id=*/base::UnguessableToken(), GURL(),
+      PagePropertyFlags{PagePropertyFlag::kHasPictureInPicture});
+  EXPECT_TRUE(pip_page->HasPictureInPicture());
+  pip_page->SetType(PageType::kTab);
+  auto pip_frame =
+      CreateFrameNodeAutoId(process_node(), pip_page.get(),
+                            /* parent_frame_node=*/nullptr, kBrowsingInstanceB);
+
+  // Don't expect freezing.
+  policy()->AddFreezeVote(pip_page.get());
+  VerifyFreezerExpectations();
+  ExpectCannotFreezeReasons(pip_page.get(), FreezingType::kVoting,
+                            ElementsAre(CannotFreezeReason::kPictureInPicture));
+
+  // Expect freezing after leaving Picture-in-Picture.
+  EXPECT_CALL(*freezer(), MaybeFreezePageNode(pip_page.get()));
+  pip_page->SetHasPictureInPicture(false);
+  VerifyFreezerExpectations();
+}
+
 TEST_F(FreezingPolicyTest, FreezeVoteWithNotificationPermission) {
