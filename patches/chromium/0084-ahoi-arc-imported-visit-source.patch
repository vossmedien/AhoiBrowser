+bool HistoryBackend::CommitForAhoiImport() {
+  if (!db_ || !singleton_transaction_ || !db_->HasActiveTransactions()) {
+    return false;
+  }
+  CancelScheduledCommit();
+  const bool committed = singleton_transaction_->Commit();
+  singleton_transaction_.reset();
+  BeginSingletonTransaction();
+  return committed && singleton_transaction_ != nullptr;
+}
