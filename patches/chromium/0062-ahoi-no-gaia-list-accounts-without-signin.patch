+  // to reconcile, so the cookie jar is never listed against Gaia (fresh-
+  // profile network audit). Callers keep the cached, not-fresh result.
+  PrefService* const prefs = signin_client_->GetPrefs();
+  if (prefs && prefs->FindPreference(prefs::kSigninAllowed) &&
+      !prefs->GetBoolean(prefs::kSigninAllowed)) {
+    return;
+  }
