+
+    fallback_icon_ = AddChildView(std::make_unique<views::Label>(u"▢"));
+    fallback_icon_->SetEnabledColor(visual_style::kMutedText);
+    fallback_icon_->SetVisible(favicon_view_->GetImageModel().IsEmpty());
+    fallback_icon_->GetViewAccessibility().SetIsIgnored(true);
+
+    title_ = AddChildView(std::make_unique<views::Label>(tab_title));
+    title_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    title_->SetElideBehavior(gfx::ELIDE_TAIL);
+    title_->SetEnabledColor(visual_style::kText);
+    title_->SetCanProcessEventsWithinSubtree(false);
+    title_->GetViewAccessibility().SetIsIgnored(true);
+
+    close_ = AddChildView(std::make_unique<views::Label>(u"×"));
+    close_->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    close_->SetEnabledColor(visual_style::kMutedText);
+    close_->SetCanProcessEventsWithinSubtree(false);
+    close_->GetViewAccessibility().SetIsIgnored(true);
+    close_->SetVisible(false);
+
+    GetViewAccessibility().SetRole(ax::mojom::Role::kTab);
+    GetViewAccessibility().SetName(tab_title);
+    GetViewAccessibility().SetIsSelected(active_);
+    UpdateBackground();
+  }
+
+  OpenTabRowView(const OpenTabRowView&) = delete;
+  OpenTabRowView& operator=(const OpenTabRowView&) = delete;
+  ~OpenTabRowView() override {
+    set_drag_controller(nullptr);
+    set_context_menu_controller(nullptr);
+  }
+
+  base::WeakPtr<tabs::TabInterface> tab() const { return tab_; }
+
+  void Layout(PassKey) override {
+    const gfx::Rect icon_bounds(8, 8, 16, 16);
+    favicon_view_->SetBoundsRect(icon_bounds);
+    fallback_icon_->SetBoundsRect(icon_bounds);
+    const gfx::Rect close_bounds = CloseBounds();
+    close_->SetBoundsRect(close_bounds);
+    title_->SetBounds(30, 0, std::max(0, width() - 62), height());
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override {
+    if (!event.IsOnlyLeftMouseButton()) {
+      return false;
+    }
+    close_pressed_ = CloseBounds().Contains(event.location());
+    return true;
+  }
+
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    if (!event.IsLeftMouseButton()) {
+      close_pressed_ = false;
+      return;
+    }
+    const bool close =
+        close_pressed_ && CloseBounds().Contains(event.location());
+    close_pressed_ = false;
+    PostCallback(close ? close_callback_ : activate_callback_);
+  }
+
+  void OnMouseEntered(const ui::MouseEvent&) override {
+    hovered_ = true;
+    close_->SetVisible(true);
+    UpdateBackground();
+  }
+
+  void OnMouseExited(const ui::MouseEvent&) override {
+    hovered_ = false;
+    close_pressed_ = false;
+    close_->SetVisible(false);
+    UpdateBackground();
+  }
+
+  bool OnKeyPressed(const ui::KeyEvent& event) override {
+    if (event.key_code() == ui::VKEY_RETURN) {
+      PostCallback(activate_callback_);
+      return true;
+    }
+    if (event.key_code() == ui::VKEY_BACK ||
+        event.key_code() == ui::VKEY_DELETE) {
+      PostCallback(close_callback_);
+      return true;
+    }
+    return false;
+  }
+
+  void OnDragDone() override {
+    dragging_ = false;
+    drag_state_callback_.Run(std::nullopt);
+    UpdateBackground();
+    views::View::OnDragDone();
+  }
+
+  // views::DragController:
+  void WriteDragDataForView(views::View* sender,
+                            const gfx::Point& press_pt,
+                            ui::OSExchangeData* data) override {
+    CHECK_EQ(sender, this);
+    if (!tab_) {
+      return;
+    }
+    const gfx::ImageSkia image = GetDragImage();
+    if (!image.isNull() && !image.size().IsEmpty()) {
+      data->provider().SetDragImage(
+          image,
+          gfx::Vector2d(
+              std::clamp(press_pt.x(), 0, std::max(image.width() - 1, 0)),
+              std::clamp(press_pt.y(), 0, std::max(image.height() - 1, 0))));
+    }
+    base::Pickle pickle;
+    pickle.WriteInt(tab_->GetHandle().raw_value());
+    data->SetPickledData(SidebarTreeView::RuntimeTabDragFormat(), pickle);
+    dragging_ = true;
+    UpdateBackground();
+  }
+
+  int GetDragOperationsForView(views::View*, const gfx::Point&) override {
+    return ui::DragDropTypes::DRAG_MOVE;
+  }
+
+  bool CanStartDragForView(views::View* sender,
+                           const gfx::Point& press_pt,
+                           const gfx::Point&) override {
+    return sender == this && tab_ && !CloseBounds().Contains(press_pt);
+  }
+
+  void OnWillStartDragForView(views::View* dragged_view) override {
+    if (dragged_view == this && tab_) {
+      drag_state_callback_.Run(tab_->GetHandle().raw_value());
+    }
+  }
+
+ private:
+  gfx::ImageSkia GetDragImage() {
+    if (!GetWidget() || !GetColorProvider()) {
+      SkBitmap fallback;
+      fallback.allocN32Pixels(1, 1);
+      fallback.eraseColor(SK_ColorTRANSPARENT);
+      return gfx::ImageSkia::CreateFrom1xBitmap(fallback);
+    }
+    constexpr int kPreviewWidth = 196;
+    const gfx::Rect original_bounds = bounds();
+    SetBoundsRect(gfx::Rect(
+        0, 0, std::min(std::max(original_bounds.width(), 1), kPreviewWidth),
+        SidebarTreeRowView::kRowHeight));
+    DeprecatedLayoutImmediately();
+    SkBitmap bitmap;
+    const float raster_scale = views::ScaleFactorForDragFromWidget(GetWidget());
+    Paint(views::PaintInfo::CreateRootPaintInfo(
+        ui::CanvasPainter(&bitmap, size(), raster_scale, SK_ColorTRANSPARENT,
+                          /*is_pixel_canvas=*/true)
+            .context(),
+        size()));
+    SetBoundsRect(original_bounds);
+    DeprecatedLayoutImmediately();
+    return gfx::ImageSkia::CreateFromBitmap(bitmap, raster_scale);
+  }
+
+  gfx::Rect CloseBounds() const {
+    return gfx::Rect(std::max(0, width() - 28), 4, 24,
+                     SidebarTreeRowView::kRowHeight - 8);
+  }
+
+  void PostCallback(const TabCallback& callback) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(callback, tab_));
+  }
+
+  void UpdateBackground() {
+    SetBackground(dragging_  ? nullptr
+                  : active_  ? views::CreateRoundedRectBackground(
+                                   visual_style::kSelectedSurface,
+                                   visual_style::kRowCornerRadius)
+                  : hovered_ ? views::CreateRoundedRectBackground(
+                                   ui::kColorSysStateHoverOnSubtle,
+                                   visual_style::kRowCornerRadius)
+                             : nullptr);
+    SchedulePaint();
+  }
+
+  const base::WeakPtr<tabs::TabInterface> tab_;
+  const TabCallback activate_callback_;
+  const TabCallback close_callback_;
+  const DragStateCallback drag_state_callback_;
+  raw_ptr<views::ImageView> favicon_view_ = nullptr;
+  raw_ptr<views::Label> fallback_icon_ = nullptr;
+  raw_ptr<views::Label> title_ = nullptr;
+  raw_ptr<views::Label> close_ = nullptr;
+  const bool active_;
+  bool hovered_ = false;
+  bool close_pressed_ = false;
+  bool dragging_ = false;
+};
