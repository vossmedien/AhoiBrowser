diff --git a/chrome/browser/ui/browser_command_controller.cc b/chrome/browser/ui/browser_command_controller.cc
index 99101ebc5729963e7fa3761e11f7ebfdb8ac84f1..70270d303073ca5736a6ccb241dd8a00447a8d1d 100644
--- a/chrome/browser/ui/browser_command_controller.cc
+++ b/chrome/browser/ui/browser_command_controller.cc
@@ -646,7 +646,28 @@ bool BrowserCommandController::ExecuteCommandWithDispositionAndContext(
   // crashes, e.g. from Windows sending WM_COMMANDs at random times during
   // window construction.  This probably could use closer examination someday.
   if (browser_->tab_strip_model()->active_index() == TabStripModel::kNoTab) {
-    return true;
+    // Ahoi keeps normal windows alive with no selected tab. Only commands
+    // whose implementations own a window/profile (not a page) can run here.
+    // Preserve Chromium's construction guard for other window types.
+    if (browser_->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL ||
+        !browser_->GetWindow()) {
+      return true;
+    }
+    switch (id) {
+      case IDC_NEW_TAB:
+      case IDC_NEW_WINDOW:
+      case IDC_NEW_INCOGNITO_WINDOW:
+      case IDC_NEW_SPLIT_TAB:
+      case IDC_OPTIONS:
+      case IDC_IMPORT_SETTINGS:
+      case IDC_SHOW_HISTORY:
+      case IDC_SHOW_DOWNLOADS:
+      case IDC_SHOW_BOOKMARK_MANAGER:
+      case IDC_MANAGE_EXTENSIONS:
+        break;
+      default:
+        return true;
+    }
   }
 
   DCHECK(IsCommandEnabled(id)) << "Invalid/disabled command " << id;
diff --git a/chrome/browser/ui/cocoa/confirm_quit.cc b/chrome/browser/ui/cocoa/confirm_quit.cc
index e28f7554e2783428124eb4a0f65763572b56c078..f14e096068b55d30a178a4c550602972a93b7c62 100644
--- a/chrome/browser/ui/cocoa/confirm_quit.cc
+++ b/chrome/browser/ui/cocoa/confirm_quit.cc
@@ -15,7 +15,9 @@ void RecordHistogram(ConfirmQuitMetric sample) {
 }
 
 void RegisterLocalState(PrefRegistrySimple* registry) {
-  registry->RegisterBooleanPref(prefs::kConfirmToQuitEnabled, true);
+  // Ahoi follows the normal macOS short-Command-Q convention. This changes
+  // only the default; an explicitly stored hold-to-quit choice is preserved.
+  registry->RegisterBooleanPref(prefs::kConfirmToQuitEnabled, false);
 }
 
 }  // namespace confirm_quit
