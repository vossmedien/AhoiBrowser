+}
+
+void StorageFrontend::OnSettingsChangedWithOrigin(
+    SyncSettingsChangeOrigin origin,
+    const ExtensionId& extension_id,
+    StorageAreaNamespace storage_area,
+    std::optional<api::storage::AccessLevel> access_level,
+    base::Value changes) {
   DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (origin == SyncSettingsChangeOrigin::kRemoteApply &&
+      storage_area != StorageAreaNamespace::kSync) {
+    return;
+  }
   TRACE_EVENT1("browser", "SettingsObserver:OnSettingsChanged", "extension_id",
                extension_id);
 
@@ -658,8 +685,21 @@ void StorageFrontend::OnSettingsChanged(
                 std::size(extension_id_str));
   base::debug::Alias(extension_id_str);
 
+  if (storage_area == StorageAreaNamespace::kSync && changes.is_dict() &&
+      !changes.GetDict().empty()) {
+    const auto weak_this = weak_factory_.GetWeakPtr();
+    const auto observers = sync_settings_observers_;
+    observers->Notify(extension_id, changes.GetDict(), origin);
+    if (!weak_this) {
+      return;
+    }
+  }
+
   const std::string namespace_string = StorageAreaToString(storage_area);
   EventRouter* event_router = EventRouter::Get(browser_context_);
+  if (!event_router) {
+    return;
+  }
 
   bool has_event_changed_listener = event_router->ExtensionHasEventListener(
       extension_id, api::storage::OnChanged::kEventName);
