+base::CallbackListSubscription StorageFrontend::ObserveSyncSettingsChanges(
+    SyncSettingsChangedCallback callback) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  return sync_settings_observers_->Add(std::move(callback));
+}
+
+SettingsChangedCallback StorageFrontend::GetRemoteSyncApplyObserver() {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  return base::BindRepeating(&StorageFrontend::OnSettingsChangedWithOrigin,
+                             weak_factory_.GetWeakPtr(),
+                             SyncSettingsChangeOrigin::kRemoteApply);
+}
