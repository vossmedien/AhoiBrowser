+// Ahoi: one tab strip backs every Workspace of a window, so strip order would
+// step into another Workspace. Windows with the native Ahoi sidebar follow its
+// tab stops of the active Workspace instead; the others keep strip order.
+views::View* GetAhoiSidebarHost(BrowserWindowInterface* browser) {
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser);
+  return browser_view ? browser_view->GetAhoiSidebarHost() : nullptr;
+}
+
+void ActivateAhoiSidebarTab(BrowserWindowInterface* browser,
+                            base::WeakPtr<tabs::TabInterface> target,
+                            TabStripUserGestureDetails gesture_detail) {
+  TabStripModel* const model = browser->GetTabStripModel();
+  if (target && model->GetIndexOfTab(target.get()) != TabStripModel::kNoTab) {
+    model->ActivateTab(target.get(), gesture_detail);
+  }
+}
+
+bool SelectAhoiRelativeTab(BrowserWindowInterface* browser,
+                           int delta,
+                           TabStripUserGestureDetails gesture_detail) {
+  base::WeakPtr<tabs::TabInterface> target;
+  if (!ahoi::sidebar::ResolveBrowserSidebarTabStep(GetAhoiSidebarHost(browser),
+                                                   delta, &target)) {
+    return false;
+  }
+  ActivateAhoiSidebarTab(browser, std::move(target), gesture_detail);
+  return true;
+}
+
+bool SelectAhoiNumberedTab(BrowserWindowInterface* browser,
+                           std::optional<size_t> index,
+                           TabStripUserGestureDetails gesture_detail) {
+  base::WeakPtr<tabs::TabInterface> target;
+  if (!ahoi::sidebar::ResolveBrowserSidebarNumberedTab(
+          GetAhoiSidebarHost(browser), index, &target)) {
+    return false;
+  }
+  ActivateAhoiSidebarTab(browser, std::move(target), gesture_detail);
+  return true;
+}
+
+}  // namespace
+
 void SelectNextTab(BrowserWindowInterface* browser,
                    TabStripUserGestureDetails gesture_detail) {
   base::RecordAction(UserMetricsAction("SelectNextTab"));
+  if (SelectAhoiRelativeTab(browser, 1, gesture_detail)) {
+    return;
+  }
   browser->GetTabStripModel()->SelectNextTab(gesture_detail);
 }
 
 void SelectPreviousTab(BrowserWindowInterface* browser,
                        TabStripUserGestureDetails gesture_detail) {
   base::RecordAction(UserMetricsAction("SelectPrevTab"));
+  if (SelectAhoiRelativeTab(browser, -1, gesture_detail)) {
+    return;
+  }
   browser->GetTabStripModel()->SelectPreviousTab(gesture_detail);
 }
 
