+IN_PROC_BROWSER_TEST_P(ExtensionContextMenuModelWithUserHostControlsTest,
+                       EmptyTabListKeepsGenericContextMenuSafe) {
+  const Extension* extension =
+      AddExtensionWithHostPermission("extension", manifest_keys::kBrowserAction,
+                                     ManifestLocation::kInternal, "<all_urls>");
+  ToolbarActionsModel* const toolbar_model =
+      ToolbarActionsModel::Get(profile());
+  ASSERT_TRUE(toolbar_model);
+  toolbar_model->SetActionVisibility(extension->id(), true);
+  ASSERT_TRUE(toolbar_model->IsActionPinned(extension->id()));
+
+  ASSERT_EQ(1, browser()->tab_strip_model()->count());
+  browser()->tab_strip_model()->DetachAndDeleteWebContentsAt(0);
+  ASSERT_EQ(0, browser()->tab_strip_model()->count());
+  ASSERT_EQ(nullptr, GetActiveWebContents());
+
+  ExtensionContextMenuModel menu(
+      extension, browser_window_interface(), /*is_pinned=*/true, nullptr,
+      /*can_show_icon_in_toolbar=*/true, ContextMenuSource::kMenuItem);
+
+  EXPECT_EQ(GetCommandState(menu, ExtensionContextMenuModel::MANAGE_EXTENSIONS),
+            CommandState::kEnabled);
+  EXPECT_EQ(GetCommandState(menu, kPageAccessSubmenu), CommandState::kAbsent);
+  EXPECT_EQ(GetCommandState(menu, kPermissionsPage), CommandState::kAbsent);
+  EXPECT_EQ(GetCommandState(
+                menu, ExtensionContextMenuModel::TOGGLE_SIDE_PANEL_VISIBILITY),
+            CommandState::kAbsent);
+  EXPECT_EQ(nullptr, menu.page_access_submenu_for_testing());
+
+  // The redesigned menu exposes pinning from a menu entry. The legacy menu
+  // keeps that command on toolbar-action context menus only.
+  const CommandState pin_state =
+      GetCommandState(menu, ExtensionContextMenuModel::TOGGLE_VISIBILITY);
+  if (GetParam()) {
+    EXPECT_EQ(pin_state, CommandState::kEnabled);
+    menu.ExecuteCommand(ExtensionContextMenuModel::TOGGLE_VISIBILITY, 0);
+    EXPECT_FALSE(toolbar_model->IsActionPinned(extension->id()));
+
+    ExtensionContextMenuModel repin_menu(
+        extension, browser_window_interface(), /*is_pinned=*/false, nullptr,
+        /*can_show_icon_in_toolbar=*/true, ContextMenuSource::kMenuItem);
+    repin_menu.ExecuteCommand(ExtensionContextMenuModel::TOGGLE_VISIBILITY, 0);
+    EXPECT_TRUE(toolbar_model->IsActionPinned(extension->id()));
+  } else {
+    EXPECT_EQ(pin_state, CommandState::kAbsent);
+  }
+}
