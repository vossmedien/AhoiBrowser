+  const bool was_visible =
+      multi_contents_view_->IsAhoiEmptyStateVisibleForTesting();
+  multi_contents_view_->SetAhoiEmptyStateVisible(visible);
+
+  // Switching back to a workspace whose tab is already the global active tab
+  // does not emit an active-tab notification. The empty surface deliberately
+  // detached stale WebContents from every pane, so restore that active tab
+  // here before hiding the native surface. The normal split reconciliation
+  // then restores a persisted split without manufacturing a new tab.
+  if (!visible && was_visible && browser_ && browser_->tab_strip_model()) {
+    content::WebContents* active_contents =
+        browser_->tab_strip_model()->GetActiveWebContents();
+    if (active_contents) {
+      multi_contents_view_->SetWebContentsAtIndex(active_contents, 0);
+      UpdateUIForContents(active_contents, /*should_layout_immediately=*/false);
+    }
+  }
+}
