+    tab_tree::TabTreeSnapshot* snapshot) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return snapshot && tab_tree_ready_ && !shutting_down_ && tab_tree_store_ &&
