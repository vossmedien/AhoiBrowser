+    auto it = third_party_cookie_blocking_overrides_.find(
+        top_frame_origin->Serialize());
+    if (it != third_party_cookie_blocking_overrides_.end()) {
+      return block_third_party_cookies_ || it->second;
+    }
+  }
+  return block_third_party_cookies_ ||
+         third_party_cookie_blocking_override_.value_or(false);
+}
+
+void CookieSettings::SetThirdPartyCookieBlockingPolicy(
+    std::optional<bool> global_override,
+    base::flat_map<std::string, bool> top_frame_overrides) {
+  DCHECK(thread_checker_.CalledOnValidThread());
+
+  bool old_effective_block_third_party_cookies;
+  bool new_effective_block_third_party_cookies;
+  {
+    base::AutoLock auto_lock(lock_);
+    old_effective_block_third_party_cookies =
+        block_third_party_cookies_ ||
+        third_party_cookie_blocking_override_.value_or(false);
+    third_party_cookie_blocking_override_ = global_override;
+    third_party_cookie_blocking_overrides_ = std::move(top_frame_overrides);
+    new_effective_block_third_party_cookies =
+        block_third_party_cookies_ ||
+        third_party_cookie_blocking_override_.value_or(false);
+  }
+
+  if (old_effective_block_third_party_cookies ==
+      new_effective_block_third_party_cookies) {
+    return;
+  }
+  for (Observer& obs : observers_) {
+    obs.OnThirdPartyCookieBlockingChanged(
+        new_effective_block_third_party_cookies);
+  }
 }
 
