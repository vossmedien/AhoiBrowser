+      ahoi_cookie_button_->GetEnabled()) {
+    ahoi::DeveloperToolkitController::ConfigureToolbarAnchor(
+        ahoi_cookie_button_, ahoi::DeveloperToolbarSurface::kCookieManager);
+    browser_view->ShowAhoiDeveloperToolkit(ahoi_cookie_button_);
+  }
+}
+
+void LocationBarView::ClearAhoiSiteCache(const ui::Event&) {
+  BrowserView* const browser_view =
+      browser_ ? BrowserView::GetBrowserViewForBrowser(browser_) : nullptr;
+  if (browser_view && ahoi_cache_button_ && ahoi_cache_button_->GetEnabled()) {
+    ahoi::DeveloperToolkitController::ConfigureToolbarAnchor(
+        ahoi_cache_button_, ahoi::DeveloperToolbarSurface::kCacheClear);
+    browser_view->ShowAhoiDeveloperToolkit(ahoi_cache_button_);
+  }
