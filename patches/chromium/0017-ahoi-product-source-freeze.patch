+      {2}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kToolbarButton);
+  const std::vector<tabs::TabInterface*> panes =
+      tabstrip()->GetSplitData(split_id)->ListTabs();
+  ASSERT_EQ(2u, panes.size());
+
+  tabs::TabInterface* const remaining_pane = panes.front();
+  tabs::TabInterface* const last_pane = panes.back();
+  tabstrip()->ActivateTabAt(tabstrip()->GetIndexOfTab(last_pane));
+  tabstrip()->CloseWebContentsAt(tabstrip()->GetIndexOfTab(last_pane),
+                                 TabCloseTypes::CLOSE_NONE);
+
+  EXPECT_FALSE(tabstrip()->ContainsSplit(split_id));
+  EXPECT_EQ(remaining_pane, tabstrip()->GetActiveTab());
+  EXPECT_FALSE(remaining_pane->IsSplit());
+}
+
+TEST_F(TabStripModelTest,
+       ClosingFirstPaneOfTwoPaneSplitDoesNotSelectFollowingBackgroundTab) {
+  PrepareTabs(tabstrip(), 4);
+  tabstrip()->ActivateTabAt(1);
+  const split_tabs::SplitTabId split_id = tabstrip()->AddToNewSplit(
+      {2}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kToolbarButton);
+  const std::vector<tabs::TabInterface*> panes =
+      tabstrip()->GetSplitData(split_id)->ListTabs();
+  ASSERT_EQ(2u, panes.size());
+  tabs::TabInterface* const closing_pane = panes.front();
+  tabs::TabInterface* const remaining_pane = panes.back();
+
+  tabstrip()->ActivateTabAt(tabstrip()->GetIndexOfTab(closing_pane));
+  tabstrip()->CloseWebContentsAt(tabstrip()->GetIndexOfTab(closing_pane),
+                                 TabCloseTypes::CLOSE_NONE);
+
+  EXPECT_FALSE(tabstrip()->ContainsSplit(split_id));
+  EXPECT_EQ(remaining_pane, tabstrip()->GetActiveTab());
+  EXPECT_FALSE(remaining_pane->IsSplit());
+}
+
+TEST_F(TabStripModelTest, ReorderFourPaneThenCloseFirstPaneAndUnsplit) {
+  PrepareTabstripForSelectionTest(tabstrip(), 5, 0, {0});
+  const split_tabs::SplitTabId split_id = tabstrip()->AddToNewSplit(
+      {1, 2, 3},
+      split_tabs::SplitTabVisualData::ForFourPane(
+          split_tabs::SplitTabLayout::kSideBySide),
+      split_tabs::SplitTabCreatedSource::kToolbarButton);
+  std::vector<tabs::TabInterface*> panes =
+      tabstrip()->GetSplitData(split_id)->ListTabs();
+  ASSERT_EQ(4u, panes.size());
+
+  EXPECT_TRUE(tabstrip()->ReorderTabInSplit(panes.front(), panes[2]));
+  panes = tabstrip()->GetSplitData(split_id)->ListTabs();
+  tabs::TabInterface* const first_after_reorder = panes.front();
+  tabstrip()->CloseWebContentsAt(tabstrip()->GetIndexOfTab(first_after_reorder),
+                                 TabCloseTypes::CLOSE_NONE);
+
+  ASSERT_TRUE(tabstrip()->ContainsSplit(split_id));
+  EXPECT_EQ(3u, tabstrip()->GetSplitData(split_id)->ListTabs().size());
+  tabstrip()->RemoveSplit(split_id);
+  EXPECT_FALSE(tabstrip()->ContainsSplit(split_id));
+}
+
+TEST_F(TabStripModelTest, ReorderTabInSplitRejectsSamePaneAndCrossSplit) {
+  PrepareTabs(tabstrip(), 4);
+  tabstrip()->ActivateTabAt(0);
+  const split_tabs::SplitTabId first_split = tabstrip()->AddToNewSplit(
+      {1}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kToolbarButton);
+  tabstrip()->ActivateTabAt(2);
+  const split_tabs::SplitTabId second_split = tabstrip()->AddToNewSplit(
+      {3}, split_tabs::SplitTabVisualData(),
+      split_tabs::SplitTabCreatedSource::kToolbarButton);
+  tabs::TabInterface* const first_source =
+      tabstrip()->GetSplitData(first_split)->ListTabs().front();
+  tabs::TabInterface* const second_target =
+      tabstrip()->GetSplitData(second_split)->ListTabs().front();
+
+  EXPECT_FALSE(tabstrip()->ReorderTabInSplit(first_source, first_source));
+  EXPECT_FALSE(tabstrip()->ReorderTabInSplit(first_source, second_target));
+  EXPECT_EQ(first_source,
+            tabstrip()->GetSplitData(first_split)->ListTabs().front());
+  EXPECT_EQ(second_target,
+            tabstrip()->GetSplitData(second_split)->ListTabs().front());
+}
