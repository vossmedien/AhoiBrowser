+TEST_F(PointerLockControllerTest, PointerLockSuppressesMiddleClickAutoscroll) {
+  ScopedMiddleClickAutoscrollForTest middle_click_autoscroll(true);
+  GetDocument().GetSettings()->SetMiddleClickAutoscrollEnabled(true);
+  GetDocument().body()->SetInnerHTMLWithoutTrustedTypes(R"HTML(
+    <div id="scrollable" style="width: 10px; height: 10px; overflow: auto">
+      <div style="width: 100px; height: 100px"></div>
+    </div>
+  )HTML");
+  Compositor().BeginFrame();
+
+  Element* scrollable =
+      GetDocument().getElementById(AtomicString("scrollable"));
+  ASSERT_TRUE(scrollable);
+  auto dispatch_middle_mousedown = [&]() {
+    MouseEventInit* initializer = MouseEventInit::Create();
+    initializer->setButton(
+        static_cast<int16_t>(WebPointerProperties::Button::kMiddle));
+    MouseEvent* event =
+        MouseEvent::Create(nullptr, event_type_names::kMousedown, initializer);
+    event->SetTarget(scrollable);
+    scrollable->DefaultEventHandler(*event);
+  };
+
+  AutoscrollController& autoscroll =
+      GetDocument().GetPage()->GetAutoscrollController();
+  dispatch_middle_mousedown();
+  ASSERT_TRUE(autoscroll.MiddleClickAutoscrollInProgress());
+  autoscroll.StopMiddleClickAutoscroll(GetDocument().GetFrame());
+
+  ScriptState* script_state = ToScriptStateForMainWorld(Window().GetFrame());
+  ScriptState::Scope scope(script_state);
+  auto* resolver =
+      MakeGarbageCollected<ScriptPromiseResolver<IDLUndefined>>(script_state);
+  PointerLockController().RequestPointerLock(resolver, scrollable, nullptr);
+  ASSERT_TRUE(PointerLockController().LockPending());
+
+  dispatch_middle_mousedown();
+  EXPECT_FALSE(autoscroll.MiddleClickAutoscrollInProgress());
+
+  SimulateLockRequestResult(mojom::blink::PointerLockResult::kSuccess);
+  PointerLockController().DidAcquirePointerLock();
+  ASSERT_EQ(scrollable, PointerLockController().GetElement());
+
+  dispatch_middle_mousedown();
+  EXPECT_FALSE(autoscroll.MiddleClickAutoscrollInProgress());
+}
