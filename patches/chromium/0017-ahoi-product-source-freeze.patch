+views::View::DropCallback BrowserView::GetDropCallback(
+    const ui::DropTargetEvent& event) {
+  if (!ahoi_split_drop_controller_ ||
+      !ahoi_split_drop_controller_->CanDrop(event.data())) {
+    return base::DoNothing();
+  }
+  return base::BindOnce(
+      [](base::WeakPtr<BrowserView> browser_view,
+         const ui::DropTargetEvent& drop_event,
+         ui::mojom::DragOperation& output_drag_op,
+         std::unique_ptr<ui::LayerTreeOwner> /*drag_image_layer_owner*/) {
+        if (!browser_view || !browser_view->ahoi_split_drop_controller_ ||
+            !browser_view->multi_contents_view_) {
+          output_drag_op = ui::mojom::DragOperation::kNone;
+          return;
+        }
+        const bool did_drop =
+            browser_view->ahoi_split_drop_controller_->PerformDrop(
+                drop_event.data(),
+                GetAhoiSplitDropPoint(browser_view.get(),
+                                      browser_view->multi_contents_view_,
+                                      drop_event),
+                GetAhoiSplitDropPanes(browser_view->multi_contents_view_));
+        output_drag_op = did_drop ? ui::mojom::DragOperation::kMove
+                                  : ui::mojom::DragOperation::kNone;
+      },
+      weak_ptr_factory_.GetWeakPtr());
 }
 
