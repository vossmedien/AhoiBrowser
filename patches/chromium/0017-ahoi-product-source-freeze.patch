+void MultiContentsView::SetAhoiEmptyStateVisible(bool visible) {
+  if (!ahoi_empty_state_view_) {
+    return;
+  }
+
+  const bool visibility_changed =
+      ahoi_empty_state_view_->GetVisible() != visible;
