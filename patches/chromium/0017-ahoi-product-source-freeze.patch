+  content::WebContents* const contents = GetWebContents();
+  const GURL url = contents ? contents->GetLastCommittedURL() : GURL();
+  const bool supported = url.is_valid() && url.SchemeIsHTTPOrHTTPS();
+  const bool compatible =
+      supported && ahoi::privacy::GetModeForUrl(*profile_->GetPrefs(), url,
+                                                profile_->IsOffTheRecord()) ==
+                       ahoi::privacy::PrivacyMode::kChromiumCompatible;
+  const ui::ColorId icon_color =
+      compatible ? ahoi::visual_style::kAccent : kColorOmniboxActionIcon;
+  ahoi_privacy_button_->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(vector_icons::kShieldIcon, icon_color,
+                                     18));
+  ahoi_privacy_button_->SetEnabled(supported);
+  const std::u16string tooltip = l10n_util::GetStringUTF16(
+      compatible ? IDS_AHOI_PRIVACY_BUTTON_COMPATIBLE_TOOLTIP
+                 : IDS_AHOI_PRIVACY_BUTTON_TOOLTIP);
+  ahoi_privacy_button_->SetTooltipText(tooltip);
+  ahoi_privacy_button_->SetAccessibleName(tooltip);
+}
+
+void LocationBarView::ShowAhoiSiteData(const ui::Event&) {
+  BrowserView* const browser_view =
