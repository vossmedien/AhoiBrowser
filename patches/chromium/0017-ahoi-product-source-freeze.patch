+  controller.StartMiddleClickAutoscroll(frame, scrollable, gfx::PointF(),
+                                        gfx::PointF());
+  controller.HandleMouseMoveForMiddleClickAutoscroll(
+      frame, gfx::PointF(500.0f, 500.0f), /*is_middle_button=*/false);
+  const gfx::Vector2dF ordinary_velocity = controller.last_velocity_;
+  controller.StopMiddleClickAutoscroll(frame);
+
+  GetDocument().GetSettings()->SetPrefersReducedMotion(true);
+  controller.StartMiddleClickAutoscroll(frame, scrollable, gfx::PointF(),
+                                        gfx::PointF());
+  controller.HandleMouseMoveForMiddleClickAutoscroll(
+      frame, gfx::PointF(500.0f, 500.0f), /*is_middle_button=*/false);
+  const gfx::Vector2dF reduced_velocity = controller.last_velocity_;
+
+  EXPECT_GT(std::abs(ordinary_velocity.x()), 0.12f);
+  EXPECT_GT(std::abs(ordinary_velocity.y()), 0.12f);
+  EXPECT_FLOAT_EQ(std::abs(reduced_velocity.x()), 0.12f);
+  EXPECT_FLOAT_EQ(std::abs(reduced_velocity.y()), 0.12f);
+}
