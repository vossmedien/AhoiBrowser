+#ifndef AHOI_BROWSER_UI_SIDEBAR_SIDEBAR_TREE_CONTROLLER_H_
+#define AHOI_BROWSER_UI_SIDEBAR_SIDEBAR_TREE_CONTROLLER_H_
+
+#include <cstddef>
+#include <optional>
+#include <string>
+#include <vector>
+
+#include "ahoi/browser/tab_tree/tab_tree_observer.h"
