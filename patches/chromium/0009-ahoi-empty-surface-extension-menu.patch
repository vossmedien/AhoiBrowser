+#if !BUILDFLAG(IS_ANDROID)
+// Ahoi deliberately supports a live browser window without an active tab.
+// The extensions menu remains useful for managing installed extensions in
+// that state, but every site-bound control must be hidden or disabled.
+IN_PROC_BROWSER_TEST_F(ExtensionsMenuViewModelBrowserTest,
+                       EmptyTabListReturnsGenericExtensionState) {
+  auto extension =
+      AddExtensionWithHostPermission("Extension", "<all_urls>");
+  const GURL url =
+      embedded_test_server()->GetURL("example.com", "/simple.html");
+  ASSERT_TRUE(NavigateToURL(GetActiveWebContents(), url));
+  const url::Origin origin = url::Origin::Create(url);
+  const auto site_access_before =
+      permissions_manager()->GetUserSiteAccess(*extension, url);
+  const auto site_setting_before =
+      permissions_manager()->GetUserSiteSetting(origin);
+  base::UserActionTester user_action_tester;
+  constexpr char kActivatedUserAction[] =
+      "Extensions.Toolbar.ExtensionActivatedFromMenu";
+
+  ASSERT_EQ(1, browser()->tab_strip_model()->count());
+
+  browser()->tab_strip_model()->DetachAndDeleteWebContentsAt(0);
+
+  ASSERT_EQ(0, browser()->tab_strip_model()->count());
+  ASSERT_EQ(nullptr, menu_model()->GetActiveWebContents());
+  EXPECT_EQ(menu_model()->GetOptionalSection(),
+            ExtensionsMenuViewModel::OptionalSection::kNone);
+  EXPECT_EQ(menu_model()->GetSiteSettingsState().toggle.status,
+            ExtensionsMenuViewModel::ControlState::Status::kHidden);
+
+  ExtensionsMenuViewModel::MenuEntryState state =
+      menu_model()->GetMenuEntryState(extension->id(), gfx::Size(16, 16));
+  EXPECT_EQ(state.action_button.status,
+            ExtensionsMenuViewModel::ControlState::Status::kDisabled);
+  EXPECT_FALSE(state.action_button.icon.IsEmpty());
+  EXPECT_EQ(state.site_access_toggle.status,
+            ExtensionsMenuViewModel::ControlState::Status::kHidden);
+  EXPECT_EQ(state.site_permissions_button.status,
+            ExtensionsMenuViewModel::ControlState::Status::kHidden);
+  EXPECT_FALSE(menu_model()->CanShowSitePermissionsPage(extension->id()));
+
+  ExtensionsMenuViewModel::ExtensionSitePermissionsState permissions_state =
+      menu_model()->GetExtensionSitePermissionsState(extension->id(),
+                                                     gfx::Size(16, 16));
+  EXPECT_EQ(permissions_state.on_click_option.status,
+            ExtensionsMenuViewModel::ControlState::Status::kHidden);
+  EXPECT_EQ(permissions_state.on_site_option.status,
+            ExtensionsMenuViewModel::ControlState::Status::kHidden);
+  EXPECT_EQ(permissions_state.on_all_sites_option.status,
+            ExtensionsMenuViewModel::ControlState::Status::kHidden);
+  EXPECT_EQ(permissions_state.show_requests_toggle.status,
+            ExtensionsMenuViewModel::ControlState::Status::kHidden);
+
+  // Every callback that was bound to the former page must fail closed after
+  // its tab disappeared. In particular, it must neither change permissions
+  // nor record a successful extension action.
+  menu_model()->UpdateSiteAccess(
+      extension->id(), origin, PermissionsManager::UserSiteAccess::kOnClick);
+  menu_model()->GrantSiteAccess(extension->id(), origin);
+  menu_model()->RevokeSiteAccess(extension->id(), origin);
+  menu_model()->AllowHostAccessRequest(extension->id());
+  menu_model()->DismissHostAccessRequest(extension->id());
+  menu_model()->ExecuteAction(extension->id());
+  menu_model()->UpdateSiteSetting(
+      PermissionsManager::UserSiteSetting::kBlockAllExtensions);
+  menu_model()->ReloadWebContents();
+  menu_model()->OnHostAccessRequestAdded(extension->id(), 0);
+  menu_model()->OnHostAccessRequestUpdated(extension->id(), 0);
+  menu_model()->OnHostAccessRequestRemoved(extension->id(), 0);
+  menu_model()->OnHostAccessRequestsCleared(0);
+  menu_model()->OnHostAccessRequestDismissedByUser(extension->id(), origin);
+
+  EXPECT_EQ(permissions_manager()->GetUserSiteAccess(*extension, url),
+            site_access_before);
+  EXPECT_EQ(permissions_manager()->GetUserSiteSetting(origin),
+            site_setting_before);
+  EXPECT_EQ(user_action_tester.GetActionCount(kActivatedUserAction), 0);
+
+  content::WebContents* restored_contents = chrome::AddAndReturnTabAt(
+      browser_window_interface(), GURL(), -1, true);
+  ASSERT_TRUE(restored_contents);
+  ASSERT_TRUE(NavigateToURL(restored_contents, url));
+  ASSERT_EQ(restored_contents, menu_model()->GetActiveWebContents());
+  EXPECT_TRUE(menu_model()->CanShowSitePermissionsPage(extension->id()));
+
+  state = menu_model()->GetMenuEntryState(extension->id(), gfx::Size(16, 16));
+  EXPECT_EQ(state.action_button.status,
+            ExtensionsMenuViewModel::ControlState::Status::kEnabled);
+  EXPECT_EQ(state.site_access_toggle.status,
+            ExtensionsMenuViewModel::ControlState::Status::kEnabled);
+  EXPECT_EQ(state.site_permissions_button.status,
+            ExtensionsMenuViewModel::ControlState::Status::kEnabled);
+
+  browser()->tab_strip_model()->DetachAndDeleteWebContentsAt(0);
+  EXPECT_EQ(0, browser()->tab_strip_model()->count());
+  EXPECT_EQ(nullptr, menu_model()->GetActiveWebContents());
+  EXPECT_FALSE(menu_model()->CanShowSitePermissionsPage(extension->id()));
+}
