+bool BrowserFrameViewMac::IsAhoiGlassActive() const {
+  return is_glass_frame_eligible_ && ahoi_appearance_signals_ &&
+         ahoi_appearance_signals_->policy().AllowsGlass() &&
+         ahoi::appearance::IsNativeMacGlassAvailable();
