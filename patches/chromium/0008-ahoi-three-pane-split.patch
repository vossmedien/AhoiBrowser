+void DraggedTabsContainer::HandleTabDrop(
+    TabDragTarget::DragController& controller) {
+  const TabCollectionNode* split_drop_target = GetSplitDropTarget();
+  if (!split_drop_target) {
+    return;
+  }
+
+  const DragSessionData& session = controller.GetSessionData();
+  if (session.num_dragging_tabs() != 1 || !session.dragging_groups.empty()) {
+    return;
+  }
+
+  TabStripModel* model = GetDragHandler().GetTabStripModel();
+  const int source_index =
+      model->GetIndexOfWebContents(session.source_dragged_contents());
+  if (source_index == TabStripModel::kNoTab) {
+    return;
+  }
+
+  const tabs::ConstChildPtr target_data = split_drop_target->GetNodeData();
+  const tabs::TabInterface* target_tab = nullptr;
+  if (std::holds_alternative<const tabs::TabInterface*>(target_data)) {
+    target_tab = std::get<const tabs::TabInterface*>(target_data);
+  } else {
+    const auto* collection = std::get<const tabs::TabCollection*>(target_data);
+    if (collection->type() != tabs::TabCollection::Type::SPLIT ||
+        collection->TabCountRecursive() >= tabs::SplitTabCollection::kMaxTabs) {
+      return;
+    }
+    target_tab = collection->GetTabAtIndexRecursive(0);
+  }
+
+  const int target_index = model->GetIndexOfTab(target_tab);
+  if (target_index == TabStripModel::kNoTab || target_index == source_index) {
+    return;
+  }
+  model->CreateOrAddToSplitFromDrop(source_index, target_index,
+                                    split_drop_arrangement_);
+}
+
+bool DraggedTabsContainer::UpdateSplitDropTarget(
+    const gfx::Point& point_in_screen) {
+  SetSplitDropTarget(nullptr);
+  if (!collection_node_ || GetDragHandler().IsDraggingGroups()) {
+    return false;
+  }
+
+  const gfx::Point point_in_container = views::View::ConvertPointFromScreen(
+      base::to_address(host_view_), point_in_screen);
+  for (const views::ChildLayout& layout : GetLayoutForDrag().child_layouts) {
+    if (!layout.visible ||
+        GetDragHandler().IsViewDragging(*layout.child_view)) {
+      continue;
+    }
+    const TabCollectionNode* node =
+        GetCollectionNodeFromView(*layout.child_view);
+    if (!node || (node->type() != TabCollectionNode::Type::TAB &&
+                  node->type() != TabCollectionNode::Type::SPLIT)) {
+      continue;
+    }
+    if (node->type() == TabCollectionNode::Type::SPLIT) {
+      const auto* collection =
+          std::get<const tabs::TabCollection*>(node->GetNodeData());
+      if (collection->TabCountRecursive() >=
+          tabs::SplitTabCollection::kMaxTabs) {
+        continue;
+      }
+    }
+
+    gfx::Rect target_bounds = layout.bounds;
+    target_bounds.Inset(
+        gfx::Insets::VH(std::max(2, target_bounds.height() / 5),
+                        std::max(2, target_bounds.width() / 8)));
+    if (!target_bounds.Contains(point_in_container)) {
+      continue;
+    }
+
+    double horizontal_fraction =
+        static_cast<double>(point_in_container.x() - target_bounds.x()) /
+        std::max(1, target_bounds.width());
+    if (base::i18n::IsRTL()) {
+      horizontal_fraction = 1.0 - horizontal_fraction;
+    }
+    split_drop_arrangement_ =
+        horizontal_fraction < 1.0 / 3.0
+            ? split_tabs::SplitTabArrangement::kMainStart
+            : (horizontal_fraction > 2.0 / 3.0
+                   ? split_tabs::SplitTabArrangement::kMainEnd
+                   : split_tabs::SplitTabArrangement::kLinear);
+    SetSplitDropTarget(node);
+    return true;
+  }
+  return false;
+}
+
+void DraggedTabsContainer::SetSplitDropTarget(const TabCollectionNode* target) {
+  split_drop_target_handle_ =
+      target ? std::make_optional(target->GetHandle()) : std::nullopt;
+}
+
+const TabCollectionNode* DraggedTabsContainer::GetSplitDropTarget() const {
+  if (!collection_node_ || !split_drop_target_handle_) {
+    return nullptr;
+  }
+  return collection_node_->GetNodeForHandle(*split_drop_target_handle_);
+}
