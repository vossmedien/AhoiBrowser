+bool BrowserView::CanUseAhoiCmdScrollTabSwitch(int delta) const {
+#if !BUILDFLAG(IS_MAC)
+  return false;
+#else
+  if ((delta != -1 && delta != 1) || !browser_ || !multi_contents_view_ ||
+      multi_contents_view_->width() < 96 ||
+      (ahoi_modal_overlay_controller_ &&
+       ahoi_modal_overlay_controller_->IsShowingAnyPanel())) {
+    return false;
+  }
+  for (ContentsWebView* const contents_view :
+       GetAllVisibleContentsWebViews()) {
+    content::WebContents* const contents =
+        contents_view ? contents_view->web_contents() : nullptr;
+    auto* const manager = contents
+                              ? web_modal::WebContentsModalDialogManager::
+                                    FromWebContents(contents)
+                              : nullptr;
+    if (manager && manager->IsDialogActive()) {
+      return false;
+    }
+  }
+  return true;
+#endif
+}
+
+bool BrowserView::ActivateAhoiRelativeRuntimeTab(int delta) {
+#if !BUILDFLAG(IS_MAC)
+  return false;
+#else
+  if (!CanUseAhoiCmdScrollTabSwitch(delta)) {
+    ClearAhoiTabSwitchPreview();
+    return false;
+  }
+  TabStripModel* const model = browser_->tab_strip_model();
+  tabs::TabInterface* const active = model ? model->GetActiveTab() : nullptr;
+  VerticalTabStripRegionView* const region = vertical_tab_strip_region_view_;
+  if (!model || !active || !region || !region->ahoi_sidebar_tree_view()) {
+    ClearAhoiTabSwitchPreview();
+    return false;
+  }
+
+  base::WeakPtr<tabs::TabInterface> origin = ahoi_tab_switch_preview_origin_;
+  base::WeakPtr<tabs::TabInterface> target = ahoi_tab_switch_preview_target_;
+  const bool has_preview = ahoi_tab_switch_preview_delta_ != 0;
+  if (has_preview &&
+      (!origin || !target || ahoi_tab_switch_preview_delta_ != delta)) {
+    ClearAhoiTabSwitchPreview();
+    return false;
+  }
+  if (!has_preview) {
+    origin = active->GetWeakPtr();
+    target = ahoi::sidebar::ResolveRelativeBrowserRuntimeTab(
+        region->ahoi_sidebar_tree_view(), delta);
+  }
+  base::WeakPtr<tabs::TabInterface> current_target =
+      ahoi::sidebar::ResolveRelativeBrowserRuntimeTab(
+          region->ahoi_sidebar_tree_view(), delta);
+  const bool unchanged_preview =
+      origin && target && current_target && origin.get() == active &&
+      current_target.get() == target.get() &&
+      model->GetIndexOfTab(target.get()) != TabStripModel::kNoTab;
+  ClearAhoiTabSwitchPreview();
+  if (!unchanged_preview || !target) {
+    return false;
+  }
+  model->ActivateTab(
+      target.get(),
+      TabStripUserGestureDetails(
+          TabStripUserGestureDetails::GestureType::kWheel));
+  return true;
+#endif
+}
+
+void BrowserView::ClearAhoiTabSwitchPreview() {
+#if BUILDFLAG(IS_MAC)
+  ahoi_tab_switch_preview_timer_.Stop();
+  if (ahoi_tab_switch_preview_label_) {
+    ahoi_tab_switch_preview_label_->SetVisible(false);
+  }
+  ahoi_tab_switch_preview_origin_.reset();
+  ahoi_tab_switch_preview_target_.reset();
+  ahoi_tab_switch_preview_delta_ = 0;
+#endif
+}
