+// Ahoi: looks up the legacy item's secret when the item named
+// `service_name`/`account_name` is missing. Returns std::nullopt when there is
+// nothing to adopt (no legacy item, or the names already are the legacy
+// ones). Any other lookup failure, for example a denied Keychain prompt, is
+// returned as an error so that no new random key orphans data that the
+// legacy key encrypted; the next start tries again.
+base::expected<std::optional<std::string>, OSStatus> FindLegacyPassword(
+    KeychainV2& keychain,
+    const std::string& service_name,
+    const std::string& account_name) {
+  if (service_name == kLegacyServiceName &&
+      account_name == kLegacyAccountName) {
+    return std::nullopt;
+  }
+
+  auto legacy =
+      keychain.FindGenericPassword(kLegacyServiceName, kLegacyAccountName);
+  if (legacy.has_value()) {
+    if (legacy->empty()) {
+      return std::nullopt;
+    }
+    return std::string(base::as_string_view(*legacy));
+  }
+  if (legacy.error() == errSecItemNotFound) {
+    return std::nullopt;
+  }
+  OSSTATUS_LOG(ERROR, legacy.error()) << "Legacy keychain lookup failed";
+  return base::unexpected(legacy.error());
+}
+
+// Ahoi: copies the adopted legacy secret, byte for byte, into the item named
+// `service_name`/`account_name`, so the derived key and all data encrypted
+// with it stay valid. The secret is returned even when the copy fails; the
+// copy is then retried on the next start.
+std::string AdoptLegacyPassword(KeychainV2& keychain,
+                                const std::string& service_name,
+                                const std::string& account_name,
+                                std::string legacy_password) {
+  OSStatus error = keychain.AddGenericPassword(
+      service_name, account_name, base::as_byte_span(legacy_password));
+  if (error != noErr) {
+    OSSTATUS_LOG(WARNING, error)
+        << "Keychain copy of the legacy secret failed; using the legacy item";
+  }
+  return legacy_password;
+}
+
 }  // namespace
 
