@@ -1457,6 +1458,26 @@ void ChromeBrowsingDataRemoverDelegate::RemoveEmbedderData(
       }
     }
   }
+
+  //////////////////////////////////////////////////////////////////////////////
+  // Ahoi Workspace website sessions.
+  // A Workspace with its own website sessions keeps its cookies and site
+  // storage in a persistent non-default StoragePartition. Like the IWA
+  // partitions above, a removal that names no StoragePartition also reaches
+  // every existing one of them; none is created for it. This task ends once
+  // those removals are queued, since nested Remove calls are not supported,
+  // so RemoveAndReply callers (the Settings dialog, chrome.browsingData, BTM)
+  // hear "done" before the Workspace partitions are cleared. The queued
+  // removals hold no keep-alive: clearing on exit may not reach them.
+  if (!filter_builder->GetStoragePartitionConfig().has_value() &&
+      !profile_->IsOffTheRecord()) {
+    ahoi::session::RemoveWebsiteSessionPartitionData(
+        profile_, delete_begin, delete_end, remove_mask, origin_type_mask,
+        *filter_builder,
+        base::IgnoreArgs<std::vector<content::StoragePartitionConfig>>(
+            CreateTaskCompletionClosure(
+                TracingDataType::kAhoiWebsiteSessions)));
+  }
 #endif  // !BUILDFLAG(IS_ANDROID)
 
   //////////////////////////////////////////////////////////////////////////////
@@ -1647,6 +1668,8 @@ const char* ChromeBrowsingDataRemoverDelegate::GetHistogramSuffix(
       return "MediaDeviceSalts";
     case TracingDataType::kPrivateVerificationTokens:
       return "PrivateVerificationTokens";
+    case TracingDataType::kAhoiWebsiteSessions:
+      return "AhoiWebsiteSessions";
   }
 }
