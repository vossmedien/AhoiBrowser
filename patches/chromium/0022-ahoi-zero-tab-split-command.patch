+IN_PROC_BROWSER_TEST_F(BrowserTabStripModelDelegateTest,
+                       NewSplitTabFromEmptyTabList) {
+  std::unique_ptr<TabStripModelDelegate> delegate =
+      std::make_unique<BrowserTabStripModelDelegate>(browser());
+
+  ASSERT_EQ(browser()->tab_strip_model()->count(), 1);
+  browser()->tab_strip_model()->DetachAndDeleteWebContentsAt(0);
+  ASSERT_EQ(browser()->tab_strip_model()->count(), 0);
+  ASSERT_EQ(browser()->tab_strip_model()->active_index(),
+            TabStripModel::kNoTab);
+
+  delegate->NewSplitTab({}, split_tabs::SplitTabLayout::kSideBySide,
+                        split_tabs::SplitTabCreatedSource::kToolbarButton);
+
+  ASSERT_EQ(browser()->tab_strip_model()->count(), 2);
+  ASSERT_NE(browser()->tab_strip_model()->active_index(),
+            TabStripModel::kNoTab);
+  const std::optional<split_tabs::SplitTabId> split_id =
+      browser()->tab_strip_model()->GetSplitForTab(0);
+  ASSERT_TRUE(split_id.has_value());
+  EXPECT_EQ(browser()->tab_strip_model()->GetSplitForTab(1), split_id);
+}
