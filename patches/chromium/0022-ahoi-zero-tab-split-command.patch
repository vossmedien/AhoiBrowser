From 63d27148cb910ebbd719fa31c2aaed5f38ec84f1 Mon Sep 17 00:00:00 2001
From: vossmedien <christian@vossmedien.de>
Date: Mon, 31 Aug 2026 11:39:34 +0200
Subject: [PATCH] patch: seed zero-tab split commands

---
 chrome/browser/ui/browser_actions.cc          |  4 +++-
 .../browser/ui/browser_command_controller.cc  |  3 ++-
 chrome/browser/ui/browser_commands.cc         | 14 ++++++++++-
 ...er_tab_strip_model_delegate_browsertest.cc | 23 +++++++++++++++++++
 4 files changed, 41 insertions(+), 3 deletions(-)

diff --git a/chrome/browser/ui/browser_actions.cc b/chrome/browser/ui/browser_actions.cc
index 438b84da29..a47ae2d48d 100644
--- a/chrome/browser/ui/browser_actions.cc
+++ b/chrome/browser/ui/browser_actions.cc
@@ -2472,7 +2472,9 @@ void BrowserActions::InitializeToolbarAndMiscActions() {
           base::BindRepeating(
               [](BrowserWindowInterface* bwi, actions::ActionItem* item,
                  actions::ActionInvocationContext context) {
-                if (!bwi->GetTabStripModel()->GetActiveTab()->IsSplit()) {
+                tabs::TabInterface* const active_tab =
+                    bwi->GetTabStripModel()->GetActiveTab();
+                if (!active_tab || !active_tab->IsSplit()) {
                   chrome::NewSplitTab(
                       bwi, split_tabs::SplitTabLayout::kSideBySide,
                       split_tabs::SplitTabCreatedSource::kKeyboardShortcut);
diff --git a/chrome/browser/ui/browser_command_controller.cc b/chrome/browser/ui/browser_command_controller.cc
index 78134be80b..be20bf328e 100644
--- a/chrome/browser/ui/browser_command_controller.cc
+++ b/chrome/browser/ui/browser_command_controller.cc
@@ -833,7 +833,8 @@ void BrowserCommandController::HandleCommandWithDisposition(
       MoveActiveTabToNewWindow(browser_);
       break;
     case IDC_NEW_SPLIT_TAB:
-      if (!browser_->tab_strip_model()->GetActiveTab()->IsSplit()) {
+      if (!browser_->tab_strip_model()->GetActiveTab() ||
+          !browser_->tab_strip_model()->GetActiveTab()->IsSplit()) {
         NewSplitTab(browser_, split_tabs::SplitTabLayout::kSideBySide,
                     split_tabs::SplitTabCreatedSource::kKeyboardShortcut);
       }
diff --git a/chrome/browser/ui/browser_commands.cc b/chrome/browser/ui/browser_commands.cc
index 294487f786..55cc3572df 100644
--- a/chrome/browser/ui/browser_commands.cc
+++ b/chrome/browser/ui/browser_commands.cc
@@ -1680,7 +1680,19 @@ void NewSplitTab(BrowserWindowInterface* browser,
                  split_tabs::SplitTabLayout layout,
                  split_tabs::SplitTabCreatedSource source) {
   TabStripModel* const tab_strip_model = browser->GetTabStripModel();
-  const int active_index = tab_strip_model->active_index();
+  int active_index = tab_strip_model->active_index();
+  if (active_index == TabStripModel::kNoTab) {
+    // Ahoi workspaces may intentionally contain no tabs. Seed that empty
+    // workspace with a regular new tab before creating the second pane so the
+    // standard split-tab path never queries group or pinned state at index -1.
+    tab_strip_model->delegate()->AddTabAt(
+        chrome::ChromeUINewTabURLAsGURL(), /*index=*/0, /*foreground=*/true,
+        /*group=*/std::nullopt, /*pinned=*/false);
+    active_index = tab_strip_model->active_index();
+    if (active_index == TabStripModel::kNoTab) {
+      return;
+    }
+  }
   // In Incognito mode, we can't show the regular Split View NTP so default to
   // the regular NTP which renders special content when in Incognito.
   const GURL new_tab_url = !browser->GetProfile()->IsIncognitoProfile() &&
diff --git a/chrome/browser/ui/browser_tab_strip_model_delegate_browsertest.cc b/chrome/browser/ui/browser_tab_strip_model_delegate_browsertest.cc
index 77de23b7ce..43b7ccec73 100644
--- a/chrome/browser/ui/browser_tab_strip_model_delegate_browsertest.cc
+++ b/chrome/browser/ui/browser_tab_strip_model_delegate_browsertest.cc
@@ -347,6 +347,29 @@ IN_PROC_BROWSER_TEST_F(BrowserTabStripModelDelegateTest,
   ASSERT_TRUE(browser()->tab_strip_model()->IsTabPinned(1));
 }
 
+IN_PROC_BROWSER_TEST_F(BrowserTabStripModelDelegateTest,
+                       NewSplitTabFromEmptyTabList) {
+  std::unique_ptr<TabStripModelDelegate> delegate =
+      std::make_unique<BrowserTabStripModelDelegate>(browser());
+
+  ASSERT_EQ(browser()->tab_strip_model()->count(), 1);
+  browser()->tab_strip_model()->DetachAndDeleteWebContentsAt(0);
+  ASSERT_EQ(browser()->tab_strip_model()->count(), 0);
+  ASSERT_EQ(browser()->tab_strip_model()->active_index(),
+            TabStripModel::kNoTab);
+
+  delegate->NewSplitTab({}, split_tabs::SplitTabLayout::kSideBySide,
+                        split_tabs::SplitTabCreatedSource::kToolbarButton);
+
+  ASSERT_EQ(browser()->tab_strip_model()->count(), 2);
+  ASSERT_NE(browser()->tab_strip_model()->active_index(),
+            TabStripModel::kNoTab);
+  const std::optional<split_tabs::SplitTabId> split_id =
+      browser()->tab_strip_model()->GetSplitForTab(0);
+  ASSERT_TRUE(split_id.has_value());
+  EXPECT_EQ(browser()->tab_strip_model()->GetSplitForTab(1), split_id);
+}
+
 IN_PROC_BROWSER_TEST_F(BrowserTabStripModelDelegateTest,
                        NewSplitTabWithActiveTabGroupped) {
   std::unique_ptr<TabStripModelDelegate> delegate =
-- 
2.55.0

