diff --git a/chrome/browser/ui/navigator/browser_navigator.cc b/chrome/browser/ui/navigator/browser_navigator.cc
--- a/chrome/browser/ui/navigator/browser_navigator.cc
+++ b/chrome/browser/ui/navigator/browser_navigator.cc
@@ -708,6 +708,28 @@
     params->source_contents = params->browser->GetBrowserForMigrationOnly()
                                   ->tab_strip_model()
                                   ->GetActiveWebContents();
+  }
+
+  // Ahoi may show a selected Workspace with no visible tab while Chromium's
+  // TabStripModel still has a tab from another Workspace selected. Typed
+  // browser-UI input must create a tab for the selected Workspace before its
+  // first request, not navigate the hidden tab with another account's jar.
+  if (params->browser && !params->contents_to_insert &&
+      params->disposition == WindowOpenDisposition::CURRENT_TAB &&
+      !params->is_renderer_initiated &&
+      (params->transition & ui::PAGE_TRANSITION_FROM_ADDRESS_BAR)) {
+    const std::optional<bool> source_in_active_workspace =
+        ahoi::session::IsCurrentTabInActiveWorkspaceForNavigation(
+            params->browser, params->source_contents);
+    if (source_in_active_workspace.has_value() &&
+        !*source_in_active_workspace) {
+      params->disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+      params->source_contents = nullptr;
+      params->source_site_instance.reset();
+      params->opener = nullptr;
+      params->referrer = content::Referrer();
+      params->tabstrip_add_types &= ~AddTabTypes::ADD_INHERIT_OPENER;
+    }
   }
 
