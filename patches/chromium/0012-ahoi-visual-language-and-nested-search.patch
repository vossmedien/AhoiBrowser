+inline constexpr ui::ColorId kDivider = ui::kColorSysDivider;
+
+inline constexpr int kSidebarWidth = 264;
+inline constexpr int kPanelCornerRadius = 16;
+inline constexpr int kControlCornerRadius = 10;
+inline constexpr int kRowCornerRadius = 8;
+
