+  void UpdateFavicon(const GURL& url, ui::ImageModel favicon) {
+    bool changed = false;
+    for (RecentGroupLink& link : links_) {
+      if (link.url == url) {
+        link.favicon = favicon;
+        changed = true;
+      }
+    }
+    if (changed) {
+      RebuildResults();
+    }
+  }
