+  bool BuildMoveToMenu(const tab_tree::TreeNode& source) {
+    context_move_target_ids_.clear();
+    context_move_menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+
+    tab_tree::TabTreeSnapshot snapshot;
+    if (session_bridge_->tab_tree_store()->ExportSnapshot(&snapshot) !=
+        tab_tree::TabTreeStore::Result::kOk) {
+      context_move_menu_model_.reset();
+      return false;
+    }
+
+    std::set<base::Uuid> excluded_ids;
+    std::vector<tab_tree::TreeNode> source_subtree;
+    if (session_bridge_->tab_tree_store()->GetSubtree(source.id,
+                                                      &source_subtree) ==
+        tab_tree::TabTreeStore::Result::kOk) {
+      for (const tab_tree::TreeNode& node : source_subtree) {
+        excluded_ids.insert(node.id);
+      }
+    } else {
+      excluded_ids.insert(source.id);
+    }
+
+    std::map<base::Uuid, const tab_tree::TreeNode*> nodes_by_id;
+    for (const tab_tree::TreeNode& node : snapshot.nodes) {
+      if (!node.tombstone && node.workspace_id == source.workspace_id) {
+        nodes_by_id.emplace(node.id, &node);
+      }
+    }
+
+    if (source.parent_id.has_value()) {
+      std::u16string workspace_name = u"Ahoi";
+      for (const tab_tree::Workspace& workspace :
+           workspace_service_->ordered_workspaces()) {
+        if (workspace.id == source.workspace_id) {
+          workspace_name = workspace.name;
+          break;
+        }
+      }
+      const int command_id = kMoveToFolderCommandBase;
+      context_move_target_ids_.push_back(std::nullopt);
+      context_move_menu_model_->AddItem(command_id, workspace_name);
+    }
+
+    std::vector<std::pair<std::u16string, base::Uuid>> folder_paths;
+    for (const auto& [folder_id, folder] : nodes_by_id) {
+      if (folder->type != tab_tree::TreeNodeType::kFolder ||
+          excluded_ids.contains(folder_id) || source.parent_id == folder_id) {
+        continue;
+      }
+      std::vector<std::u16string> path_parts;
+      const tab_tree::TreeNode* cursor = folder;
+      for (size_t guard = 0; cursor && guard <= nodes_by_id.size(); ++guard) {
+        path_parts.push_back(cursor->title);
+        if (!cursor->parent_id.has_value()) {
+          break;
+        }
+        auto parent = nodes_by_id.find(*cursor->parent_id);
+        cursor = parent == nodes_by_id.end() ? nullptr : parent->second;
+      }
+      std::reverse(path_parts.begin(), path_parts.end());
+      std::u16string path;
+      for (const std::u16string& part : path_parts) {
+        if (!path.empty()) {
+          path.append(u" / ");
+        }
+        path.append(part);
+      }
+      folder_paths.emplace_back(std::move(path), folder_id);
+    }
+    std::ranges::sort(folder_paths, [](const auto& left, const auto& right) {
+      return left.first < right.first;
+    });
+    for (const auto& [path, folder_id] : folder_paths) {
+      const int command_id = kMoveToFolderCommandBase +
+                             static_cast<int>(context_move_target_ids_.size());
+      context_move_target_ids_.push_back(folder_id);
+      context_move_menu_model_->AddItem(command_id, path);
+    }
+    if (context_move_target_ids_.empty()) {
+      context_move_menu_model_.reset();
+      return false;
+    }
+    return true;
+  }
