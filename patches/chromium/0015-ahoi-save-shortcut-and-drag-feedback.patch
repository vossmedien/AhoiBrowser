+  void Layout(PassKey) override {
+    const int count = static_cast<int>(children().size());
+    if (count == 0) {
+      return;
+    }
+    constexpr int kSegmentSpacing = 2;
+    const int content_width =
+        std::max(0, width() - (count - 1) * kSegmentSpacing);
+    int x = 0;
+    for (int index = 0; index < count; ++index) {
+      const int next_x =
+          (content_width * (index + 1)) / count + index * kSegmentSpacing;
+      children()[index]->SetBounds(x, 0, std::max(0, next_x - x), height());
+      x = next_x + kSegmentSpacing;
+    }
+  }
