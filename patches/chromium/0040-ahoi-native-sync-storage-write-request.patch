+base::CallbackListSubscription
+StorageFrontend::ObserveSyncSettingsWriteRequests(
+    SyncSettingsWriteRequestedCallback callback) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  return sync_write_request_observers_->Add(std::move(callback));
+}
+
+bool StorageFrontend::NotifySyncSettingsWriteRequested(
+    const ExtensionId& extension_id) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  const auto weak_this = weak_factory_.GetWeakPtr();
+  const auto observers = sync_write_request_observers_;
+  observers->Notify(extension_id);
+  return !!weak_this;
+}
