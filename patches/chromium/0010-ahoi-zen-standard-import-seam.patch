+TEST_F(FirefoxImporterTest, CopiesAndRecopiesRegularSourceFile) {
+  base::ScopedTempDir source_dir;
+  ASSERT_TRUE(source_dir.CreateUniqueTempDir());
+  const base::FilePath source =
+      source_dir.GetPath().AppendASCII("places.sqlite");
+  ASSERT_TRUE(base::WriteFile(source, "first payload"));
+
+  importer_->source_path_ = source_dir.GetPath();
+  ASSERT_TRUE(importer_->source_path_copy_.CreateUniqueTempDir());
+  const base::FilePath first_copy =
+      importer_->GetCopiedSourcePath("places.sqlite");
+  ASSERT_FALSE(first_copy.empty());
+  std::string copied_contents;
+  ASSERT_TRUE(base::ReadFileToString(first_copy, &copied_contents));
+  EXPECT_EQ(copied_contents, "first payload");
+
+  ASSERT_TRUE(base::WriteFile(source, "x"));
+  const base::FilePath second_copy =
+      importer_->GetCopiedSourcePath("places.sqlite");
+  EXPECT_EQ(second_copy, first_copy);
+  ASSERT_TRUE(base::ReadFileToString(second_copy, &copied_contents));
+  EXPECT_EQ(copied_contents, "x");
+}
+
+#if BUILDFLAG(IS_POSIX)
+TEST_F(FirefoxImporterTest, RejectsSymlinkedSourceFile) {
