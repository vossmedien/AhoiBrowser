+  ASSERT_TRUE(base::WriteFile(target, "database"));
+  ASSERT_TRUE(base::CreateSymbolicLink(
+      target, source_dir.GetPath().AppendASCII("places.sqlite")));
+
+  importer_->source_path_ = source_dir.GetPath();
+  ASSERT_TRUE(importer_->source_path_copy_.CreateUniqueTempDir());
+  const base::FilePath stale_destination =
+      importer_->source_path_copy_.GetPath().AppendASCII("places.sqlite");
+  ASSERT_TRUE(base::WriteFile(stale_destination, "stale"));
+  EXPECT_TRUE(importer_->GetCopiedSourcePath("places.sqlite").empty());
+  EXPECT_FALSE(base::PathExists(stale_destination));
+}
