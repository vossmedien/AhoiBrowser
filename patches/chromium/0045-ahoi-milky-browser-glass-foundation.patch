diff --git a/chrome/browser/ui/views/frame/browser_native_widget_mac.mm b/chrome/browser/ui/views/frame/browser_native_widget_mac.mm
--- a/chrome/browser/ui/views/frame/browser_native_widget_mac.mm
+++ b/chrome/browser/ui/views/frame/browser_native_widget_mac.mm
@@ -1037,12 +1037,17 @@
   if (@available(macOS 26.0, *)) {
     [ns_window setOpaque:NO];
 
-    // A completely transparent background ([NSColor clearColor]) causes AppKit
-    // to continuously invalidate the window surface, resulting in high CPU
-    // and energy usage. Using an almost-transparent color (alpha 0.001) avoids
-    // this performance issue while remaining visually indistinguishable.
-    [ns_window setBackgroundColor:[[NSColor windowBackgroundColor]
-                                      colorWithAlphaComponent:0.001]];
+    // The native material sits behind Chromium's Views. A nearly clear
+    // NSWindow exposes the desktop through WebUI/chrome gaps instead of
+    // producing frosted glass. Keep a neutral translucent foundation beneath
+    // the full-window material while leaving WebContents itself untouched.
+    const SkColor foundation = material.fallback_color;
+    [ns_window
+        setBackgroundColor:[NSColor
+                               colorWithSRGBRed:SkColorGetR(foundation) / 255.0
+                                          green:SkColorGetG(foundation) / 255.0
+                                           blue:SkColorGetB(foundation) / 255.0
+                                          alpha:0.82]];
 
     if (!background_view_) {
       NSView* const content_view = [ns_window contentView];
@@ -1086,6 +1091,16 @@
 
   NSView* const content_view = [ns_window contentView];
 
+  if (appearance_signals_ && appearance_signals_->policy().AllowsGlass()) {
+    background_view_.frame = content_view.bounds;
+    background_view_.autoresizingMask =
+        NSViewWidthSizable | NSViewHeightSizable;
+    if (tint_view_) {
+      tint_view_.frame = background_view_.bounds;
+    }
+    return;
+  }
+
   const int content_width = static_cast<int>(content_view.bounds.size.width);
   const int content_height = static_cast<int>(content_view.bounds.size.height);
 
