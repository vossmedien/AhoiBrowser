+bool CrxInstaller::CanActivateGuardedInstall() {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!browser_context_) {
+    return false;
+  }
+  if ((install_flags_ & kInstallFlagInstallDisabled) &&
+      ExtensionSystem::Get(browser_context())
+          ->management_policy()
+          ->MustRemainEnabled(extension(), nullptr)) {
+    return false;
+  }
+  if (!activation_authorization_) {
+    return true;
+  }
+  if (!activation_authorization_.Run()) {
+    return false;
+  }
+  auto* delayed = DelayedInstallManager::Get(browser_context());
+  ExtensionPrefs::DelayReason reason;
+  return delayed &&
+         delayed->ShouldDelayExtensionInstall(
+             extension(), !!(install_flags_ & kInstallFlagInstallImmediately),
+             &reason) == InstallGate::INSTALL &&
+         activation_authorization_.Run();
+}
