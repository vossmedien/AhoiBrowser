+bool ExtensionRegistrar::GrantPermissionsAndEnableExtension(
+    const Extension& extension,
+    base::RepeatingCallback<bool()> activation_authorization) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  CHECK(activation_authorization);
+  scoped_refptr<const Extension> retained_extension = &extension;
+  const auto weak_this = weak_factory_.GetWeakPtr();
+  if (!activation_authorization.Run()) {
+    return false;
+  }
+  delegate_->GrantActivePermissions(retained_extension.get());
+  if (!weak_this || !activation_authorization.Run()) {
+    return false;
+  }
+  EnableExtension(retained_extension->id());
+  return weak_this && IsExtensionEnabled(retained_extension->id());
+}
