+  namespace shortcuts = ahoi::shortcuts;
+  const shortcuts::Overrides& overrides = ahoi_shortcuts_->overrides();
+  // Chromium finds a key's command in the main menu, so moving an item's key
+  // equivalent moves the key and its menu display together. Mouse clicks on
+  // these items keep Chromium's commands.
+  static constexpr shortcuts::MainMenuBinding kMenuBindings[] = {
+      {IDC_FOCUS_LOCATION, shortcuts::kCommandBar},
+      {IDC_NEW_TAB, shortcuts::kCommandBarNewTab},
+      {IDC_BOOKMARK_THIS_TAB, shortcuts::kSaveTab},
+  };
+  shortcuts::ApplyMainMenuKeyEquivalents(overrides, kMenuBindings);
+  Profile* const profile = browser_->GetProfile();
+  if (profile && profile->IsRegularProfile() && !profile->IsOffTheRecord()) {
+    const std::vector<ui::Accelerator> keys =
+        shortcuts::EffectiveAccelerators(overrides, shortcuts::kQuickWindow);
+    AhoiQuickWindowGlobalShortcut::GetInstance()->SetAccelerator(
+        keys.empty() ? std::nullopt
+                     : std::optional<ui::Accelerator>(keys.front()));
+  }
+}
