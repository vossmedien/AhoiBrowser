+ImporterSourceDiscoveryState ToDiscoveryState(
+    ahoi::importer::arc::ArcImportAvailability availability) {
+  switch (availability) {
+    case ahoi::importer::arc::ArcImportAvailability::kNotInstalled:
+      return ImporterSourceDiscoveryState::kNotInstalled;
+    case ahoi::importer::arc::ArcImportAvailability::kNoSafeProfiles:
+      return ImporterSourceDiscoveryState::kNoSafeProfiles;
+    case ahoi::importer::arc::ArcImportAvailability::kSourceRunning:
+      return ImporterSourceDiscoveryState::kSourceRunning;
+    case ahoi::importer::arc::ArcImportAvailability::kAvailable:
+      return ImporterSourceDiscoveryState::kAvailable;
+  }
+  return ImporterSourceDiscoveryState::kNotInstalled;
+}
+
+ImporterSourceDiscoveryState ToDiscoveryState(
+    ahoi::importer::zen::ZenImportAvailability availability) {
+  switch (availability) {
+    case ahoi::importer::zen::ZenImportAvailability::kNotInstalled:
+      return ImporterSourceDiscoveryState::kNotInstalled;
+    case ahoi::importer::zen::ZenImportAvailability::kNoSafeProfiles:
+      return ImporterSourceDiscoveryState::kNoSafeProfiles;
+    case ahoi::importer::zen::ZenImportAvailability::kSourceRunning:
+      return ImporterSourceDiscoveryState::kSourceRunning;
+    case ahoi::importer::zen::ZenImportAvailability::kAvailable:
+      return ImporterSourceDiscoveryState::kAvailable;
+  }
+  return ImporterSourceDiscoveryState::kNotInstalled;
+}
+
+void SetZenStructureMetadata(
+    ahoi::importer::zen::ZenStructureCapability source_capability,
+    ImporterSourceProfileMetadata* metadata) {
+  CHECK(metadata);
+  metadata->structure_revision =
+      ahoi::importer::zen::kValidatedZenUpstreamRevision;
+  switch (source_capability) {
+    case ahoi::importer::zen::ZenStructureCapability::kNotPresent:
+      metadata->structure_capability =
+          ImporterSourceStructureCapability::kUnavailable;
+      metadata->structure_disabled_reason =
+          ImporterSourceStructureDisabledReason::kNotPresent;
+      return;
+    case ahoi::importer::zen::ZenStructureCapability::kMozLz4Candidate:
+      metadata->structure_capability =
+          ImporterSourceStructureCapability::kDetectionOnly;
+      metadata->structure_disabled_reason =
+          ImporterSourceStructureDisabledReason::kUnverifiedMozLz4;
+      return;
+    case ahoi::importer::zen::ZenStructureCapability::kUnsupportedHeader:
+      metadata->structure_capability =
+          ImporterSourceStructureCapability::kUnavailable;
+      metadata->structure_disabled_reason =
+          ImporterSourceStructureDisabledReason::kUnsupportedHeader;
+      return;
+    case ahoi::importer::zen::ZenStructureCapability::kUnsafeOrOversized:
+      metadata->structure_capability =
+          ImporterSourceStructureCapability::kUnavailable;
+      metadata->structure_disabled_reason =
+          ImporterSourceStructureDisabledReason::kUnsafeOrOversized;
+      return;
+  }
+}
