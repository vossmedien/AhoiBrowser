+void CommandStorageManager::SaveAndReadCurrentSessionCommands(
+    GetCommandsCallback callback) {
+  const EncryptSessionStorageStage encrypt_stage =
+      GetEncryptSessionStorageStage();
+  const bool requires_encrypted_backend =
+      encrypt_stage != EncryptSessionStorageStage::kClearOnly;
+  if (requires_encrypted_backend && !encrypted_backend_) {
+    weak_factory_for_timer_.InvalidateWeakPtrs();
+    LogEncryptedBackendUninitialized(
+        SessionEncryptedBackendUninitialized::kSave);
+    std::move(callback).Run({}, true);
+    return;
+  }
+
+  SaveImpl(/*allow_empty_reset=*/true);
+
+  switch (encrypt_stage) {
+    case EncryptSessionStorageStage::kClearOnly:
+      backend_task_runner_->PostTaskAndReplyWithResult(
+          FROM_HERE,
+          base::BindOnce(
+              &CommandStorageBackend::FlushAndReadCurrentSessionCommands,
+              backend_.get()),
+          base::BindOnce(&OnBackendReadFinished, /*saved_result=*/nullptr,
+                         std::move(callback)));
+      return;
+    case EncryptSessionStorageStage::kWriteBothReadOnlyClear:
+    case EncryptSessionStorageStage::kWriteBothReadPreferEncrypted:
+      backend_task_runner_->PostTaskAndReplyWithResult(
+          FROM_HERE,
+          base::BindOnce(
+              &FlushAndReadDualBackends, backend_, encrypted_backend_,
+              encrypt_stage ==
+                  EncryptSessionStorageStage::kWriteBothReadPreferEncrypted),
+          base::BindOnce(&OnBackendReadFinished, /*saved_result=*/nullptr,
+                         std::move(callback)));
+      return;
+    case EncryptSessionStorageStage::kWriteEncryptedReadPreferEncrypted:
+      backend_task_runner_->PostTaskAndReplyWithResult(
+          FROM_HERE,
+          base::BindOnce(
+              &CommandStorageBackend::FlushAndReadCurrentSessionCommands,
+              encrypted_backend_.get()),
+          base::BindOnce(&OnBackendReadFinished, /*saved_result=*/nullptr,
+                         std::move(callback)));
+      return;
+  }
+}
