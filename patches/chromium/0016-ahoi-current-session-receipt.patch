+CommandStorageBackend::ReadCommandsResult
+CommandStorageBackend::FlushAndReadCurrentSessionCommands() {
+  InitIfNecessary();
+
+  CommandStorageBackend::ReadCommandsResult result;
+  if (!open_file_ || !open_file_->file || !open_file_->file->IsValid() ||
+      !open_file_->did_write_marker) {
+    result.error_reading = true;
+    return result;
+  }
+  if (is_encrypted() && (!encryptor_->IsEncryptionAvailable() ||
+                         !encryptor_->IsDecryptionAvailable())) {
+    result.error_reading = true;
+    return result;
+  }
+
+  const base::FilePath current_path = open_file_->path;
+  if (!open_file_->file->Flush()) {
+    result.error_reading = true;
+    return result;
+  }
+
+  // The writer intentionally denies parallel reads on Windows. Release that
+  // handle only after Flush(), then verify and decode the exact path before
+  // reopening it in append mode for subsequent session updates.
+  open_file_->file.reset();
+
+  SessionFileReader::ReadResult read_result =
+      SessionFileReader::Read(current_path, encryptor_.get());
+  if (!read_result.has_marker) {
+    read_result.commands.clear();
+    read_result.status = ReadStatus::kInvalidCommand;
+  }
+
+  std::unique_ptr<base::File> append_file = std::make_unique<base::File>(
+      current_path, base::File::FLAG_OPEN | base::File::FLAG_APPEND |
+                        base::File::FLAG_WIN_EXCLUSIVE_WRITE |
+                        base::File::FLAG_WIN_EXCLUSIVE_READ);
+  if (!append_file->IsValid() || !open_file_ ||
+      open_file_->path != current_path) {
+    CloseFile();
+    result.error_reading = true;
+    return result;
+  }
+  open_file_->file = std::move(append_file);
+
+  result.commands = std::move(read_result.commands);
+  result.error_reading = IsError(read_result.status);
+  if (result.error_reading) {
+    result.commands.clear();
+  }
+  return result;
+}
