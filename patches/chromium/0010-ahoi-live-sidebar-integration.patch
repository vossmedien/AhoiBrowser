+class NewGroupDropTargetView final : public views::View {
+  METADATA_HEADER(NewGroupDropTargetView, views::View)
+
+ public:
+  using DropNodeCallback = base::RepeatingCallback<void(const base::Uuid&)>;
+
+  explicit NewGroupDropTargetView(DropNodeCallback callback)
+      : callback_(std::move(callback)) {
+    SetPreferredSize(gfx::Size(kSidebarWidth - 16, 42));
+    SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(10, 12)));
+    auto* label =
+        AddChildView(std::make_unique<views::Label>(u"+ Neue Gruppe"));
+    label->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    label->SetEnabledColor(ui::kColorSysOnTonalContainer);
+    SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kHorizontal));
+    GetViewAccessibility().SetRole(ax::mojom::Role::kButton);
+    GetViewAccessibility().SetName(u"Neue Gruppe erstellen");
+    SetHighlighted(false);
+  }
+
+  NewGroupDropTargetView(const NewGroupDropTargetView&) = delete;
+  NewGroupDropTargetView& operator=(const NewGroupDropTargetView&) = delete;
+  ~NewGroupDropTargetView() override = default;
+
+  bool GetDropFormats(
+      int* formats,
+      std::set<ui::ClipboardFormatType>* format_types) override {
+    *formats |= ui::OSExchangeData::PICKLED_DATA;
+    format_types->insert(SidebarTreeView::DragFormat());
+    return true;
+  }
+
+  bool AreDropTypesRequired() override { return true; }
+
+  bool CanDrop(const ui::OSExchangeData& data) override {
+    return SidebarTreeView::ReadDraggedNode(data).has_value();
+  }
+
+  void OnDragEntered(const ui::DropTargetEvent&) override {
+    SetHighlighted(true);
+  }
+
+  int OnDragUpdated(const ui::DropTargetEvent&) override {
+    return ui::DragDropTypes::DRAG_MOVE;
+  }
+
+  void OnDragExited() override { SetHighlighted(false); }
+
+  views::View::DropCallback GetDropCallback(
+      const ui::DropTargetEvent& event) override {
+    const std::optional<base::Uuid> source =
+        SidebarTreeView::ReadDraggedNode(event.data());
+    if (!source.has_value()) {
+      return {};
+    }
+    return base::BindOnce(&NewGroupDropTargetView::PerformDrop,
+                          weak_ptr_factory_.GetWeakPtr(), *source);
+  }
+
+ private:
+  void SetHighlighted(bool highlighted) {
+    highlighted_ = highlighted;
+    SetBackground(views::CreateRoundedRectBackground(
+        highlighted ? ui::kColorSysTonalContainer : ui::kColorSysSurface3, 12));
+    SchedulePaint();
+  }
+
+  void PerformDrop(base::Uuid source_node_id,
+                   const ui::DropTargetEvent&,
+                   ui::mojom::DragOperation& output_drag_op,
+                   std::unique_ptr<ui::LayerTreeOwner>) {
+    SetHighlighted(false);
+    callback_.Run(source_node_id);
+    output_drag_op = ui::mojom::DragOperation::kMove;
+  }
+
+  const DropNodeCallback callback_;
+  bool highlighted_ = false;
+  base::WeakPtrFactory<NewGroupDropTargetView> weak_ptr_factory_{this};
+};
