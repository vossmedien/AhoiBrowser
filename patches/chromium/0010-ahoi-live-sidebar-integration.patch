+  // SidebarTreeViewDelegate:
+  void ActivateSavedPage(const tab_tree::TreeNode& node) override {
+    if (tabs::TabInterface* tab =
+            session_bridge_->FindTabByTreeNodeId(node.id)) {
+      TabStripModel* model = session_bridge_->FindTabStripModelForTab(tab);
+      BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+      const int index = model ? model->GetIndexOfTab(tab) : -1;
+      if (model && index >= 0) {
+        model->ActivateTabAt(
+            index, TabStripUserGestureDetails(
+                       TabStripUserGestureDetails::GestureType::kMouse));
+        if (window && window->GetWindow()) {
+          window->GetWindow()->Activate();
+        }
+        return;
+      }
+    }
+
+    NavigateParams params(browser_, node.url,
+                          ui::PAGE_TRANSITION_AUTO_BOOKMARK);
+    params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    ::Navigate(&params);
+  }
+
+  bool CanSplitSavedPages(const base::Uuid& source_node_id,
+                          const base::Uuid& target_node_id) const override {
+    tabs::TabInterface* source =
+        session_bridge_->FindTabByTreeNodeId(source_node_id);
+    tabs::TabInterface* target =
+        session_bridge_->FindTabByTreeNodeId(target_node_id);
+    if (!source || !target || source == target || source->IsSplit()) {
+      return false;
+    }
+    TabStripModel* source_model =
+        session_bridge_->FindTabStripModelForTab(source);
+    TabStripModel* target_model =
+        session_bridge_->FindTabStripModelForTab(target);
+    if (!source_model || source_model != target_model ||
+        source_model != tab_strip_model_) {
+      return false;
+    }
+    if (!target->IsSplit()) {
+      return true;
+    }
+    const split_tabs::SplitTabData* split_data =
+        target_model->GetSplitData(*target->GetSplit());
+    return split_data && split_data->ListTabs().size() <
+                             split_tabs::SplitTabVisualData::kMaxPanes;
+  }
+
+  bool SplitSavedPages(const base::Uuid& source_node_id,
+                       const base::Uuid& target_node_id) override {
+    if (!CanSplitSavedPages(source_node_id, target_node_id)) {
+      return false;
+    }
+    tabs::TabInterface* source =
+        session_bridge_->FindTabByTreeNodeId(source_node_id);
+    tabs::TabInterface* target =
+        session_bridge_->FindTabByTreeNodeId(target_node_id);
+    TabStripModel* model = session_bridge_->FindTabStripModelForTab(target);
+    const bool created =
+        model
+            ->CreateOrAddToSplitFromDrop(
+                model->GetIndexOfTab(source), model->GetIndexOfTab(target),
+                split_tabs::SplitTabArrangement::kLinear)
+            .has_value();
+    if (created && tree_view_) {
+      tree_view_->OnSplitGroupsChanged();
+    }
+    return created;
+  }
+
+  std::vector<std::vector<base::Uuid>> GetSplitSavedPageGroups()
+      const override {
+    std::vector<std::vector<base::Uuid>> groups;
+    if (!tab_strip_model_ || !session_bridge_) {
+      return groups;
+    }
+    for (const split_tabs::SplitTabId split_id :
+         tab_strip_model_->ListSplits()) {
+      const split_tabs::SplitTabData* split_data =
+          tab_strip_model_->GetSplitData(split_id);
+      if (!split_data) {
+        continue;
+      }
+      std::vector<base::Uuid> node_ids;
+      node_ids.reserve(split_data->ListTabs().size());
+      for (tabs::TabInterface* tab : split_data->ListTabs()) {
+        const std::optional<base::Uuid> node_id =
+            session_bridge_->FindTreeNodeIdForTab(tab);
+        if (node_id.has_value()) {
+          node_ids.push_back(*node_id);
+        }
+      }
+      if (node_ids.size() >= 2) {
+        groups.push_back(std::move(node_ids));
+      }
+    }
+    return groups;
+  }
+
+  void OnSidebarDragStateChanged(
+      std::optional<base::Uuid> dragged_node_id) override {
+    dragged_node_id_ = std::move(dragged_node_id);
+    new_group_drop_target_->SetVisible(dragged_node_id_.has_value());
+    InvalidateLayout();
+    SchedulePaint();
+  }
+
+  void ShowNodeContextMenu(const base::Uuid& node_id,
+                           const gfx::Point& screen_point,
+                           ui::mojom::MenuSourceType source_type) override {
+    const tab_tree::TreeNode* node = controller_->view_model().GetNode(node_id);
+    if (!node || !GetWidget()) {
+      return;
+    }
+    context_node_id_ = node_id;
+    context_menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    if (node->type == tab_tree::TreeNodeType::kSavedPage) {
+      context_menu_model_->AddItem(kActivateNode, u"Öffnen");
+      context_menu_model_->AddItem(kCreateGroupAroundNode,
+                                   u"Neue Gruppe mit diesem Tab…");
+    } else {
+      context_menu_model_->AddItem(kCreateSubgroup, u"Neue Untergruppe…");
+    }
+    context_menu_model_->AddSeparator(ui::NORMAL_SEPARATOR);
+    context_menu_model_->AddItem(kRenameNode, u"Umbenennen");
+
+    context_menu_runner_ = std::make_unique<views::MenuRunner>(
+        context_menu_model_.get(),
+        views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+    context_menu_runner_->RunMenuAt(
+        GetWidget(), nullptr, gfx::Rect(screen_point, gfx::Size()),
+        views::MenuAnchorPosition::kTopLeft, source_type);
+    context_menu_runner_.reset();
+    context_menu_model_.reset();
+    context_node_id_.reset();
+  }
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdChecked(int) const override { return false; }
+
+  bool IsCommandIdEnabled(int command_id) const override {
+    if (!context_node_id_.has_value()) {
+      return false;
+    }
+    const tab_tree::TreeNode* node =
+        controller_->view_model().GetNode(*context_node_id_);
+    if (!node) {
+      return false;
+    }
+    switch (command_id) {
+      case kActivateNode:
+      case kCreateGroupAroundNode:
+        return node->type == tab_tree::TreeNodeType::kSavedPage;
+      case kCreateSubgroup:
+        return node->type == tab_tree::TreeNodeType::kFolder;
+      case kRenameNode:
+        return true;
+      default:
+        return false;
+    }
+  }
+
+  void ExecuteCommand(int command_id, int) override {
+    if (!context_node_id_.has_value()) {
+      return;
+    }
+    const base::Uuid node_id = *context_node_id_;
+    const tab_tree::TreeNode* node = controller_->view_model().GetNode(node_id);
+    if (!node) {
+      return;
+    }
+    switch (command_id) {
+      case kActivateNode:
+        ActivateSavedPage(*node);
+        return;
+      case kRenameNode:
+        std::ignore = controller_->SelectNode(node_id);
+        if (tree_view_) {
+          tree_view_->BeginRenameSelectedNode();
+        }
+        return;
+      case kCreateSubgroup:
+        ShowCreateSubgroupDialog(node_id);
+        return;
+      case kCreateGroupAroundNode:
+        ShowCreateGroupDialog(node_id);
+        return;
+      default:
+        return;
+    }
+  }
+
+  void ShowCreateGroupDialog(const base::Uuid& source_node_id) {
+    if (!source_node_id.is_valid()) {
+      return;
+    }
+    ShowGroupDialog(source_node_id, std::nullopt, u"Neue Gruppe");
+  }
+
+  void ShowCreateSubgroupDialog(const base::Uuid& parent_node_id) {
+    if (!parent_node_id.is_valid()) {
+      return;
+    }
+    ShowGroupDialog(std::nullopt, parent_node_id, u"Neue Untergruppe");
+  }
+
+  void ShowGroupDialog(std::optional<base::Uuid> source_node_id,
+                       std::optional<base::Uuid> parent_node_id,
+                       const std::u16string& default_title) {
+    CHECK_NE(source_node_id.has_value(), parent_node_id.has_value());
+    OnSidebarDragStateChanged(std::nullopt);
+    if (group_dialog_widget_) {
+      group_dialog_widget_->Close();
+    }
+    CHECK(!group_dialog_widget_);
+    CHECK(!group_dialog_delegate_);
+
+    pending_group_source_id_ = source_node_id;
+    pending_group_parent_id_ = parent_node_id;
+    auto contents = std::make_unique<views::View>();
+    contents->SetLayoutManager(std::make_unique<views::BoxLayout>(
+        views::BoxLayout::Orientation::kVertical, gfx::Insets(), 8));
+    group_name_field_ =
+        contents->AddChildView(std::make_unique<views::Textfield>());
+    group_name_field_->SetText(default_title);
+    group_name_field_->SetPlaceholderText(u"Gruppenname");
+    group_name_field_->GetViewAccessibility().SetName(u"Gruppenname");
+
+    auto delegate = std::make_unique<views::BubbleDialogDelegate>(
+        workspace_button_, views::BubbleBorder::FLOAT,
+        views::BubbleBorder::DIALOG_SHADOW, /*autosize=*/true);
+    delegate->SetTitle(default_title);
+    delegate->SetButtons(static_cast<int>(ui::mojom::DialogButton::kOk) |
+                         static_cast<int>(ui::mojom::DialogButton::kCancel));
+    delegate->SetButtonLabel(ui::mojom::DialogButton::kOk, u"Erstellen");
+    delegate->SetButtonLabel(ui::mojom::DialogButton::kCancel, u"Abbrechen");
+    delegate->SetAcceptCallback(
+        base::BindOnce(&BrowserSidebarHostView::AcceptCreateGroupDialog,
+                       weak_ptr_factory_.GetWeakPtr()));
+    delegate->SetBackgroundColor(ui::kColorSysSurface2);
+    delegate->set_fixed_width(300);
+    delegate->set_margins(gfx::Insets::VH(14, 14));
+    delegate->SetInitiallyFocusedView(group_name_field_);
+    delegate->SetContentsView(std::move(contents));
+
+    std::unique_ptr<views::Widget> widget =
+        views::BubbleDialogDelegate::CreateBubble(
+            delegate.get(),
+            base::IgnoreArgs<views::Widget::ClosedReason>(base::BindOnce(
+                &BrowserSidebarHostView::OnCreateGroupDialogClosed,
+                weak_ptr_factory_.GetWeakPtr())));
+    if (!widget) {
+      pending_group_source_id_.reset();
+      pending_group_parent_id_.reset();
+      group_name_field_ = nullptr;
+      return;
+    }
+    group_dialog_delegate_ = std::move(delegate);
+    group_dialog_widget_ = std::move(widget);
+    group_dialog_widget_->Show();
+    if (group_name_field_) {
+      group_name_field_->RequestFocus();
+      group_name_field_->SelectAll(false);
+    }
+  }
+
+  void AcceptCreateGroupDialog() {
+    if (!group_name_field_) {
+      return;
+    }
+    const std::u16string title(group_name_field_->GetText());
+    if (pending_group_source_id_.has_value()) {
+      CreateGroupAroundNode(*pending_group_source_id_, title);
+    } else if (pending_group_parent_id_.has_value()) {
+      CreateFolder(*pending_group_parent_id_, title);
+    }
+  }
+
+  void OnCreateGroupDialogClosed() {
+    pending_group_source_id_.reset();
+    pending_group_parent_id_.reset();
+    group_name_field_ = nullptr;
+
+    // A close callback can run from inside the Widget observer iteration
+    // (notably OnWidgetActivationChanged on macOS). Destroying the Widget here
+    // invalidates that observer list while it is being traversed. Tear the
+    // client-owned bubble down on the next task instead, and keep its delegate
+    // alive until after the Widget because BubbleDialogDelegate requires that
+    // lifetime ordering.
+    std::unique_ptr<views::Widget> closed_widget =
+        std::move(group_dialog_widget_);
+    std::unique_ptr<views::BubbleDialogDelegate> closed_delegate =
+        std::move(group_dialog_delegate_);
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](std::unique_ptr<views::Widget> widget,
+               std::unique_ptr<views::BubbleDialogDelegate> delegate) {
+              widget.reset();
+              delegate.reset();
+            },
+            std::move(closed_widget), std::move(closed_delegate)));
+  }
+
+  void CreateGroupAroundNode(const base::Uuid& source_node_id,
+                             std::u16string title) {
+    base::TrimWhitespace(title, base::TRIM_ALL, &title);
+    if (title.empty()) {
+      title = u"Neue Gruppe";
+    }
+    base::Uuid folder_id;
+    const tab_tree::TabTreeStore::Result result =
+        controller_->CreateGroupAroundNode(source_node_id, std::move(title),
+                                           base::Time::Now(), &folder_id);
+    if (result != tab_tree::TabTreeStore::Result::kOk) {
+      OnMutationFailed(result);
+      return;
+    }
+    std::ignore = controller_->SelectNode(folder_id);
+    std::ignore = controller_->ExpandNode(folder_id);
+  }
+
+  void CreateFolder(const base::Uuid& parent_node_id, std::u16string title) {
+    base::TrimWhitespace(title, base::TRIM_ALL, &title);
+    if (title.empty()) {
+      title = u"Neue Untergruppe";
+    }
+    base::Uuid folder_id;
+    const tab_tree::TabTreeStore::Result result = controller_->CreateFolder(
+        parent_node_id, std::move(title), base::Time::Now(), &folder_id);
+    if (result != tab_tree::TabTreeStore::Result::kOk) {
+      OnMutationFailed(result);
+      return;
+    }
+    std::ignore = controller_->ExpandNode(parent_node_id);
+    std::ignore = controller_->SelectNode(folder_id);
+    std::ignore = controller_->ExpandNode(folder_id);
+  }
+
+  // WorkspaceServiceObserver:
+  void OnWorkspaceListChanged() override { ActivateInitialWorkspace(); }
+
+  void OnActiveWorkspaceChanged(
+      const base::Uuid& window_id,
+      const std::optional<base::Uuid>&,
+      const std::optional<base::Uuid>& new_workspace_id,
+      WorkspaceActivationSource) override {
+    if (!window_id_.has_value()) {
+      window_id_ = session_bridge_->GetWindowId(browser_);
+    }
+    if (window_id_ == window_id && new_workspace_id.has_value()) {
+      ActivateWorkspace(*new_workspace_id);
+    }
+  }
+
+  // TabStripModelObserver:
+  void OnTabStripModelChanged(TabStripModel*,
+                              const TabStripModelChange&,
+                              const TabStripSelectionChange&) override {
+    SynchronizeSelection();
+  }
+
+  void OnSplitTabChanged(const SplitTabChange& change) override {
+    if (change.model == tab_strip_model_ && tree_view_) {
+      tree_view_->OnSplitGroupsChanged();
+    }
+    SynchronizeSelection();
+  }
+
+  void OnTabStripModelDestroyed(TabStripModel* tab_strip_model) override {
+    if (tab_strip_model_ == tab_strip_model) {
+      tab_strip_model_ = nullptr;
+    }
+  }
+
+  const raw_ptr<Browser> browser_;
+  const raw_ptr<SessionBridge> session_bridge_;
+  const raw_ptr<WorkspaceService> workspace_service_;
+  raw_ptr<TabStripModel> tab_strip_model_ = nullptr;
+  std::optional<base::Uuid> window_id_;
+  std::unique_ptr<SidebarTreeController> controller_;
+  raw_ptr<SidebarTreeView> tree_view_ = nullptr;
+  raw_ptr<views::LabelButton> workspace_button_ = nullptr;
+  raw_ptr<NewGroupDropTargetView> new_group_drop_target_ = nullptr;
+  std::optional<base::Uuid> dragged_node_id_;
+  std::optional<base::Uuid> pending_group_source_id_;
+  std::optional<base::Uuid> pending_group_parent_id_;
+  raw_ptr<views::Textfield> group_name_field_ = nullptr;
+  std::unique_ptr<views::BubbleDialogDelegate> group_dialog_delegate_;
+  std::unique_ptr<views::Widget> group_dialog_widget_;
+  std::optional<base::Uuid> context_node_id_;
+  std::unique_ptr<ui::SimpleMenuModel> context_menu_model_;
+  std::unique_ptr<views::MenuRunner> context_menu_runner_;
+  base::WeakPtrFactory<BrowserSidebarHostView> weak_ptr_factory_{this};
+};
+
+}  // namespace
+
+std::unique_ptr<views::View> CreateBrowserSidebarHost(Browser* browser) {
+  if (!browser || !browser->is_type_normal() || !browser->profile() ||
+      !browser->profile()->IsRegularProfile() ||
+      browser->profile()->IsOffTheRecord()) {
+    return nullptr;
+  }
+  SessionBridge* session_bridge =
+      SessionBridgeFactory::GetForProfile(browser->profile());
+  WorkspaceService* workspace_service =
+      WorkspaceServiceFactory::GetForProfile(browser->profile());
+  if (!session_bridge || !session_bridge->is_operational() ||
+      !session_bridge->tab_tree_store() || !workspace_service) {
+    return nullptr;
+  }
+  return std::make_unique<BrowserSidebarHostView>(browser, session_bridge,
+                                                  workspace_service);
+}
+
+}  // namespace ahoi::sidebar
