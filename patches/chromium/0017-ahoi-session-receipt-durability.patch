diff --git a/components/sessions/core/command_storage_backend_unittest.cc b/components/sessions/core/command_storage_backend_unittest.cc
--- a/components/sessions/core/command_storage_backend_unittest.cc
+++ b/components/sessions/core/command_storage_backend_unittest.cc
@@ -677,7 +677,32 @@ TEST_P(CommandStorageBackendParamTest,
   EXPECT_TRUE(result.commands.empty());
   EXPECT_FALSE(backend->IsFileOpenForTesting());
 }
+
+TEST_P(CommandStorageBackendParamTest,
+       FlushAndReadCurrentSessionCommandsClosesCorruptFileAndAllowsReset) {
+  scoped_refptr<CommandStorageBackend> backend = CreateBackend();
+  SessionCommands commands;
+  commands.push_back(std::make_unique<SessionCommand>(101, 0));
+  backend->AppendCommands(std::move(commands), /*truncate=*/true,
+                          base::DoNothing());
+  ASSERT_TRUE(base::AppendToFile(backend->current_path_for_testing(),
+                                 "corrupt trailing command"));
 
+  ReadCommandsResult result = backend->FlushAndReadCurrentSessionCommands();
+
+  EXPECT_TRUE(result.error_reading);
+  EXPECT_TRUE(result.commands.empty());
+  EXPECT_FALSE(backend->IsFileOpenForTesting());
+
+  commands.push_back(std::make_unique<SessionCommand>(102, 0));
+  backend->AppendCommands(std::move(commands), /*truncate=*/true,
+                          base::DoNothing());
+  result = backend->FlushAndReadCurrentSessionCommands();
+  EXPECT_FALSE(result.error_reading);
+  ASSERT_EQ(1u, result.commands.size());
+  EXPECT_EQ(102u, result.commands.front()->id());
+}
