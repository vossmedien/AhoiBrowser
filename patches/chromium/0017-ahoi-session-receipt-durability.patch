+bool FlushContainingDirectory(const base::FilePath& file_path) {
+#if BUILDFLAG(IS_POSIX)
+  base::ScopedFD directory_fd(
+      HANDLE_EINTR(open(file_path.DirName().value().c_str(),
+                        O_RDONLY | O_CLOEXEC | O_DIRECTORY | O_NOFOLLOW)));
+  return directory_fd.is_valid() &&
+         HANDLE_EINTR(fsync(directory_fd.get())) == 0;
+#else
+  return !file_path.empty();
+#endif
+}
 
