+void CommandStorageManager::OnCurrentSessionReceiptRead(
+    GetCommandsCallback callback,
+    std::vector<std::unique_ptr<SessionCommand>> commands,
+    bool read_error) {
+  if (read_error) {
+    OnErrorWritingToFile();
+    commands.clear();
+  }
+  std::move(callback).Run(std::move(commands), read_error);
+}
