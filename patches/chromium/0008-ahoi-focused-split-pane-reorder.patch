+bool MultiContentsView::ReorderContentsInSplitView(
+    const std::vector<content::WebContents*>& desired_contents) {
+  const size_t pane_count = GetVisiblePaneCount();
+  if (pane_count < 2u || desired_contents.size() != pane_count) {
+    return false;
+  }
+
+  std::vector<ContentsContainerView*> desired_containers;
+  desired_containers.reserve(pane_count);
+  for (content::WebContents* desired_contents_entry : desired_contents) {
+    if (!desired_contents_entry) {
+      return false;
+    }
+    ContentsContainerView* const container =
+        GetContentsContainerViewFor(desired_contents_entry);
+    if (!container || !container->GetVisible() ||
+        std::ranges::find(desired_containers, container) !=
+            desired_containers.end()) {
+      return false;
+    }
+    desired_containers.push_back(container);
+  }
+
+  ContentsContainerView* const active_container =
+      GetActiveContentsContainerView();
+  for (size_t destination = 0; destination < pane_count; ++destination) {
+    if (contents_container_views_[destination] ==
+        desired_containers[destination]) {
+      continue;
+    }
+    const auto source = std::ranges::find(
+        contents_container_views_.begin() + destination,
+        contents_container_views_.begin() + pane_count,
+        desired_containers[destination]);
+    CHECK(source != contents_container_views_.begin() + pane_count);
+    const size_t source_index =
+        static_cast<size_t>(source - contents_container_views_.begin());
+    ContentsContainerView* const destination_container =
+        contents_container_views_[destination];
+    ContentsContainerView* const source_container =
+        contents_container_views_[source_index];
+    const size_t destination_child_index =
+        GetIndexOf(destination_container).value();
+    const size_t source_child_index = GetIndexOf(source_container).value();
+    ReorderChildView(destination_container, source_child_index);
+    ReorderChildView(source_container, destination_child_index);
+    std::swap(contents_container_views_[destination],
+              contents_container_views_[source_index]);
+  }
+
+  const auto active = std::ranges::find(
+      contents_container_views_.begin(),
+      contents_container_views_.begin() + pane_count, active_container);
+  CHECK(active != contents_container_views_.begin() + pane_count);
+  SetActiveIndex(
+      static_cast<int>(active - contents_container_views_.begin()));
+  return true;
+}
