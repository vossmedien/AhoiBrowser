+def split_depfile_paths(paths):
+  """Splits Makefile-style paths while preserving escaped whitespace."""
+  result = []
+  current = []
+  index = 0
+  while index < len(paths):
+    char = paths[index]
+    if char == '\\' and index + 1 < len(paths) and paths[index + 1] == ' ':
+      # rustc quotes spaces as `\\ ` in its Makefile-style depfile. Decode
+      # only that documented escape and preserve all other backslashes.
+      current.append(' ')
+      index += 2
+      continue
+    elif char.isspace():
+      if current:
+        result.append(''.join(current))
+        current = []
+    else:
+      current.append(char)
+    index += 1
+
+  if current:
+    result.append(''.join(current))
+  return result
+
+
+def escape_depfile_path(path):
+  """Quotes characters in a normalized path that separate Makefile words."""
+  return path.replace(' ', '\\ ')
+
