# Optional. Defaults to <repository>/.work. A Chromium checkout and build need
# substantially more than 100 GiB of free disk space.
AHOI_WORK_ROOT=/absolute/path/to/ahoi-work

# One-run emergency override for the checkout only. The script still refuses
# less than the absolute floor in config/toolchain.json and release builds do
# not use this override.
AHOI_ALLOW_LOW_DISK=0

# Optional build parallelism. Leave unset to let autoninja/siso decide.
AHOI_JOBS=

# Optional side-by-side Xcode override. The pinned default is configured in
# config/toolchain.json and must resolve to Xcode 26.5 (17F42) for M151.
AHOI_XCODE_DEVELOPER_DIR=/Applications/Xcode-26.5.0.app/Contents/Developer

# Reserved for the packaging/signing pipeline. The current Phase-0 build script
# does not sign or consume these values. Never commit certificate exports,
# passwords, API keys, or profiles.
AHOI_CODESIGN_IDENTITY='Developer ID Application: Example Name (ABCDEFGHIJ)'
AHOI_TEAM_ID=ABCDEFGHIJ
