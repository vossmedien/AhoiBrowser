{
  "schemaVersion": 1,
  "provider": "cloudkit-private-database",
  "encryptedValues": true,
  "localFirst": true,
  "enabledByDefault": false,
  "cloudKitContainerBeforeOptIn": false,
  "wireModelVersion": 3,
  "localStoreSchemaVersion": 6,
  "formatContract": "config/sync-format.json",
  "customZoneRequired": true,
  "sync": [
    "devices",
    "deviceCapabilities",
    "deviceSessions",
    "workspaces",
    "treeNodes",
    "bookmarks",
    "treeOrdering",
    "tombstones",
    "deviceTabs",
    "history",
    "appearance",
    "permittedSettings",
    "extensionInventory",
    "optInDeveloperAssets",
    "remoteCommands"
  ],
  "implementedRecords": [
    "devices",
    "deviceCapabilities",
    "deviceSessions",
    "workspaces",
    "treeNodes",
    "bookmarks",
    "treeOrdering",
    "tombstones",
    "deviceTabs",
    "history",
    "appearance",
    "permittedSettings",
    "extensionInventory",
    "optInDeveloperAssets",
    "remoteCommands"
  ],
  "neverSync": [
    "cookies",
    "passwords",
    "autofill",
    "siteData",
    "cache",
    "permissions",
    "extensionStorage",
    "incognito",
    "splitTopology",
    "keychainSecrets",
    "secretHeaders",
    "httpAuthSecrets"
  ],
  "bookmarkCategory": {
    "localConsentRequired": true,
    "enabledByDefault": false,
    "requiresGlobalSync": true,
    "openingLibraryGrantsConsent": false,
    "consentIsSynced": false,
    "decryptBeforeConsent": false,
    "accountChangeRevokesConsent": true
  },
  "historyRetentionDaysDefault": 90,
  "historyRetentionChoices": [30, 90, 365, -1],
  "tombstoneRetentionDays": 30,
  "sessionFreshness": {
    "heartbeatMinutes": 5,
    "actionableMinutes": 15,
    "visibleDays": 7
  },
  "convergence": {
    "fieldClock": "hybrid-logical-clock",
    "treeLocationAtomic": ["workspace_id", "parent_id", "sort_key"],
    "mergedUnionRecordClock": "deterministic-successor",
    "equalClockDifferentValue": "quarantine",
    "invalidRecord": "quarantine-and-advance-token",
    "compactedDeletion": "persistent-watermark-reject-resurrection"
  }
}
