  "components": [
    {
      "id": "lens-desktop",
      "name": "Lens Desktop",
      "decision": "retain-in-wave-1",
      "buildControl": {
        "kind": "gn-arg",
        "name": "enable_lens_desktop",
        "declarationPath": "components/lens/features.gni",
        "expectedDefault": "toolkit_views",
        "profileOverrides": []
      },
      "rationale": "The desktop and Google-branded feature layers are separate in M152; the unbranded product needs a focused dependency and user-journey audit before exclusion.",
      "dependencyRisks": [
        "Disabling the desktop layer without auditing non-Google consumers can remove shared image-search or selection surfaces."
      ],
      "rollback": {
        "strategy": "no-wave-1-change",
        "fallbackProfileId": "ahoi-full-release",
        "requiresRebuild": true
      },
      "rollCheck": {
        "required": true,
        "declarations": ["components/lens/features.gni"],
        "expectedRelations": [
          "enable_lens_desktop = toolkit_views",
          "enable_lens_desktop_google_branded_features = enable_lens_desktop && is_chrome_branded"
        ],
        "failClosedIf": [
          "desktop-and-google-branded-layers-merge",
          "new-unconditional-product-dependency",
          "declaration-missing-or-default-changed"
        ]
      },
      "testIds": ["LEAN-02", "LEAN-03", "LEAN-07", "LEAN-09"]
    },
    {
      "id": "compose",
      "name": "Compose",
      "decision": "exclude-from-lean-profiles",
      "buildControl": {
        "kind": "gn-arg",
        "name": "enable_compose",
        "declarationPath": "components/compose/features.gni",
        "expectedDefault": "is_mac || is_win || is_linux || is_chromeos",
        "leanExplicitValue": false,
        "fullBaselineEffectiveValueOnMac": true
      },
      "rationale": "M152 exposes the dedicated Chromium Compose product slice behind one argument and guards its browser, UI, resources, and WebUI dependency roots.",
      "dependencyRisks": [
        "Compose child BUILD targets assert that the argument is enabled and must remain reachable only through guarded parent edges."
      ],
      "rollback": {
        "strategy": "set-lean-arg-true-or-build-full-profile",
        "gnArg": "enable_compose",
        "rollbackValue": true,
        "fallbackProfileId": "ahoi-full-release",
        "requiresRebuild": true
      },
      "rollCheck": {
        "required": true,
        "declarations": ["components/compose/features.gni"],
        "guardPaths": [
          "build/config/android/internal_rules.gni",
          "chrome/browser/BUILD.gn",
          "chrome/browser/ui/BUILD.gn",
          "chrome/browser/resources/BUILD.gn",
          "chrome/browser/ui/android/bricks/internal/BUILD.gn",
          "chrome/browser/ui/autofill/BUILD.gn",
          "chrome/browser/ui/webui/BUILD.gn",
          "chrome/browser/ui/webui/compose/BUILD.gn",
          "chrome/chrome_paks.gni",
          "chrome/common/features.gni",
          "chrome/test/BUILD.gn",
          "chrome/test/data/webui/BUILD.gn",
          "components/BUILD.gn",
          "components/segmentation_platform/embedder/default_model/BUILD.gn"
        ],
        "assertionPaths": ["chrome/browser/compose/BUILD.gn"],
        "buildflagPath": "components/compose/BUILD.gn",
        "failClosedIf": [
          "gn-arg-missing-or-default-changed",
          "new-unconditional-parent-edge",
          "child-assertion-reachable-while-disabled",
          "settings-or-runtime-registration-remains"
        ]
      },
      "testIds": [
        "LEAN-02",
        "LEAN-03",
        "LEAN-04",
        "LEAN-05",
        "LEAN-06",
        "LEAN-07",
        "LEAN-09",
        "LEAN-10"
      ]
    },
    {
      "id": "structured-metrics",
      "name": "Structured Metrics",
      "decision": "retain-in-wave-1",
      "buildControl": {
        "kind": "gn-arg",
        "name": "structured_metrics_enabled",
        "declarationPath": "components/metrics/structured/buildflags/buildflags.gni",
        "expectedDefault": "is_win || is_mac || is_linux || is_chromeos",
        "profileOverrides": []
      },
      "rationale": "M152 references the validator and feature layer from browser, app-service, metrics, and diagnostic targets; compilation and runtime/upload policy must be audited separately.",
      "dependencyRisks": [
        "A build-only switch does not by itself prove that settings, registration, persistence, scheduling, or upload paths are absent."
      ],
      "rollback": {
        "strategy": "no-wave-1-change",
        "fallbackProfileId": "ahoi-full-release",
        "requiresRebuild": true
      },
      "rollCheck": {
        "required": true,
        "declarations": [
          "components/metrics/structured/buildflags/buildflags.gni"
        ],
        "dependencyRoots": [
          "components/metrics/structured/BUILD.gn",
          "chrome/browser/metrics/BUILD.gn",
          "chrome/browser/metrics/structured/BUILD.gn"
        ],
        "failClosedIf": [
          "buildflag-removed-or-renamed",
          "runtime-policy-not-audited",
          "shared-metrics-dependency-cannot-be-separated"
        ]
      },
      "testIds": ["LEAN-02", "LEAN-03", "LEAN-05", "LEAN-07", "LEAN-09"]
    },
    {
      "id": "pdf-save-to-drive",
      "name": "PDF Save to Drive",
      "decision": "exclude-from-lean-profiles",
      "buildControl": {
        "kind": "gn-arg",
        "name": "enable_pdf_save_to_drive",
        "declarationPath": "pdf/features.gni",
        "expectedDefault": "enable_pdf",
        "leanExplicitValue": false,
        "fullBaselineEffectiveValueOnMac": true
      },
      "rationale": "The Google Drive export integration is separable in M152 and is not core PDF viewing, saving, annotation, or printing.",
      "dependencyRisks": [
        "Save-to-Drive child targets assert that the argument is enabled; all browser, UI, and Views roots must remain guarded.",
        "The independent enable_pdf and enable_pdf_ink2 arguments must not change.",
        "Generic Drive or composebox code used by other features may remain and must not be reported as a failed dedicated-slice exclusion."
      ],
      "protectedCapabilities": ["core-pdf", "printing"],
      "rollback": {
        "strategy": "set-lean-arg-true-or-build-full-profile",
        "gnArg": "enable_pdf_save_to_drive",
        "rollbackValue": true,
        "fallbackProfileId": "ahoi-full-release",
        "requiresRebuild": true
      },
      "rollCheck": {
        "required": true,
        "declarations": ["pdf/features.gni"],
        "guardPaths": [
          "pdf/BUILD.gn",
          "pdf/mojom/BUILD.gn",
          "chrome/browser/resources/pdf/BUILD.gn",
          "chrome/browser/ui/BUILD.gn",
          "chrome/browser/ui/hats/BUILD.gn",
          "chrome/browser/extensions/api/pdf_viewer_private/BUILD.gn",
          "chrome/common/BUILD.gn",
          "chrome/common/features.gni",
          "chrome/test/BUILD.gn",
          "chrome/test/data/pdf/BUILD.gn",
          "components/strings/BUILD.gn"
        ],
        "assertionPaths": [
          "chrome/browser/save_to_drive/BUILD.gn",
          "chrome/browser/ui/save_to_drive/BUILD.gn",
          "chrome/browser/ui/views/save_to_drive/BUILD.gn"
        ],
        "requiredIndependentControls": ["enable_pdf", "enable_pdf_ink2"],
        "failClosedIf": [
          "gn-arg-missing-or-default-changed",
          "new-unconditional-parent-edge",
          "child-assertion-reachable-while-disabled",
          "core-pdf-or-printing-control-changed"
        ]
      },
      "testIds": [
        "LEAN-02",
        "LEAN-03",
        "LEAN-04",
        "LEAN-05",
        "LEAN-06",
        "LEAN-07",
        "LEAN-09",
        "LEAN-10"
      ]
    },
    {
      "id": "legacy-platform-apps",
      "name": "Legacy Platform Apps",
      "decision": "retain-in-wave-1",
      "buildControl": {
        "kind": "gn-arg",
        "name": "enable_platform_apps",
        "declarationPath": "extensions/buildflags/buildflags.gni",
        "expectedDefault": "enable_extensions",
        "profileOverrides": []
      },
      "rationale": "The M152 buildflag inherits enable_extensions. Wave 1 must not weaken extension, Native Messaging, or background-extension capability through a broad coupled switch.",
      "dependencyRisks": [
        "Platform-app APIs and extension consumers remain spread across browser, UI, profile, file-system, media, session, and background targets."
      ],
      "protectedCapabilities": [
        "extensions",
        "native-messaging",
        "background-extensions"
      ],
      "rollback": {
        "strategy": "no-wave-1-change",
        "fallbackProfileId": "ahoi-full-release",
        "requiresRebuild": true
      },
      "rollCheck": {
        "required": true,
        "declarations": ["extensions/buildflags/buildflags.gni"],
        "expectedRelations": ["enable_platform_apps = enable_extensions"],
        "dependencyRoots": [
          "chrome/browser/apps/platform_apps/BUILD.gn",
          "chrome/common/apps/platform_apps/BUILD.gn",
          "chrome/browser/extensions/BUILD.gn"
        ],
        "failClosedIf": [
          "extension-coupling-changed",
          "selected-extension-e2e-not-green",
          "native-messaging-or-background-capability-regresses"
        ]
      },
      "testIds": ["LEAN-02", "LEAN-03", "LEAN-07", "LEAN-08", "LEAN-09"]
    },
    {
      "id": "legacy-hosted-apps",
      "name": "Legacy Hosted Apps",
      "decision": "retain-in-wave-1",
      "buildControl": {
        "kind": "gn-arg",
        "name": "enable_hosted_apps",
        "declarationPath": "extensions/buildflags/buildflags.gni",
        "expectedDefault": "enable_extensions",
        "profileOverrides": []
      },
      "rationale": "The M152 buildflag also inherits enable_extensions. A later removal needs its own graph, browsing-data, migration, policy, and installed-extension audit.",
      "dependencyRisks": [
        "Hosted-app data counters and extension migration or policy paths can outlive a superficial UI removal."
      ],
      "protectedCapabilities": [
        "extensions",
        "native-messaging",
        "background-extensions"
      ],
      "rollback": {
        "strategy": "no-wave-1-change",
        "fallbackProfileId": "ahoi-full-release",
        "requiresRebuild": true
      },
      "rollCheck": {
        "required": true,
        "declarations": ["extensions/buildflags/buildflags.gni"],
        "expectedRelations": ["enable_hosted_apps = enable_extensions"],
        "dependencyRoots": ["chrome/browser/browsing_data/BUILD.gn"],
        "failClosedIf": [
          "extension-coupling-changed",
          "migration-policy-or-data-path-not-audited",
          "selected-extension-e2e-not-green"
        ]
      },
      "testIds": ["LEAN-02", "LEAN-03", "LEAN-04", "LEAN-07", "LEAN-08", "LEAN-09"]
    }
  ]
