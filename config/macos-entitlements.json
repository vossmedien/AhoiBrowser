{
  "schemaVersion": 1,
  "chromiumCommit": "fc4d67f1788019a27e32511137ceccbd2fafdaaa",
  "chromiumVersion": "152.0.7977.65",
  "frameworkVersion": "152.0.7977.65",
  "upstreamPolicySource": "Chromium 152.0.7977.65 chrome/installer/mac/signing/parts.py, chrome/app/*-entitlements.plist, chrome/version.gni and chrome/BUILD.gn",
  "rules": [
    {
      "id": "browser-app",
      "pathPattern": "^Contents/MacOS/AhoiBrowser$",
      "entitlements": {
        "com.apple.security.device.audio-input": true,
        "com.apple.security.device.bluetooth": true,
        "com.apple.security.device.camera": true,
        "com.apple.security.device.print": true,
        "com.apple.security.device.usb": true,
        "com.apple.security.personal-information.location": true,
        "com.apple.security.personal-information.photos-library": true
      }
    },
    {
      "id": "renderer-helper",
      "pathPattern": "^Contents/Frameworks/AhoiBrowser Framework\\.framework/Versions/152\\.0\\.7977\\.65/Helpers/AhoiBrowser Helper \\(Renderer\\)\\.app/Contents/MacOS/AhoiBrowser Helper \\(Renderer\\)$",
      "entitlements": {
        "com.apple.security.cs.allow-jit": true
      }
    },
    {
      "id": "gpu-helper",
      "pathPattern": "^Contents/Frameworks/AhoiBrowser Framework\\.framework/Versions/152\\.0\\.7977\\.65/Helpers/AhoiBrowser Helper \\(GPU\\)\\.app/Contents/MacOS/AhoiBrowser Helper \\(GPU\\)$",
      "entitlements": {
        "com.apple.security.cs.allow-jit": true
      }
    },
    {
      "id": "framework",
      "pathPattern": "^Contents/Frameworks/AhoiBrowser Framework\\.framework/Versions/152\\.0\\.7977\\.65/AhoiBrowser Framework$",
      "entitlements": {}
    },
    {
      "id": "crashpad",
      "pathPattern": "^Contents/Frameworks/AhoiBrowser Framework\\.framework/Versions/152\\.0\\.7977\\.65/Helpers/chrome_crashpad_handler$",
      "entitlements": {}
    },
    {
      "id": "generic-helper",
      "pathPattern": "^Contents/Frameworks/AhoiBrowser Framework\\.framework/Versions/152\\.0\\.7977\\.65/Helpers/AhoiBrowser Helper\\.app/Contents/MacOS/AhoiBrowser Helper$",
      "entitlements": {}
    },
    {
      "id": "alerts-helper",
      "pathPattern": "^Contents/Frameworks/AhoiBrowser Framework\\.framework/Versions/152\\.0\\.7977\\.65/Helpers/AhoiBrowser Helper \\(Alerts\\)\\.app/Contents/MacOS/AhoiBrowser Helper \\(Alerts\\)$",
      "entitlements": {}
    },
    {
      "id": "app-mode-loader",
      "pathPattern": "^Contents/Frameworks/AhoiBrowser Framework\\.framework/Versions/152\\.0\\.7977\\.65/Helpers/app_mode_loader$",
      "entitlements": {}
    },
    {
      "id": "web-app-shortcut-copier",
      "pathPattern": "^Contents/Frameworks/AhoiBrowser Framework\\.framework/Versions/152\\.0\\.7977\\.65/Helpers/web_app_shortcut_copier$",
      "entitlements": {}
    },
    {
      "id": "chromium-library",
      "pathPattern": "^Contents/Frameworks/AhoiBrowser Framework\\.framework/Versions/152\\.0\\.7977\\.65/Libraries/(?:libEGL|libGLESv2|libvk_swiftshader|libvulkan)\\.dylib$",
      "entitlements": {}
    },
    {
      "id": "sparkle-framework",
      "pathPattern": "^Contents/Frameworks/Sparkle\\.framework/Versions/[^/]+/Sparkle$",
      "entitlements": {}
    },
    {
      "id": "sparkle-autoupdate",
      "pathPattern": "^Contents/Frameworks/Sparkle\\.framework/Versions/[^/]+/Autoupdate$",
      "entitlements": {}
    },
    {
      "id": "sparkle-updater-app",
      "pathPattern": "^Contents/Frameworks/Sparkle\\.framework/Versions/[^/]+/Updater\\.app/Contents/MacOS/Updater$",
      "entitlements": {}
    },
    {
      "id": "sparkle-downloader-xpc",
      "pathPattern": "^Contents/Frameworks/Sparkle\\.framework/Versions/[^/]+/XPCServices/Downloader\\.xpc/Contents/MacOS/Downloader$",
      "entitlements": {}
    },
    {
      "id": "sparkle-installer-xpc",
      "pathPattern": "^Contents/Frameworks/Sparkle\\.framework/Versions/[^/]+/XPCServices/Installer\\.xpc/Contents/MacOS/Installer$",
      "entitlements": {}
    }
  ]
}
