{
  "schemaVersion": 1,
  "gates": {
    "proprietaryCodecs": {
      "default": false,
      "requires": ["legal-review", "distribution-review", "runtime-e2e"]
    },
    "widevine": {
      "default": false,
      "requires": ["cdm-license", "distribution-approval", "runtime-e2e"]
    },
    "selectiveUboClassicMv2": {
      "default": false,
      "dogfoodBuildProfiles": ["dev"],
      "requires": ["signed-browser-static-bootstrap", "package-and-key-hash", "normal-permission-prompt", "runtime-e2e"]
    },
    "crashUpload": {
      "default": false,
      "requires": ["explicit-user-opt-in", "privacy-review"]
    }
  }
}
