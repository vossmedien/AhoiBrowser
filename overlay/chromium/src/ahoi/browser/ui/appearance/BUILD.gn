import("//testing/test.gni")

source_set("appearance_preferences") {
  sources = [
    "appearance_prefs.cc",
    "appearance_prefs.h",
  ]

  public_deps = [ "//base" ]

  deps = [
    "//components/prefs",
    "//components/sync_preferences",
  ]
}

# The spec palette values. Kept dependency-free so the Chrome colour pipeline
# can consume them without pulling in the views-based appearance code.
source_set("opaque_palette") {
  sources = [
    "opaque_palette.cc",
    "opaque_palette.h",
  ]

  public_deps = [ "//skia" ]
}

# Linked into //chrome/browser/ui/color:mixers (patch 0082). It must not depend
# on //chrome/browser/ui/color:mixers or anything that links it.
source_set("ahoi_color_mixer") {
  sources = [
    "ahoi_color_mixer.cc",
    "ahoi_color_mixer.h",
  ]

  deps = [
    ":opaque_palette",
    "//chrome/browser/ui/color:color_headers",
    "//skia",
    "//ui/color",
  ]
}

source_set("appearance") {
  sources = [
    "appearance_policy.cc",
    "appearance_policy.h",
    "appearance_runtime_signals.cc",
    "appearance_runtime_signals.h",
    "appearance_views.cc",
    "appearance_views.h",
    "glass_material.cc",
    "glass_material.h",
    "native_panel_material.cc",
    "native_panel_material.h",
    "sidebar_page_tint.cc",
    "sidebar_page_tint.h",
    "sidebar_tint_transition.cc",
    "sidebar_tint_transition.h",
  ]

  public_deps = [
    ":appearance_preferences",
    ":opaque_palette",
    "//base",
    "//skia",
    "//ui/color",
    "//ui/gfx",
    "//ui/gfx/animation",
    "//ui/native_theme",
    "//ui/views",
  ]

  deps = [
    "//ahoi/browser/ui:visual_style",
    "//cc/paint",
    "//components/prefs",
    "//ui/base",
    "//ui/compositor",
  ]

  if (is_mac) {
    sources += [
      "native_glass_bridge.cc",
      "native_glass_bridge.h",
      "native_glass_bridge_mac.mm",
    ]
    frameworks = [
      "AppKit.framework",
      "QuartzCore.framework",
    ]
  }
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "ahoi_color_mixer_unittest.cc",
    "appearance_policy_unittest.cc",
    "appearance_prefs_unittest.cc",
    "appearance_runtime_signals_unittest.cc",
    "glass_material_unittest.cc",
    "opaque_palette_unittest.cc",
    "sidebar_page_tint_unittest.cc",
  ]
  if (is_mac) {
    sources += [ "native_glass_bridge_unittest.cc" ]
  }
  deps = [
    ":ahoi_color_mixer",
    ":appearance",
    ":opaque_palette",
    "//base/test:test_support",
    "//chrome/browser/ui/color:color_headers",
    "//components/sync_preferences:test_support",
    "//skia",
    "//testing/gtest",
    "//ui/color",
  ]
}

if (!is_android && !is_chromeos) {
  source_set("settings_browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [ "appearance_settings_browsertest.cc" ]
    deps = [
      "//base/test:test_support",
      "//chrome/browser/glic",
      "//chrome/browser/glic/test_support",
      "//chrome/browser/ui/webui/settings",
      "//chrome/common",
      "//chrome/test:test_support",
      "//content/test:test_support",
      "//testing/gtest",
    ]
  }
}

test("ahoi_appearance_unittests") {
  sources = [ "run_all_unittests.cc" ]
  deps = [
    ":unit_tests",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}

if (!is_android && !is_chromeos) {
  test("ahoi_appearance_settings_browsertests") {
    deps = [
      ":settings_browser_tests",
      "//chrome:packed_resources",
      "//chrome/test:browser_tests_runner",
      "//chrome/test:test_support",
    ]
    data_deps = [ "//chrome:browser_tests_pak" ]
  }
}
