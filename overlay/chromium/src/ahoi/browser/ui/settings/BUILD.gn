import("//testing/test.gni")

# Pure WebUI model of the external-link routing editor.
source_set("link_routing_settings_model") {
  sources = [
    "link_routing_settings_model.cc",
    "link_routing_settings_model.h",
  ]
  public_deps = [
    "//ahoi/browser/navigation:link_routing",
    "//base",
  ]
  deps = [
    "//base:i18n",
    "//url",
  ]
}

# Pure WebUI model of the keyboard shortcut editor.
source_set("shortcut_settings_model") {
  sources = [
    "shortcut_settings_model.cc",
    "shortcut_settings_model.h",
  ]
  public_deps = [
    "//ahoi/browser/navigation:keyboard_shortcuts",
    "//base",
    "//ui/base",
  ]
  deps = [
    "//base:i18n",
    "//components/prefs",
    "//ui/events",
  ]
}

if (is_mac) {
  source_set("settings_handler") {
    sources = [
      "ahoi_settings_handler.cc",
      "ahoi_settings_handler.h",
      "ahoi_settings_link_routing.cc",
      "ahoi_settings_portability.cc",
      "ahoi_settings_shortcuts.cc",
    ]
    public_deps = [
      ":link_routing_settings_model",
      ":shortcut_settings_model",
      "//ahoi/browser/session:session_bridge_api",
      "//ahoi/browser/session:workspace_portability",
      "//ahoi/browser/sync:profile_sync_service",
      "//ahoi/browser/tab_tree",
      "//base",
      "//chrome/browser/profiles:profile",
      "//chrome/browser/ui/select_file_policy",
      "//components/prefs",
      "//content/public/browser",
      "//ui/shell_dialogs",
    ]
    deps = [
      "//ahoi/browser/navigation",
      "//ahoi/browser/navigation:link_routing",
      "//ahoi/browser/session:isolated_profiles",
      "//ui/base/accelerators/global_accelerator_listener",
    ]
  }
}

if (!is_android) {
  source_set("settings_browser_tests") {
    testonly = true
    defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
    sources = [ "ahoi_settings_browsertest.cc" ]
    deps = [
      "//ahoi/browser/developer_toolkit:developer_toolkit_preferences",
      "//base",
      "//chrome/browser",
      "//chrome/browser/ui",
      "//chrome/test:test_support",
      "//components/prefs",
      "//content/test:test_support",
      "//testing/gtest",
    ]
  }

  test("ahoi_settings_private_unittests") {
    sources = [
      "link_routing_settings_model_unittest.cc",
      "settings_private_prefs_unittest.cc",
      "shortcut_settings_model_unittest.cc",
    ]

    deps = [
      ":link_routing_settings_model",
      ":shortcut_settings_model",
      "//components/sync_preferences:test_support",
      "//ui/events",
      "//ahoi/browser/developer_toolkit:developer_toolkit_preferences",
      "//ahoi/browser/session:session_preferences",
      "//ahoi/browser/sync:profile_sync_preferences",
      "//ahoi/browser/ui/appearance:appearance_preferences",
      "//base",
      "//base/test:test_support",
      "//chrome/browser/extensions",
      "//chrome/test:test_support_unit",
      "//components/prefs",
      "//content/test:test_support",
      "//testing/gtest",
    ]

    if (is_mac) {
      data_deps = [ "//third_party/sparkle:sparkle_framework_test_runtime" ]
    }
  }

  test("ahoi_settings_browsertests") {
    deps = [
      ":settings_browser_tests",
      "//chrome:packed_resources",
      "//chrome/test:browser_tests_runner",
      "//chrome/test:test_support",
    ]
  }
}
