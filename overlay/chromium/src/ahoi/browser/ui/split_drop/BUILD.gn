import("//testing/test.gni")

source_set("split_drop") {
  sources = [
    "split_drop_controller.cc",
    "split_drop_controller.h",
    "split_drop_intent.cc",
    "split_drop_intent.h",
    "split_drop_overlay_view.cc",
    "split_drop_overlay_view.h",
    "split_keyboard_actions.cc",
    "split_keyboard_actions.h",
    "split_pane_binding_lifecycle.h",
  ]

  public_deps = [
    "//ahoi/browser/ui/drag:sidebar_tab_drag_payload",
    "//base",
    "//components/split_tabs",
    "//content/public/browser",
    "//ui/base",
    "//ui/gfx",
    "//ui/views",
  ]

  deps = [
    "//ahoi/browser/ui:visual_style",
    "//ahoi/browser/ui/sidebar:browser_sidebar",
    "//cc/paint",
    "//chrome/browser:browser_public_dependencies",
    "//chrome/browser/ui/tabs:tab_strip",
    "//components/tabs:public",
    "//skia",
    "//ui/color",
    "//ui/compositor",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "sidebar_tab_drag_payload_unittest.cc",
    "split_drop_intent_unittest.cc",
    "split_drop_overlay_view_unittest.cc",
    "split_keyboard_actions_unittest.cc",
    "split_pane_binding_lifecycle_unittest.cc",
  ]
  deps = [
    ":split_drop",
    "//base/test:test_support",
    "//testing/gtest",
    "//ui/base",
  ]
}

test("ahoi_split_drop_unittests") {
  sources = [ "run_all_unittests.cc" ]
  deps = [
    ":unit_tests",
    "//mojo/core/embedder",
    "//testing/gtest",
    "//ui/resources:ui_test_pak",
    "//ui/views:test_support",
  ]
  data_deps = [ "//ui/resources:ui_test_pak_data" ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "split_layout_menu_browsertest.cc" ]
  deps = [
    "//ahoi/browser/ui/sidebar:browser_sidebar",
    "//chrome/browser",
    "//chrome/browser/ui",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//components/split_tabs",
    "//components/tabs:public",
    "//content/test:test_support",
    "//testing/gtest",
  ]
}

if (!is_android) {
  test("ahoi_split_layout_browsertests") {
    deps = [
      ":browser_tests",
      "//chrome:packed_resources",
      "//chrome/test:browser_tests_runner",
      "//chrome/test:test_support",
    ]
  }
}
