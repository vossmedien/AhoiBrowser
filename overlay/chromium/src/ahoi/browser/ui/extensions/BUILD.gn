import("//testing/test.gni")

source_set("ubo_install_presenter") {
  sources = [
    "ubo_install_presenter.cc",
    "ubo_install_presenter.h",
  ]
  public_deps = [
    "//ahoi/browser/extensions:service",
    "//base",
  ]
  deps = [ "//chrome/app:generated_resources" ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "ubo_install_presenter_unittest.cc" ]
  deps = [
    ":ubo_install_presenter",
    "//ahoi/browser/extensions:service",
    "//chrome/app:generated_resources",
    "//testing/gtest",
  ]
}

test("ahoi_extension_ui_unittests") {
  deps = [
    ":unit_tests",
    "//base/test:run_all_unittests",
    "//testing/gtest",
  ]
}
