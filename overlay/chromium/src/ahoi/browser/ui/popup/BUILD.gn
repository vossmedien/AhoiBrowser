import("//testing/test.gni")

source_set("popup_overlay") {
  sources = [
    "popup_overlay_controller.cc",
    "popup_overlay_controller.h",
    "popup_overlay_view.cc",
    "popup_overlay_view.h",
  ]

  public_deps = [
    "//ahoi/browser/popup",
    "//base",
    "//components/tabs:public",
    "//content/public/browser",
    "//ui/base",
    "//ui/views",
  ]

  deps = [
    ":popup_overlay_layout",
    "//ahoi/browser/ui:visual_style",
    "//ahoi/browser/ui/appearance",
    "//chrome/app:generated_resources",
    "//chrome/app/vector_icons",
    "//chrome/browser:browser_public_dependencies",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/tabs:tab_strip",
    "//components/split_tabs",
    "//components/vector_icons",
    "//ui/accessibility",
    "//ui/color",
    "//ui/compositor",
    "//ui/events",
    "//ui/gfx",
    "//url",
  ]
}

source_set("popup_overlay_layout") {
  sources = [
    "popup_overlay_layout.cc",
    "popup_overlay_layout.h",
  ]

  public_deps = [
    "//ahoi/browser/ui:visual_style",
    "//ui/gfx",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [ "popup_overlay_layout_unittest.cc" ]
  deps = [
    ":popup_overlay_layout",
    "//testing/gtest",
    "//ui/gfx:test_support",
  ]
}

test("ahoi_popup_ui_unittests") {
  deps = [
    ":unit_tests",
    "//base/test:run_all_unittests",
    "//testing/gtest",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "popup_overlay_browsertest.cc" ]
  deps = [
    ":popup_overlay",
    "//chrome/browser",
    "//chrome/browser/ui",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//content/public/browser",
    "//content/test:test_support",
    "//testing/gtest",
    "//ui/base",
    "//ui/events",
    "//ui/gfx",
    "//ui/views",
  ]
}

if (!is_android) {
  test("ahoi_popup_overlay_browsertests") {
    deps = [
      ":browser_tests",
      "//chrome:packed_resources",
      "//chrome/test:browser_tests_runner",
      "//chrome/test:test_support",
    ]
  }
}
