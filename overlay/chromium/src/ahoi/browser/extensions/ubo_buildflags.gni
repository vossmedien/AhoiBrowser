declare_args() {
  # uBlock Origin Classic keeps a narrowly scoped MV2 exception and therefore
  # ships in every supported AhoiBrowser desktop profile. Embedders may still
  # explicitly opt out, which revokes stale authorization fail-closed.
  enable_ahoi_ubo_classic = true
}
