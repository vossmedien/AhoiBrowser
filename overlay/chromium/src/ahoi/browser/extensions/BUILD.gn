import("//ahoi/browser/extensions/ubo_buildflags.gni")
import("//build/buildflag_header.gni")
import("//testing/test.gni")

buildflag_header("buildflags") {
  header = "ubo_buildflags.h"
  flags = [ "ENABLE_AHOI_UBO_CLASSIC=$enable_ahoi_ubo_classic" ]
}

source_set("policy") {
  sources = [
    "ubo_authorization.cc",
    "ubo_authorization.h",
    "ubo_catalog.cc",
    "ubo_catalog.h",
    "ubo_migration_state.cc",
    "ubo_migration_state.h",
    "ubo_package_verifier.cc",
    "ubo_package_verifier.h",
    "ubo_product_config.cc",
    "ubo_product_config.h",
  ]
  public_deps = [
    ":buildflags",
    "//base",
    "//components/prefs",
    "//components/sync_preferences",
    "//extensions/common",
    "//url",
  ]
  deps = [
    "//components/crx_file",
    "//components/pref_registry",
    "//crypto",
    "//third_party/boringssl",
  ]
}

source_set("runtime") {
  sources = [
    "ubo_install_coordinator.cc",
    "ubo_install_coordinator.h",
  ]
  public_deps = [
    ":policy",
    "//base",
  ]
  deps = [
    "//chrome/browser/extensions",
    "//chrome/browser/profiles:profile",
    "//components/crx_file",
    "//content/public/browser",
    "//extensions/browser",
    "//extensions/browser:crx_installer",
  ]
}

source_set("service") {
  sources = [
    "ubo_extension_inventory.cc",
    "ubo_extension_inventory.h",
    "ubo_network_client.h",
    "ubo_service.cc",
    "ubo_service.h",
    "ubo_service_factory.cc",
    "ubo_service_factory.h",
    "ubo_simple_url_loader_client.cc",
    "ubo_simple_url_loader_client.h",
  ]
  public_deps = [
    ":policy",
    ":runtime",
    "//base",
    "//chrome/browser/profiles:profile",
    "//components/keyed_service/core",
    "//content/public/browser",
    "//extensions/browser",
    "//services/network/public/cpp",
    "//url",
  ]
  deps = [
    "//net",
    "//services/network/public/mojom",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "ubo_authorization_unittest.cc",
    "ubo_catalog_unittest.cc",
    "ubo_service_unittest.cc",
  ]
  deps = [
    ":policy",
    ":service",
    "//base/test:test_support",
    "//chrome/test:test_support",
    "//components/sync_preferences:test_support",
    "//content/test:test_support",
    "//crypto",
    "//crypto:test_support",
    "//extensions:test_support",
    "//extensions/common",
    "//testing/gtest",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "ubo_service_browsertest.cc" ]
  deps = [
    ":service",
    "//ahoi/browser/ui/extensions:ubo_install_presenter",
    "//base",
    "//base/test:test_support",
    "//chrome/browser",
    "//chrome/browser/extensions",
    "//chrome/browser/ui",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/test:test_support",
    "//chrome/test:test_support_ui",
    "//components/constrained_window",
    "//content/public/browser",
    "//content/test:test_support",
    "//extensions/browser",
    "//extensions/common",
    "//testing/gtest",
    "//ui/views",
    "//ui/views:test_support",
  ]
}

test("ahoi_extension_policy_unittests") {
  if (is_mac) {
    data_deps = [ "//third_party/sparkle:sparkle_framework_test_runtime" ]
  }
  deps = [
    ":unit_tests",
    "//chrome/test:test_support_unit",
    "//testing/gtest",
  ]
}

if (!is_android) {
  test("ahoi_ubo_browsertests") {
    deps = [
      ":browser_tests",
      "//chrome:packed_resources",
      "//chrome/test:browser_tests_runner",
      "//chrome/test:test_support",
    ]
  }
}
