import("//testing/test.gni")

source_set("navigation_preferences") {
  sources = [
    "navigation_input_prefs.cc",
    "navigation_input_prefs.h",
  ]
  public_deps = [
    ":navigation",
    "//components/prefs",
    "//components/sync_preferences",
  ]
  deps = [ ":link_routing" ]
}

# Pure external-link routing model, matcher and pref codec.
source_set("link_routing") {
  sources = [
    "link_routing.cc",
    "link_routing.h",
  ]
  public_deps = [
    "//base",
    "//url",
  ]
  deps = [ "//components/prefs" ]
}

# Opens routed external links in their target Workspace. Depended on only by
# the macOS app controller seam (patch 0057); it must not depend on
# //chrome/browser/ui or //chrome/browser:browser.
source_set("link_routing_dispatch") {
  sources = [
    "link_routing_dispatch.cc",
    "link_routing_dispatch.h",
  ]
  public_deps = [
    ":link_routing",
    "//base",
    "//url",
  ]
  deps = [
    ":navigation",
    "//ahoi/browser/command_bar:quick_window_policy",
    "//ahoi/browser/session:isolated_profiles",
    "//ahoi/browser/session:session_bridge_api",
    "//ahoi/browser/session:session_preferences",
    "//chrome/app:generated_resources",
    "//chrome/browser:browser_process",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/profiles:profile_manager",
    "//chrome/browser/ui/browser_window",
    "//chrome/browser/ui/browser_window:create_browser_window",
    "//components/prefs",
    "//ui/base",
    "//ui/display",
    "//ui/gfx/geometry",
  ]
}

source_set("navigation") {
  sources = [
    "cmd_scroll_tab_switcher.cc",
    "cmd_scroll_tab_switcher.h",
    "command_service.cc",
    "command_service.h",
    "workspace_service.cc",
    "workspace_service.h",
    "workspace_swipe_event_handler.cc",
    "workspace_swipe_event_handler.h",
    "workspace_swipe_tracker.cc",
    "workspace_swipe_tracker.h",
  ]

  if (is_mac) {
    sources += [ "workspace_swipe_event_handler_mac.mm" ]
  }

  public_deps = [
    "//ahoi/browser/tab_tree",
    "//base",
    "//components/keyed_service/core",
    "//url",
  ]

  deps = [
    "//base:i18n",
    "//components/omnibox/browser:location_bar",
    "//ui/events",
    "//ui/views",
  ]
}

source_set("unit_tests") {
  testonly = true
  sources = [
    "cmd_scroll_tab_switcher_unittest.cc",
    "command_service_unittest.cc",
    "link_routing_unittest.cc",
    "navigation_input_prefs_unittest.cc",
    "workspace_service_unittest.cc",
    "workspace_swipe_event_handler_unittest.cc",
    "workspace_swipe_tracker_unittest.cc",
  ]
  deps = [
    ":link_routing",
    ":navigation",
    ":navigation_preferences",
    "//base/test:test_support",
    "//components/omnibox/browser:location_bar",
    "//components/prefs:test_support",
    "//components/sync_preferences:test_support",
    "//testing/gtest",
    "//ui/events",
  ]
}

test("ahoi_navigation_unittests") {
  deps = [
    ":unit_tests",
    "//base/test:run_all_unittests",
    "//testing/gtest",
  ]
}
