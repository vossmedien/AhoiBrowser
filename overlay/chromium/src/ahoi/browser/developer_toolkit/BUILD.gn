import("//testing/test.gni")

source_set("developer_profile_core") {
  sources = [
    "developer_asset_codec.cc",
    "developer_asset_codec.h",
    "developer_asset_validation.cc",
    "developer_asset_validation.h",
    "developer_profile_codec.cc",
    "developer_profile_codec.h",
    "developer_profile_integration.cc",
    "developer_profile_integration.h",
    "developer_profile_prefs.cc",
    "developer_profile_prefs.h",
    "developer_profile_store.cc",
    "developer_profile_store.h",
    "developer_profile_text_codec.cc",
    "developer_profile_text_codec.h",
    "developer_profile_types.h",
    "developer_profile_validation.cc",
    "developer_profile_validation.h",
    "developer_secret_store.cc",
    "developer_secret_store.h",
    "developer_style_compiler.cc",
    "developer_style_compiler.h",
  ]

  public_deps = [
    "//base",
    "//components/prefs",
    "//url",
  ]
  deps = [ "//components/pref_registry" ]

  if (is_mac) {
    sources += [ "developer_secret_store_mac.mm" ]
    deps += [ "//crypto" ]
    frameworks = [
      "Foundation.framework",
      "Security.framework",
    ]
  } else {
    sources += [ "developer_secret_store_stub.cc" ]
  }
}

# The compiler implementation deliberately stays out of browser-side toolkit
# targets. Production code reaches it only through the sandboxed Utility
# service below; unit tests link it explicitly.
