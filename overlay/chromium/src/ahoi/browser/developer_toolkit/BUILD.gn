source_set("unit_tests") {
  testonly = true
  sources = [
    "developer_asset_sync_unittest.cc",
    "developer_cookie_chromium_adapter_unittest.cc",
    "developer_cookie_manager_unittest.cc",
    "developer_header_materialization_unittest.cc",
    "developer_profile_runtime_unittest.cc",
    "developer_profile_unittest.cc",
    "developer_style_preprocessor_unittest.cc",
    "developer_toolkit_prefs_unittest.cc",
    "developer_toolkit_unittest.cc",
  ]
  deps = [
    ":developer_profile_runtime",
    ":developer_style_preprocessor",
    ":developer_toolkit",
    ":developer_toolkit_core",
    "//base",
    "//base/test:test_support",
    "//components/prefs:test_support",
    "//components/user_prefs",
    "//content/public/browser",
    "//content/test:test_support",
    "//net",
