test("ahoi_developer_toolkit_unittests") {
  deps = [
    ":unit_tests",
    "//content/test:run_all_unittests",
    "//testing/gtest",
  ]
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]
  sources = [ "developer_style_compiler_browsertest.cc" ]
  deps = [
    ":developer_profile_runtime",
    "//ahoi/browser/developer_toolkit/public/mojom",
    "//base/test:test_support",
    "//chrome/browser",
    "//chrome/test:test_support",
    "//content/public/browser",
    "//content/test:test_support",
    "//sandbox/policy/mojom",
    "//testing/gtest",
  ]
}

if (!is_android) {
  test("ahoi_developer_style_compiler_browsertests") {
    deps = [
      ":browser_tests",
      "//chrome:packed_resources",
      "//chrome/test:browser_tests_runner",
      "//chrome/test:test_support",
    ]
  }
}
