module ahoi.developer_toolkit.mojom;

import "sandbox/policy/mojom/sandbox.mojom";

enum StyleLanguage {
  kLess,
  kSass,
};

enum StyleCompileStatus {
  kSucceeded,
  kSyntaxError,
  kUnsupportedSyntax,
  kInputRejected,
  kOutputRejected,
};

struct StyleCompileResult {
  StyleCompileStatus status;
  string css;
  uint32 error_line;
  uint32 error_column;
};

// Pure bounded computation. The kService sandbox does not grant filesystem or
// network access, and this interface transports no paths, URLs or handles.
[ServiceSandbox=sandbox.mojom.Sandbox.kService]
interface DeveloperStyleCompiler {
  Compile(StyleLanguage language, string source)
      => (StyleCompileResult result);
};
